-- AUTO FISHING LOGIC (PORTED FROM V4)
-- ==============================================================================
local AutoFishActive = false
local FishingRodName = "Basic Rod"
local skillAction = game:GetService("ReplicatedStorage"):WaitForChild("Chest"):WaitForChild("Remotes"):WaitForChild("Functions"):WaitForChild("SkillAction")

local function ResolveFishingUIRefs()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end
    local fishingGui = playerGui:FindFirstChild("FishingUI")
    if not fishingGui or not fishingGui.Enabled then return nil end
    local bg = fishingGui:FindFirstChild("FishingBackground")
    if not bg or not bg.Visible then return nil end
    local fishingBar = bg:FindFirstChild("FishingBar")
    local fishLabel = bg:FindFirstChild("FishLabel")
    if not fishingBar or not fishLabel or not fishingBar.Visible then return nil end
    return fishingGui, bg, fishingBar, fishLabel
end

local function EquipFishingRod()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") then return false end
    if char:FindFirstChild(FishingRodName) then return true end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local rod = backpack and backpack:FindFirstChild(FishingRodName)
    if rod then
        char.Humanoid:EquipTool(rod)
        return char:FindFirstChild(FishingRodName) ~= nil
    end
    pcall(function()
        game:GetService("ReplicatedStorage").Chest.Remotes.Functions.EtcFunction:InvokeServer("EquipWeapon", {WeaponName = FishingRodName, Type = "Primary"})
    end)
    task.wait(0.3)
    rod = backpack and backpack:FindFirstChild(FishingRodName)
    if rod then
        char.Humanoid:EquipTool(rod)
        return true
    end
    return false
end

