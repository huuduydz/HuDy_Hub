-- OPE V2 (DF_OpOp) AUTOMATIC ROOM SYSTEM
-- =========================================================================
HuDy.LastOpeRoomTime = 0
HuDy.LastOpeRoomPosition = nil
HuDy.LastOpeRoomTarget = nil
HuDy.OpeRoomCasting = false

function HuDy.HasOpeV2()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local tools = {}
    if char then for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end end
    if backpack then for _, t in ipairs(backpack:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end end
    
    for _, t in ipairs(tools) do
        local n = string.lower(t.Name)
        local tt = string.lower(t.ToolTip or "")
        if n:find("op") or n:find("ope") or tt:find("op") or tt:find("ope") then
            return true, t
        end
    end
    
    local stats = LocalPlayer:FindFirstChild("PlayerStats") or LocalPlayer:FindFirstChild("Data") or LocalPlayer:FindFirstChild("leaderstats")
    if stats then
        for _, v in ipairs(stats:GetChildren()) do
            if v:IsA("StringValue") then
                local val = string.lower(v.Value)
                if val:find("op") or val:find("ope") then
                    return true
                end
            end
        end
    end
    
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        for _, desc in ipairs(pGui:GetDescendants()) do
            if desc:IsA("TextLabel") or desc:IsA("StringValue") then
                local txt = string.lower(desc.Name .. " " .. (desc:IsA("TextLabel") and desc.Text or (desc:IsA("StringValue") and desc.Value or "")))
                if txt:find("df_opop") or txt:find("op-op") or txt:find("ope") then
                    return true
                end
            end
        end
    end
    
    return false
end

function HuDy.IsOpeRoomActive(targetPosition, targetMob)
    -- 1. Nếu chưa từng bật hoặc đã quá 45s -> Luôn bật lại để duy trì Room liên tục
    if not HuDy.LastOpeRoomTime or (tick() - HuDy.LastOpeRoomTime >= 45) then
        return false
    end
    
    -- 2. Nếu vị trí hiện tại đã ra khỏi bán kính Room (> 70 studs) (ví dụ chuyển sang tầng mới) -> Bật lại Room
    if targetPosition and HuDy.LastOpeRoomPosition then
        local dist = (targetPosition - HuDy.LastOpeRoomPosition).Magnitude
        if dist > 70 then
            return false
        end
    end
    
    return true
end

function HuDy.CastOpeRoom(targetCFrame, targetMob)
    -- Đảm bảo cooldown tối thiểu 3.2s giữa các lần niệm Room
    if HuDy.OpeRoomCasting or (tick() - (HuDy.LastOpeRoomTime or 0) < 3.2) then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local targetPos = typeof(targetCFrame) == "CFrame" and targetCFrame.Position or (typeof(targetCFrame) == "Vector3" and targetCFrame or (hrp and hrp.Position))
    
    if targetPos and HuDy.IsOpeRoomActive(targetPos, targetMob) then return end
    HuDy.OpeRoomCasting = true
    
    task.spawn(function()
        pcall(function()
            local chest = ReplicatedStorage:FindFirstChild("Chest")
            local skillAction = chest and chest:FindFirstChild("Remotes") and chest.Remotes:FindFirstChild("Functions") and chest.Remotes.Functions:FindFirstChild("SkillAction")
            if skillAction then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local targetHit = (typeof(targetCFrame) == "CFrame" and targetCFrame) or (hrp and hrp.CFrame) or CFrame.new()
                
                local hasOpe, opeTool = HuDy.HasOpeV2()
                if opeTool and opeTool.Parent ~= char and char:FindFirstChild("Humanoid") then
                    char.Humanoid:EquipTool(opeTool)
                end
                
                -- 1. Bắn song song Down + Up qua task.spawn để không bị InvokeServer yield chặn luồng
                task.spawn(function()
                    pcall(function()
                        skillAction:InvokeServer("DF_OpOp_Z", {
                            MouseHit = targetHit,
                            Type = "Down"
                        })
                    end)
                end)
                
                task.spawn(function()
                    task.wait(0.02)
                    pcall(function()
                        skillAction:InvokeServer("DF_OpOp_Z", {
                            MouseHit = targetHit,
                            Type = "Up"
                        })
                    end)
                end)
                
                HuDy.LastOpeRoomTime = tick()
                HuDy.LastOpeRoomPosition = targetHit.Position
                HuDy.LastOpeRoomTarget = targetMob
            end
        end)
        task.wait(0.5)
        HuDy.OpeRoomCasting = false
    end)
end

function HuDy.Attack(mobRoot)
    _G.HuDy_Target = mobRoot
    local tools, equipTool = HuDy.GetWeapon()
    if tools and #tools > 0 then
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChild("Humanoid")

        -- CHỈ EQUIP DUY NHẤT 1 VŨ KHÍ ƯU TIÊN TRÊN TAY (KHÔNG ĐỔI TOOL LIÊN TỤC):
        if equipTool and humanoid then
            if equipTool.Parent ~= char then
                humanoid:EquipTool(equipTool)
            end
            pcall(function() equipTool:Activate() end)
        end
        
        if mobRoot then
            pcall(function()
                -- Tự động kích hoạt Room của Ope V2 khi tiếp cận quái mới hoặc quái ra khỏi vùng Room
                if HuDy.HasOpeV2() and not HuDy.IsOpeRoomActive(mobRoot.Position, mobRoot) and not HuDy.OpeRoomCasting then
                    HuDy.CastOpeRoom(mobRoot.CFrame, mobRoot)
                end

                local chest = ReplicatedStorage:FindFirstChild("Chest")
                local skillAction = chest and chest:FindFirstChild("Remotes") and chest.Remotes:FindFirstChild("Functions") and chest.Remotes.Functions:FindFirstChild("SkillAction")
                if not skillAction then return end
                
                -- GIỮ NGUYÊN 100% LOGIC SPAM SKILL BẰNG REMOTE CHO TẤT CẢ VŨ KHÍ ĐƯỢC CHỌN:
                for _, tool in ipairs(tools) do
                    local toolToolTip = string.lower(tool.ToolTip or "")
                    local toolNameLower = string.lower(tool.Name or "")
                    local prefix = "FS"
                    if toolToolTip:find("sword") or toolNameLower:find("sword") or toolNameLower:find("blade") or toolNameLower:find("scythe") then
                        prefix = "SW"
                    elseif toolToolTip:find("fruit") or toolNameLower:find("fruit") then
                        prefix = "DF"
                    end
                    
                    local function sendSkill(toolName, pfx, skill, isDown)
                        task.spawn(function()
                            local actionType = (skill == "M1") and "Click" or (isDown and "Down" or "Up")
                            local args = { 
                                [1] = pfx .. "_" .. toolName .. "_" .. skill, 
                                [2] = {["MouseHit"] = mobRoot.CFrame, ["Type"] = actionType} 
                            }
                            pcall(function() skillAction:InvokeServer(table.unpack(args)) end)
                        end)
                    end
                    
                    -- Buff tốc độ M1
                    for i = 1, 2 do
                        sendSkill(tool.Name, prefix, "M1", true)
                        sendSkill(tool.Name, "FS", "M1", true)
                    end
                    
                    -- Spam Skill diện rộng (chỉ dùng skill được chọn)
                    local allSkills = {"Z", "X", "C", "V", "E", "B"}
                    local enabledSkills = HuDy.Flags.SelectedSkills
                    if not enabledSkills or next(enabledSkills) == nil then
