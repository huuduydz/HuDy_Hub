function HuDy.Rejoin()
    pcall(function()
        if #Players:GetPlayers() <= 1 then
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        else
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end
    end)
end

function HuDy.ServerHop()
    task.spawn(function()
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Server Hop", Content = "Searching for available server...", Icon = "solar:refresh-bold", Duration = 3 })
            end
        end)
        
        -- 1. Æ¯u tiÃªn láº¥y Server List trá»±c tiáº¿p tá»« King Legacy (Cáº¥u trÃºc má»›i nháº¥t)
        local nativeSuccess, nativeServers = pcall(function()
            local getServersFunc = ReplicatedStorage:WaitForChild("Chest", 5)
                :WaitForChild("Assets", 5)
                :WaitForChild("Modules", 5)
                :WaitForChild("Network", 5)
                :WaitForChild("ClientNetwork", 5)
                :WaitForChild("GetServerLists", 5)
            return getServersFunc and getServersFunc:InvokeServer()
        end)
        
        if nativeSuccess and type(nativeServers) == "table" then
            local validServers = {}
            for _, s in pairs(nativeServers) do
                if type(s) == "table" and s.JobId and s.JobId ~= game.JobId and (s.PlayerCount or 0) < 12 and (s.PlayerCount or 0) > 0 then
                    table.insert(validServers, s.JobId)
                end
            end
            if #validServers > 0 then
                local targetId = validServers[math.random(1, #validServers)]
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetId, LocalPlayer)
                return
            end
        end
        
        -- 2. Fallback: Query HTTP Roblox Public API
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            pcall(function()
                local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100"
                local res = req({ Url = url, Method = "GET" })
                if res and res.Body then
                    local data = HttpService:JSONDecode(res.Body)
                    if data and data.data then
                        local validServers = {}
                        for _, s in ipairs(data.data) do
                            if type(s) == "table" and s.id and s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers - 1 then
                                table.insert(validServers, s.id)
                            end
                        end
                        if #validServers > 0 then
                            local targetId = validServers[math.random(1, #validServers)]
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetId, LocalPlayer)
                            return
                        end
                    end
                end
            end)
        end
        
        -- 3. Fallback cuá»‘i cÃ¹ng: Teleport ngáº«u nhiÃªn
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end

