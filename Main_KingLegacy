function HuDy.IsDungeonBossAttacking(mobs)
    if not mobs then return false end
    for _, m in ipairs(mobs) do
        if m.Model and m.Hum and m.Hum.Health > 0 then
            local mobName = string.lower(m.Model.Name or "")
            local isChaosCrab = mobName:find("chaos crab") ~= nil or mobName:find("craberno") ~= nil or mobName:find("crab") ~= nil or (m.Hum.MaxHealth >= 800000)
            
            -- Chaos Crab xử lý riêng ở hàm IsChaosCrabWarningActive (chỉ né TargetPos)
            if not isChaosCrab then
                local isWardenBoss = (not mobName:find("bane")) and (
                    mobName:find("dark warden") ~= nil 
                    or mobName:find("flame warden") ~= nil 
                    or mobName:find("gravity warden") ~= nil 
                    or mobName:find("ice warden") ~= nil 
                    or (mobName:find("warden") ~= nil and m.Hum.MaxHealth >= 400000)
                    or (m.Model.Parent and m.Model.Parent.Name == "Boss")
                )
                
                local isDodgeNeeded = false
                
                if isWardenBoss then
                    -- 1. ĐỐI VỚI BOSS WARDEN: Chỉ né khi Boss gồng chiêu lớn (ChargeFolder, Spikes, HeatWhip, hoặc chiêu thức đặc biệt)
                    if m.Model:FindFirstChild("ChargeFolder", true) or m.Model:FindFirstChild("Spikes", true) or m.Model:FindFirstChild("HeatWhip", true) or m.Model:FindFirstChild("HeatString", true) then
                        isDodgeNeeded = true
                    else
                        local animator = m.Hum:FindFirstChildOfClass("Animator")
                        if animator then
                            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                if track.IsPlaying and track.Speed > 0.05 then
                                    local animObj = track.Animation
                                    local rawId = animObj and tostring(animObj.AnimationId or "") or ""
                                    local numId = rawId:match("%d+") or ""
                                    local aName = string.lower(track.Name or "")
                                    
                                    -- Bỏ qua 100% hoạt ảnh đi bộ, đứng yên, và đòn đánh tay cơ bản
                                    if not IGNORED_BASIC_ANIMS[numId] and not aName:find("walk") and not aName:find("idle") and not aName:find("run") then
                                        -- Các animation skill gồng/ultimate đã xác định từ log:
                                        if numId == "10088818489" or numId == "10088819464" or numId == "10088825979" or numId == "4831189594" -- Dark Warden Ult/Charge
                                        or numId == "130231576529295" or numId == "130483309034269" or numId == "117419738910485" -- Gravity Warden
                                        or numId == "8872661455" or numId == "8872677683" or numId == "8872666822" or numId == "8872653335" -- Ice Warden
                                        or numId == "12276882494" or numId == "6826111354" or numId == "6817319916" or numId == "6817381149" -- Flame Warden
                                        or aName:find("charge") or aName:find("ultimate") or aName:find("whip") or aName:find("spikes") then
                                            isDodgeNeeded = true
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end
                else
                    -- 2. ĐỐI VỚI QUÁI THƯỜNG (Warden's Bane, Pirate Gunner, Imprisoned Pirate, v.v.):
                    -- CHỈ NÉ DUY NHẤT SKILL TRÓI DÂY (HeatWhip / HeatString / Anim 9387066346), BỎ QUA 100% ĐÒN ĐÁNH THƯỜNG
                    local hasHeatWhip = m.Model:FindFirstChild("HeatWhip", true) or m.Model:FindFirstChild("HeatString", true)
                    if hasHeatWhip then
                        isDodgeNeeded = true
                    else
                        local animator = m.Hum:FindFirstChildOfClass("Animator")
                        if animator then
                            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                if track.IsPlaying and track.Speed > 0.05 then
                                    local animObj = track.Animation
                                    local rawId = animObj and tostring(animObj.AnimationId or "") or ""
                                    local aName = string.lower(track.Name or "")
                                    if rawId:find("9387066346") or aName:find("heatwhip") or aName:find("whip") or aName:find("heatstring") or aName:find("string") or aName:find("troi") then
                                        isDodgeNeeded = true
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
                
                if isDodgeNeeded then
                    return true, m, isWardenBoss
                end
            end
        end
    end
    return false
end

function HuDy.StartBossEffectLogger()
    if HuDy.BossLoggerRunning then return end
    HuDy.BossLoggerRunning = true

    local logFile = "dungeon_effects_log.txt"
    local recordedKeys = {}

    local function WriteLog(category, mobName, details)
        local timestamp = os.date("%X") .. "." .. string.format("%03d", math.floor((tick() % 1) * 1000))
        local logKey = category .. "_" .. mobName .. "_" .. tostring(details.Name or details.AnimId or details.Key or "")
        if recordedKeys[logKey] and (tick() - recordedKeys[logKey] < 1.0) then return end
        recordedKeys[logKey] = tick()

        local line = string.format("[%s] [%s] [%s] ", timestamp, category, mobName)
        for k, v in pairs(details) do
            line = line .. string.format("%s: %s | ", tostring(k), tostring(v))
        end
        line = line .. "\n"

        pcall(function()
            if appendfile then
                appendfile(logFile, line)
            elseif writefile then
                local existing = ""
                pcall(function() existing = readfile(logFile) end)
                writefile(logFile, existing .. line)
            end
        end)
    end

    pcall(function()
        if writefile then
            writefile(logFile, "=== DUNGEON BOSS EFFECT LOGGER STARTED at " .. os.date() .. " ===\n\n")
        end
    end)

    local trackedModels = {}
    local function MonitorMob(mob)
        if not mob or trackedModels[mob] then return end
        trackedModels[mob] = true
        local mobName = mob.Name
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")

        if animator then
            animator.AnimationPlayed:Connect(function(track)
                local anim = track.Animation
                WriteLog("ANIMATION_PLAYED", mobName, {
                    TrackName = track.Name,
                    AnimId = anim and anim.AnimationId or "N/A",
                    Priority = tostring(track.Priority),
                    Length = track.Length,
                    Speed = track.Speed
                })
            end)
        end

        mob.DescendantAdded:Connect(function(desc)
            local info = { Name = desc.Name, Class = desc.ClassName }
            if desc:IsA("BillboardGui") then
                info.Enabled = desc.Enabled
                for _, c in ipairs(desc:GetChildren()) do
                    if c:IsA("ImageLabel") then
                        info.Image = c.Image
                        info.Color = tostring(c.ImageColor3)
                    end
                end
            elseif desc:IsA("Highlight") then
                info.Fill = tostring(desc.FillColor)
            end
            WriteLog("DESCENDANT_ADDED", mobName, info)
        end)
    end

    task.spawn(function()
        while HuDy.Flags.LogBossEffects do
            pcall(function()
                local mobs = HuDy.GetAllDungeonMobs and HuDy.GetAllDungeonMobs() or {}
                for _, m in ipairs(mobs) do
                    if m.Model then MonitorMob(m.Model) end
                end
            end)
            task.wait(1)
        end
        HuDy.BossLoggerRunning = false
    end)
end

function HuDy.StartAutoDungeon()
    if HuDy.DungeonLoopRunning then return end
    HuDy.DungeonLoopRunning = true
    
    task.spawn(function()
        while HuDy.Flags.AutoDungeon do
            task.wait(0.1)
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum or hum.Health <= 0 then return end
                
                -- 1. Kích hoạt Race Skill khi HP <= % Health On Race
                local raceThreshold = tonumber(HuDy.Flags.DungeonRaceHealth) or 35
                if (hum.Health / hum.MaxHealth * 100) <= raceThreshold then
                    pcall(function()
                        local vim = game:GetService("VirtualInputManager")
                        if vim then
                            vim:SendKeyEvent(true, Enum.KeyCode.T, false, game)
                            task.wait(0.02)
                            vim:SendKeyEvent(false, Enum.KeyCode.T, false, game)
                        end
                    end)
                end
                
                -- 2. Tự động Vote Map nếu đang ở phòng chờ hoặc ChooseMap xuất hiện
                local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                local chooseMap = pGui and pGui:FindFirstChild("ChooseMap")
                local isChooseVisible = chooseMap and chooseMap:FindFirstChild("ChooseMapFrame") and chooseMap.ChooseMapFrame.Visible
                local dungeonFolder = workspace:FindFirstChild("Dungeon")
                local isLobby = dungeonFolder and dungeonFolder:GetAttribute("CountBeforeStart")
                
                if isChooseVisible or isLobby then
                    local diff = HuDy.Flags.DungeonDifficulty or "Easy"
                    local mapFrame = chooseMap and chooseMap:FindFirstChild("ChooseMapFrame") and chooseMap.ChooseMapFrame:FindFirstChild("MapFrame")
                    local targetBtn = mapFrame and (mapFrame:FindFirstChild(diff) or mapFrame:FindFirstChild(diff:gsub("^%l", string.upper)))
                    
                    if targetBtn then
                        pcall(function()
                            local gs = game:GetService("GuiService")
                            if gs then gs.SelectedObject = targetBtn end
                        end)
                        task.wait(0.03)
                        pcall(function()
                            local vim = game:GetService("VirtualInputManager")
                            if vim then
                                for i = 1, 3 do
                                    vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                                    task.wait(0.02)
                                    vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                                    task.wait(0.02)
                                end
                            end
                        end)
                        if firesignal then
                            pcall(function() firesignal(targetBtn.MouseButton1Click) end)
                        end
                    end
                    
                    pcall(function()
                        local chest = ReplicatedStorage:FindFirstChild("Chest")
                        local selectDungeon = chest and chest:FindFirstChild("Remotes") and chest.Remotes:FindFirstChild("Functions") and chest.Remotes.Functions:FindFirstChild("SelectDungeon")
                        if selectDungeon then
                            selectDungeon:InvokeServer(targetBtn and targetBtn.Name or diff)
                        end
                    end)
                    task.wait(0.5)
                    return
                end
                
                -- 3. Xử lý Tự Reset khi Dungeon Clear
                if HuDy.Flags.DungeonAutoReset then
                    local clearSign = (pGui and pGui:FindFirstChild("DungeonClear")) or (dungeonFolder and dungeonFolder:GetAttribute("DungeonClear") == true)
                    if clearSign then
                        if hum then hum.Health = 0 end
                        task.wait(2)
                        return
                    end
                end
                
                -- 4. Quét tìm danh sách quái sống trong Dungeon (Ưu tiên workspace.MOB)
                local allMobs = HuDy.GetAllDungeonMobs()
                local isRealDungeonIsland = workspace:FindFirstChild("Island") and (workspace.Island:FindFirstChild("(Real) Hard Dungeon") or workspace.Island:FindFirstChild("(Real) Normal Dungeon") or workspace.Island:FindFirstChild("(Real) Easy Dungeon"))
                
                -- NẾU ĐANG Ở NGOÀI MAP CHÍNH (Chưa vào Dungeon & không có quái Dungeon & chưa mở ChooseMap)
                if not isRealDungeonIsland and #allMobs == 0 and not isChooseVisible then
                    local gateCFrame = HuDy.GetDungeonGateEntrance()
                    if gateCFrame then
                        HuDy.TP(gateCFrame * CFrame.new(0, 3, 0), gateCFrame.Position)
                        
                        -- Tự động kích hoạt ProximityPrompt của cổng nếu có
                        pcall(function()
                            for _, prompt in ipairs(workspace:GetDescendants()) do
                                if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                                    local pName = string.lower(prompt.ActionText .. " " .. prompt.ObjectText .. " " .. prompt.Name)
                                    if pName:find("dungeon") or pName:find("enter") or pName:find("gate") or pName:find("warden") then
                                        if (hrp.Position - prompt.Parent.Position).Magnitude <= prompt.MaxActivationDistance + 5 then
                                            fireproximityprompt(prompt)
                                        end
                                    end
                                end
                            end
                        end)
                    else
                        HuDy.StopTP()
                    end
                    task.wait(0.5)
                    return
                end
                
                -- NẾU ĐANG TRONG DUNGEON:
                local elevator = HuDy.GetDungeonElevator()
                local floorY = (allMobs[1] and allMobs[1].Root and allMobs[1].Root.Position.Y) or hrp.Position.Y
                local centerPos = (elevator and elevator.Position) or (allMobs[1] and allMobs[1].Root and Vector3.new(allMobs[1].Root.Position.X, floorY, allMobs[1].Root.Position.Z)) or hrp.Position
                local centerCFrame = elevator and elevator.CFrame or CFrame.new(centerPos)
                
                -- Lọc danh sách quái trong phạm vi sàn đấu Dungeon
                local validMobs = {}
                for _, m in ipairs(allMobs) do
                    if m.Root and m.Hum and m.Hum.Health > 0 then
                        local d = (m.Root.Position - centerPos).Magnitude
                        if d <= 500 then
                            table.insert(validMobs, m)
                        end
                    end
                end
                if #validMobs == 0 and #allMobs > 0 then
                    validMobs = allMobs
                end
                
                if #validMobs > 0 then
                    -- Luân chuyển mục tiêu mượt mà (0.6s đổi mục tiêu một lần để kích aggro gom quái ổn định, không bị giật lag)
                    local nowClock = tick()
                    if not HuDy.LastDungeonTargetSwitch or (nowClock - HuDy.LastDungeonTargetSwitch) >= 0.6 then
                        HuDy.LastDungeonTargetSwitch = nowClock
                        HuDy.DungeonTargetIndex = ((HuDy.DungeonTargetIndex or 0) % #validMobs) + 1
                    end
                    local target = validMobs[HuDy.DungeonTargetIndex] or validMobs[1]
                    local targetRoot = target and target.Root
                    local targetMob = target and target.Model
                    
                    if targetRoot then
                        -- 1. Kiểm tra Warning Bomb của Chaos Crab (Chỉ né khi có TargetPos)
                        local isCrabWarning, crabMob = false, nil
                        if HuDy.Flags.DungeonAutoDodge ~= false then
                            isCrabWarning, crabMob = HuDy.IsChaosCrabWarningActive(validMobs)
                            if isCrabWarning then
                                pcall(function()
                                    local kenFunc = ReplicatedStorage:FindFirstChild("Chest") and ReplicatedStorage.Chest:FindFirstChild("Remotes") and ReplicatedStorage.Chest.Remotes:FindFirstChild("Functions") and ReplicatedStorage.Chest.Remotes.Functions:FindFirstChild("KenEvent")
                                    if kenFunc then kenFunc:InvokeServer() end
                                end)
                            end
                        end
                        
                        -- 2. Kiểm tra Boss Warden hoặc Quái thường tung chiêu
                        local isOtherDodge, otherMob, isBossMob = false, nil, false
                        if not isCrabWarning and HuDy.Flags.DungeonAutoDodge ~= false then
                            local isCasting, cMob, isB = HuDy.IsDungeonBossAttacking(validMobs)
                            if isCasting then
                                isOtherDodge = true
                                otherMob = cMob
                                isBossMob = isB
                                pcall(function()
                                    local kenFunc = ReplicatedStorage:FindFirstChild("Chest") and ReplicatedStorage.Chest:FindFirstChild("Remotes") and ReplicatedStorage.Chest.Remotes:FindFirstChild("Functions") and ReplicatedStorage.Chest.Remotes.Functions:FindFirstChild("KenEvent")
                                    if kenFunc then kenFunc:InvokeServer() end
                                end)
                            end
                        end
                        
                        local targetCFrame
                        local lookPos = targetRoot.Position
                        local shouldAttack = true
                        
                        if isCrabWarning and crabMob and crabMob.Root then
                            -- A. RIÊNG SKILL NỔ BOMB TARGETPOS CỦA CHAOS CRAB [LV. 10000] & CRABERNO [LV. 15000]:
                            -- Teleport thẳng lên cao +120 studs ngay trên vị trí Chaos Crab
                            -- (Thoát hoàn toàn khỏi 8 vòng tròn nổ bom TargetPos dưới sàn đấu)
                            local crabPos = crabMob.Root.Position
                            local safePos = Vector3.new(crabPos.X, crabPos.Y + 120, crabPos.Z)
                            
                            targetCFrame = CFrame.new(safePos, crabPos)
                            lookPos = crabPos
                            shouldAttack = false -- Tạm dừng đánh trong 3.5s né bomb nổ để không bị kéo xuống đất
                        elseif isOtherDodge and otherMob and otherMob.Root then
                            local bPos = otherMob.Root.Position
                            lookPos = bPos
                            if isBossMob then
                                -- B. CÁC BOSS WARDEN (Dark Warden, Flame Warden, Gravity Warden, Ice Warden):
                                -- TP RA XA 350 STUDS VÀ BAY XOAY VÒNG TRÒN
                                local angle = (tick() * 3.5) % (2 * math.pi)
                                local dodgeRadius = 350
                                local dodgeHeight = 25
                                local dodgePos = bPos + Vector3.new(math.cos(angle) * dodgeRadius, dodgeHeight, math.sin(angle) * dodgeRadius)
                                targetCFrame = CFrame.new(dodgePos, bPos)
                            else
                                -- C. QUÁI THƯỜNG (Warden's Bane, Pirate Gunner, Imprisoned Pirate, v.v.): BAY CAO LÊN +90 STUDS NÉ CHIÊU
                                local distance = (tonumber(HuDy.Flags.FarmDistance) or 8) + 30
                                local basePos = targetRoot.Position + Vector3.new(0, -2, 0)
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            end
                        else
                            -- D. VỊ TRÍ ĐÁNH BÌNH THƯỜNG (Quái thường + Boss khi không tung chiêu):
                            local farmMode = HuDy.Flags.FarmMode or "Above"
                            local distance = tonumber(HuDy.Flags.FarmDistance) or 8
                            
                            -- Riêng Boss Chaos Crab to lớn: cộng thêm khoảng cách an toàn (+12 studs) để không bị kẹt hitbox
                            local isTargetCrab = false
                            if targetMob then
                                local tName = string.lower(targetMob.Name or "")
                                if tName:find("chaos crab") or tName:find("craberno") or tName:find("crab") or (target and target.Hum and target.Hum.MaxHealth >= 800000) then
                                    isTargetCrab = true
                                end
                            end
                            if isTargetCrab then
                                distance = distance + 10
                            end
                            
                            local basePos = targetRoot.Position + Vector3.new(0, -2, 0)
                            -- FIX BỊ CHÌM NƯỚC: Thay vì bay lên trời, TP thẳng vào xúc tu và khóa cứng tọa độ (Anti Nước)
                            if targetMob and (string.find(string.lower(targetMob.Name or ""), "tentacle") or string.find(string.lower(targetMob.Name or ""), "kraken")) then
                                basePos = targetRoot.Position
                                -- Anti đẩy nước
                                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
                                if hum then pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false) end) end
                            end
                            
                            if farmMode == "Above" then
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            elseif farmMode == "Behind" then
                                targetCFrame = (targetRoot.CFrame * CFrame.new(0, -2, 0)) * CFrame.new(0, 0, distance)
                            elseif farmMode == "Below" then
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, -distance, 0)) * CFrame.Angles(math.rad(90), 0, 0)
                            else
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            end
                        end
                        
                        HuDy.TP(targetCFrame, lookPos)
                        
                        -- Luôn duy trì Room của Ope V2 tại vị trí trung tâm thang máy (bao trọn toàn bộ sàn đấu)
                        if HuDy.HasOpeV2 and HuDy.HasOpeV2() and not HuDy.IsOpeRoomActive(centerPos) and not HuDy.OpeRoomCasting then
                            HuDy.CastOpeRoom(centerCFrame)
                        end
                        
                        -- Tấn công quái mục tiêu (M1 + Skills), ngoại trừ lúc đang né bomb nổ của Chaos Crab
                        if shouldAttack then
                            HuDy.Attack(targetRoot)
                        end
                    end
                else
                    -- Không có quái -> Đã dọn xong tầng -> Bay lên trụ kéo thang máy cách 20 studs để thang kéo lên tầng tiếp theo
                    if elevator then
                        HuDy.TP(elevator.CFrame * CFrame.new(0, 20, 0), elevator.Position)
                    else
                        HuDy.StopTP()
                    end
                end
            end)
        end
        HuDy.DungeonLoopRunning = false
        HuDy.StopTP()
    end)
end

