function HuDy.StartAutoFarm()
    if HuDy.FarmLoopRunning then return end
    HuDy.FarmLoopRunning = true
    local lastDetectedMob = ""
    task.spawn(function()
        while HuDy.Flags.AutoFarm or HuDy.Flags.AutoFarmSelectedMob or HuDy.Flags.AutoNextSea2 or HuDy.Flags.AutoNextSea3 or HuDy.Flags.AutoFarmMaterial or HuDy.Flags.AutoFarmBoss or HuDy.Flags.AutoHopSerpent or HuDy.Flags.AutoHopPteradon or HuDy.Flags.AutoHopAbyssal or HuDy.Flags.AutoHopChaosKraken or HuDy.Flags.AutoHopDrakenfyr or HuDy.Flags.AutoHopDeepseaCrusher do
            task.wait(0.1)
            pcall(function()
                local data = nil

                if HuDy.GetCurrentLevel() >= 4000 then
                    if HuDy.Flags.AutoNextSea3 and game.PlaceId == 6381829480 then
                        HuDy.DoSea3Quest()
                        return
                    end
                end

                -- Chỉ kiểm tra nguyên liệu chế Heart of Sea nếu BẬT AutoNextSea3 và level >= 4000
                if HuDy.Flags.AutoNextSea3 and HuDy.GetCurrentLevel() >= 4000 and game.PlaceId ~= 15759515082 then
                    local missingData = HuDy.GetSea3MissingMaterialData()
                    if missingData then
                        data = missingData
                    end
                end
                
                -- Xử lý Traveler Quest (Sang Sea 2) nếu bật AutoNextSea2 hoặc AutoNextSea3
                if not data and (HuDy.Flags.AutoNextSea2 or HuDy.Flags.AutoNextSea3) and (game.PlaceId ~= 6381829480 and game.PlaceId ~= 6500329016 and game.PlaceId ~= 15759515082) then
                    HuDy.DoTravelerQuest()
                    return
                end
                
                if not data then
                    -- Ưu tiên 1: Farm Material (Nhặt ngọc, đánh cây, farm quái nguyên liệu - Multi Selection Support)
                    if HuDy.Flags.AutoFarmMaterial and HuDy.Flags.SelectMaterialFarm then
                        local selectedMats = {}
                        if type(HuDy.Flags.SelectMaterialFarm) == "table" then
                            for k, v in pairs(HuDy.Flags.SelectMaterialFarm) do
                                if type(k) == "number" and type(v) == "string" and v ~= "None" and v ~= "" then
                                    table.insert(selectedMats, v)
                                elseif type(k) == "string" and v == true and k ~= "None" and k ~= "" then
                                    table.insert(selectedMats, k)
                                elseif type(v) == "string" and v ~= "None" and v ~= "" then
                                    table.insert(selectedMats, v)
                                end
                            end
                        elseif type(HuDy.Flags.SelectMaterialFarm) == "string" and HuDy.Flags.SelectMaterialFarm ~= "None" and HuDy.Flags.SelectMaterialFarm ~= "" then
                            table.insert(selectedMats, HuDy.Flags.SelectMaterialFarm)
                        end

                        if #selectedMats > 0 then
                            local isSea1 = (game.PlaceId == 4520749081 or game.PlaceId == 14619717013)
                            local isSea2 = (game.PlaceId == 6381829480 or game.PlaceId == 6500329016)
                            local isSea3 = (game.PlaceId == 15759515082)

                            -- 1. Ưu tiên nhặt Pearl từ xa nếu có chọn Pearl và có sò mở
