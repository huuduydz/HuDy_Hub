local function CreateESP(part, name, color)
    if not part then return end
    local hl = part:FindFirstChild("HuDyESP")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "HuDyESP"
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = part
    end
    
    local bg = part:FindFirstChild("HuDyESPLabel")
    if not bg then
        bg = Instance.new("BillboardGui")
        bg.Name = "HuDyESPLabel"
        bg.Size = UDim2.new(0, 100, 0, 20)
        bg.AlwaysOnTop = true
        bg.StudsOffset = Vector3.new(0, 3, 0)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = name
        lbl.TextColor3 = color
        lbl.TextStrokeTransparency = 0
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        lbl.Parent = bg
        bg.Parent = part
    end
end

local function ClearESP(part)
    if not part then return end
    if part:FindFirstChild("HuDyESP") then part.HuDyESP:Destroy() end
    if part:FindFirstChild("HuDyESPLabel") then part.HuDyESPLabel:Destroy() end
end

