function HuDy.CheckBossAlive(targetStr)
    local function isAlive(mob)
        return mob and mob:IsA("Model") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0
    end

    if targetStr == "serpent" then
        local folders = {
            workspace:FindFirstChild("SeaMonster"),
            workspace:FindFirstChild("Monster"),
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"),
            workspace
        }
        for _, f in ipairs(folders) do
            if f then
                local m = f:FindFirstChild("Serpent")
                if isAlive(m) then return m end
            end
        end
        return nil
    elseif targetStr == "abyssal" then
        local searchFolders = { workspace:FindFirstChild("SeaMonster"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"), workspace:FindFirstChild("Monster"), workspace }
        for _, folder in ipairs(searchFolders) do
            if folder then
                local m1 = folder:FindFirstChild("Abyssal Tyrant")
                if isAlive(m1) then return m1 end
                local m2 = folder:FindFirstChild("SeaDragon")
                if isAlive(m2) then return m2 end
            end
        end
        return nil
    elseif targetStr == "chaos_kraken" then
        local searchFolders = {
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"),
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"),
            workspace:FindFirstChild("Monster"),
            workspace:FindFirstChild("SeaMonster"),
            workspace
        }
        for _, folder in ipairs(searchFolders) do
            if folder then
                for _, m in ipairs(folder:GetChildren()) do
                    if string.find(string.lower(m.Name), "tentacle") then
                        if isAlive(m) then return m end
                    end
                end
            end
        end
        local m1 = workspace:FindFirstChild("MOB") and workspace.MOB:FindFirstChild("Chaos Kraken")
        if isAlive(m1) then return m1 end
        local m2 = workspace:FindFirstChild("SeaMonster") and workspace.SeaMonster:FindFirstChild("Chaos Kraken")
        return isAlive(m2) and m2 or nil
    elseif targetStr == "df_inferno" then
        local searchFolders = { workspace:FindFirstChild("SeaMonster"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"), workspace:FindFirstChild("Monster"), workspace }
        for _, folder in ipairs(searchFolders) do
            if folder then
                local m1 = folder:FindFirstChild("ThirdSeaDragon")
                if isAlive(m1) then return m1 end
                local m2 = folder:FindFirstChild("Drakenfyr")
                if isAlive(m2) then return m2 end
                local m3 = folder:FindFirstChild("Drakenfyr, the Inferno King")
                if isAlive(m3) then return m3 end
            end
        end
        return nil
    elseif targetStr == "ds_crusher" then
        local searchFolders = { workspace:FindFirstChild("SeaMonster"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"), workspace:FindFirstChild("Monster"), workspace }
        for _, folder in ipairs(searchFolders) do
            if folder then
                local m1 = folder:FindFirstChild("Deepsea Crusher")
                if isAlive(m1) then return m1 end
                local m2 = folder:FindFirstChild("ThirdSeaEldritch Crab")
                if isAlive(m2) then return m2 end
            end
        end
        return nil
    elseif targetStr == "pteradon" then
        local m = workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss") and workspace.Monster.Boss:FindFirstChild("Pteradon")
        return isAlive(m) and m or nil
    end
    return nil
end

