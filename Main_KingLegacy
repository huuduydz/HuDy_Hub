game:GetService("RunService").RenderStepped:Connect(function()
    if AutoFishActive then
        local _, _, fishingBar, fishLabel = ResolveFishingUIRefs()
        if fishingBar and fishLabel then
            pcall(function()
                local targetPos = UDim2.new(
                    fishingBar.Position.X.Scale,
                    fishingBar.Position.X.Offset,
                    fishLabel.Position.Y.Scale,
                    fishLabel.Position.Y.Offset
                )
                if fishLabel.Position ~= targetPos then
                    fishLabel.Position = targetPos
                end
            end)
        end
    end
end)

-- Main Auto Fish Loop
task.spawn(function()
    local lastCast = 0
    while task.wait(0.1) do
        if HuDy.Flags.AutoFish then
            AutoFishActive = true
            local char = LocalPlayer.Character
            if not char then continue end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then continue end
            
            if HuDy.Flags.SavedFishingCFrame then
                root.CFrame = HuDy.Flags.SavedFishingCFrame
                root.Anchored = true
            end
            
            local isFishing = (ResolveFishingUIRefs() ~= nil)
            
            if not isFishing then
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                local waitingGui = playerGui and playerGui:FindFirstChild("FishingUI")
                local waitingBg = waitingGui and waitingGui.Enabled and waitingGui:FindFirstChild("FishingBackground")
                if waitingBg and waitingBg.Visible then
                    isFishing = true -- Waiting for bite
                end
            end
            
            if not isFishing and (tick() - lastCast > 3) then
                if EquipFishingRod() then
                    pcall(function()
                        local targetPos = root.Position + root.CFrame.LookVector * 20
                        local aimCFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
                        
                        root.Anchored = false
                        root.CFrame = aimCFrame
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then hum.PlatformStand = true end
                        task.wait(0.08)
                        
                        local lookDir = (targetPos - root.Position).Unit
                        local mouseHit = CFrame.lookAt(targetPos, targetPos + lookDir)
                        
                        skillAction:InvokeServer("SW_" .. FishingRodName .. "_M1", {
                            Charge = 48,
                            MouseHit = mouseHit
                        })
                        
                        if hum then hum.PlatformStand = false end
                        lastCast = tick()
                    end)
                end
            end
        else
            AutoFishActive = false
        end
    end
end)

