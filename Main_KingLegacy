                        end
                    -- Ưu tiên 1.5: Farm Boss từ Auto Hop Boss (Đánh xong tự Hop)
                    elseif HuDy.Flags.AutoHopDrakenfyr and HuDy.CheckBossAlive and HuDy.CheckBossAlive("df_inferno") then
