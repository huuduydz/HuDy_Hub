-- ConfigModule: LÆ°u vÃ  Táº£i thiáº¿t láº­p (JSON Format)
function HuDy.SaveConfig()
    if writefile then
        local success, err = pcall(function()
            writefile(HuDy.SaveFileName, HttpService:JSONEncode(HuDy.Flags))
        end)
        if not success then warn("HuDy Hub | Failed to save config: " .. tostring(err)) end
    end
end

function HuDy.LoadConfig()
    if readfile and isfile and isfile(HuDy.SaveFileName) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(HuDy.SaveFileName))
        end)
        if success and type(data) == "table" then
            for k, v in pairs(data) do
                if HuDy.Flags[k] ~= nil then
                    HuDy.Flags[k] = v
                end
            end
        end
    end
end

