-- Quáº£n lÃ½ Event Connections sáº¡ch sáº½
function HuDy.AddConnection(name, connection)
    if HuDy.Connections[name] then
        HuDy.Connections[name]:Disconnect()
    end
    HuDy.Connections[name] = connection
end

function HuDy.DisconnectAll()
    for _, connection in pairs(HuDy.Connections) do
        if connection.Disconnect then connection:Disconnect() end
    end
    table.clear(HuDy.Connections)
end

