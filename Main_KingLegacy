function HuDy.AutoClickPlay()
    pcall(function()
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pgui then return end

        -- Remote direct invoke
        pcall(function()
            local etcFunc = ReplicatedStorage:FindFirstChild("Chest")
                and ReplicatedStorage.Chest:FindFirstChild("Remotes")
                and ReplicatedStorage.Chest.Remotes:FindFirstChild("Functions")
                and ReplicatedStorage.Chest.Remotes.Functions:FindFirstChild("EtcFunction")
            if etcFunc then
                etcFunc:InvokeServer("EnterTheGame", {})
            end
        end)

        -- TÃ¬m nÃºt Play trÃªn PlayerGui
        local targetBtn = nil
        local loadingGui = pgui:FindFirstChild("LoadingGUI") or pgui:FindFirstChild("Loading")
        if loadingGui then
            targetBtn = loadingGui:FindFirstChild("Play", true) or loadingGui:FindFirstChild("PlayButton", true)
        end

        if not targetBtn then
            for _, gui in ipairs(pgui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Enabled then
                    local btn = gui:FindFirstChild("Play", true) or gui:FindFirstChild("PlayButton", true)
                    if btn and btn:IsA("GuiObject") and btn.Visible then
                        targetBtn = btn
                        break
                    end
                end
            end
        end

        if targetBtn then
            if typeof(firesignal) == "function" then
                pcall(function() firesignal(targetBtn.MouseButton1Click) end)
                pcall(function() firesignal(targetBtn.Activated) end)
            end
            if typeof(getconnections) == "function" then
                pcall(function()
                    for _, conn in pairs(getconnections(targetBtn.MouseButton1Click)) do conn:Fire() end
                    for _, conn in pairs(getconnections(targetBtn.Activated)) do conn:Fire() end
                end)
            end

            pcall(function()
                targetBtn.Selectable = true
                GuiService.SelectedObject = targetBtn
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                GuiService.SelectedObject = nil
            end)

            pcall(function()
                local pos = targetBtn.AbsolutePosition
                local size = targetBtn.AbsoluteSize
                local cX = pos.X + (size.X / 2)
                local cY = pos.Y + (size.Y / 2) + 36
                VirtualInputManager:SendMouseButtonEvent(cX, cY, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(cX, cY, 0, false, game, 1)
            end)
        end
    end)
end

