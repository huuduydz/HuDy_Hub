function HuDy.TP(targetCFrame, lookAtPos)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp then return end
    
    -- Anti-Fall: Giá»¯ lÆ¡ lá»­ng khi Ä‘ang farm trÃªn cao
    if not hrp:FindFirstChild("HuDyBodyVelocity") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "HuDyBodyVelocity"
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Parent = hrp
    end
    
    if hum then 
        hum.AutoRotate = false 
        hum.PlatformStand = true -- Táº¯t lá»±c tá»± cÃ¢n báº±ng cá»§a Humanoid Ä‘á»ƒ nhÃ¢n váº­t náº±m im 90 Ä‘á»™
    end
    hrp.CFrame = targetCFrame
end

function HuDy.StopTP()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if hrp:FindFirstChild("HuDyBodyVelocity") then
                hrp.HuDyBodyVelocity:Destroy()
            end
            if hrp:FindFirstChild("HuDyBodyGyro") then
                hrp.HuDyBodyGyro:Destroy()
            end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum then 
            hum.AutoRotate = true 
            hum.PlatformStand = false
        end
    end
end

