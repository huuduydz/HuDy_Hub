                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                if not data.SkipQuest and not HuDy.CheckCorrectQuest(data.MobName) then
                    -- Theo cáº¥u hÃ¬nh má»›i, data.CFrame lÃ  tá»a Ä‘á»™ BÃ£i QuÃ¡i.
                    -- Game cho phÃ©p nháº­n Quest tá»« xa nÃªn ta KHÃ”NG Cáº¦N tÃ¬m NPC ná»¯a, bay tháº³ng ra bÃ£i quÃ¡i luÃ´n!
                    if data.CFrame and (hrp.Position - data.CFrame.Position).Magnitude > 20 then
                        HuDy.TP(data.CFrame * CFrame.new(0, 0, 0))
                        return
                    end
                    
                    -- Khi Ä‘Ã£ á»Ÿ khu vá»±c bÃ£i quÃ¡i -> KÃ­ch hoáº¡t nháº­n Quest tá»« xa
                    HuDy.StopTP()
                    task.wait(0.5)
                    local questRemote = ReplicatedStorage:WaitForChild("Chest", 5)
                    if questRemote then
                        local func = questRemote:FindFirstChild("Remotes") and questRemote.Remotes:FindFirstChild("Functions") and questRemote.Remotes.Functions:FindFirstChild("Quest")
                        if func then
                            -- KÃ­ch hoáº¡t nháº­n Quest má»›i (tá»± Ä‘á»™ng Ä‘Ã¨ lÃªn quest cÅ© náº¿u cÃ³)
                            pcall(function() func:InvokeServer("take", data.QuestName) end)
                            task.wait(0.8)
                            
                            -- Náº¿u nháº­n quest báº±ng tÃªn máº·c Ä‘á»‹nh tháº¥t báº¡i -> Brute Force tÃªn quest (nhÆ° v5.lua)
                            if not HuDy.CheckCorrectQuest(data.MobName) then
                                local base = string.match(data.MobName, "^(.-)%s*%[") or data.MobName
                                base = base:match("^%s*(.-)%s*$")
                                local amounts = {4, 6, 1, 5, 8, 10, 2, 3}
                                local prefixes = {"Kill ", "Defeat ", "Quest ", ""}
                                local found = false
                                
                                for _, amt in ipairs(amounts) do
                                    local variations = {base, base .. "s", base .. "es"}
                                    if string.find(string.lower(base), "man") then 
                                        table.insert(variations, base:gsub("man", "men"):gsub("Man", "Men")) 
                                    end
                                    if string.sub(string.lower(base), -1) == "y" then 
                                        table.insert(variations, string.sub(base, 1, -2) .. "ies") 
                                    end
                                    
                                    for _, prefix in ipairs(prefixes) do 
                                        for _, mobVar in ipairs(variations) do 
                                            local guess = (prefix == "") and mobVar or (prefix .. amt .. " " .. mobVar)
                                            pcall(function() func:InvokeServer("take", guess) end)
                                            task.wait(0.3)
                                            if HuDy.CheckCorrectQuest(data.MobName) then 
                                                data.QuestName = guess -- Cache lại tên đúng
                                                found = true
                                                break 
                                            end 
                                        end
                                        if found then break end 
                                    end
                                    if found then break end 
                                end
                            end
                        end
                    end
                else
                    -- Đã có đúng nhiệm vụ / quái mục tiêu -> Tìm quái và tấn công (Hỗ trợ Gom quái thông minh theo bãi)
                    local distance = HuDy.Flags.FarmDistance or 8
                    local mode = HuDy.Flags.FarmMode or "Above"
                    local spotPos = (data.CFrame and data.CFrame.Position) or (hrp and hrp.Position)
                    
                    local isBossTarget = false
                    local cleanName = string.lower(string.match(data.MobName, "^(.-)%s*%[") or data.MobName):match("^%s*(.-)%s*$")
                    local bossIgnoreList = {"sea king", "tentacle", "hydra", "drakenfyr", "crusher", "abyssal", "ghost ship"}
                    for _, bName in ipairs(bossIgnoreList) do
                        if cleanName:find(bName) then isBossTarget = true break end
                    end

                    local spotMobs = (not isBossTarget) and HuDy.GetSpotMobs(data.MobName, spotPos, 350) or {}
                    
                    -- LOGIC GOM QUÁI THÔNG MINH: Đánh từng con trong bãi để kéo aggro, chọn 1 con làm trung tâm để quái tự gom lại
                    if HuDy.Flags.BringMobs and not isBossTarget and #spotMobs >= 2 then
                        -- 1. Kiểm tra hoặc chọn Con Quái Trung Tâm (Center Mob)
                        local centerMob = HuDy.CurrentCenterMob
                        local centerRoot = HuDy.CurrentCenterRoot
                        local isCenterValid = false
                        
                        if centerMob and centerMob.Parent and centerRoot and centerRoot.Parent then
                            local hum = centerMob:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                local mBase = string.lower(string.match(string.match(centerMob.Name, "^(.-)%s*%[") or centerMob.Name, "^%s*(.-)%s*$"))
                                if mBase == cleanName then
                                    isCenterValid = true
                                end
                            end
                        end
                        
                        if not isCenterValid then
                            local bestMob = spotMobs[1]
                            centerMob = bestMob.Model
                            centerRoot = bestMob.Root
                            HuDy.CurrentCenterMob = centerMob
                            HuDy.CurrentCenterRoot = centerRoot
                            HuDy.AggroedMobs = HuDy.AggroedMobs or {}
                            HuDy.AggroedMobs[centerMob] = tick()
                        end
                        
                        -- 2. Quét tìm các con quái khác trong bãi chưa bị đánh để kéo aggro
                        local unaggroMobs = {}
                        for _, sm in ipairs(spotMobs) do
                            if sm.Model ~= centerMob then
                                local distToCenter = (sm.Root.Position - centerRoot.Position).Magnitude
                                -- Nếu quái ở xa con trung tâm (> 18 studs), kiểm tra xem đã đánh nó chưa
                                if distToCenter > 18 then
                                    local lastAggro = HuDy.AggroedMobs and HuDy.AggroedMobs[sm.Model]
                                    if not lastAggro or (tick() - lastAggro > 8) then
                                        table.insert(unaggroMobs, sm)
                                    end
                                end
                            end
                        end
                        
                        -- 3. Tiến hành kéo hoặc dồn dame:
                        if #unaggroMobs > 0 then
                            -- Còn quái ở xa chưa aggro -> Lướt nhanh qua đánh 1 hit để kéo nó chạy về phía player & trung tâm
                            local pullTarget = unaggroMobs[1]
                            local pullPos = pullTarget.Root.Position + Vector3.new(0, -2, 0)
                            local pullCFrame
                            if mode == "Above" then
                                pullCFrame = CFrame.new(pullPos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            elseif mode == "Behind" then
                                pullCFrame = (pullTarget.Root.CFrame * CFrame.new(0, -2, 0)) * CFrame.new(0, 0, distance)
                            else
                                pullCFrame = CFrame.new(pullPos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            end
                            
                            HuDy.TP(pullCFrame, pullTarget.Root.Position)
                            if pullTarget.Root.CanCollide then pullTarget.Root.CanCollide = false end
                            if pullTarget.Root.Anchored then pullTarget.Root.Anchored = false end
                            
                            HuDy.Attack(pullTarget.Root)
                            HuDy.AggroedMobs[pullTarget.Model] = tick()
                            task.wait(0.12)
                        else
                            -- Toàn bộ quái trong bãi đã aggro -> Đứng vững tại Con Trung Tâm để toàn bộ quái dồn lại 1 chỗ
                            local basePos = centerRoot.Position + Vector3.new(0, -2, 0)
                            local targetCFrame
                            if mode == "Above" then
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            elseif mode == "Behind" then
                                targetCFrame = (centerRoot.CFrame * CFrame.new(0, -2, 0)) * CFrame.new(0, 0, distance)
                            elseif mode == "Below" then
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, -distance, 0)) * CFrame.Angles(math.rad(90), 0, 0)
                            else
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            end
                            
                            -- Mở rộng Hitbox và tắt va chạm để các con quái lồng vào nhau tại trung tâm, dính trọn AOE
                            local SIZE_HITBOX = Vector3.new(15, 15, 15)
                            for _, sm in ipairs(spotMobs) do
                                if sm.Root then
                                    if sm.Root.CanCollide then sm.Root.CanCollide = false end
                                    if sm.Root.Size ~= SIZE_HITBOX then sm.Root.Size = SIZE_HITBOX end
                                    if sm.Root.Anchored then sm.Root.Anchored = false end
                                end
                            end
                            
                            HuDy.TP(targetCFrame, centerRoot.Position)
                            if HuDy.HasOpeV2 and HuDy.HasOpeV2() and not HuDy.IsOpeRoomActive(centerRoot.Position, centerMob) and not HuDy.OpeRoomCasting then
                                HuDy.CastOpeRoom(centerRoot.CFrame, centerMob)
                            end
                            HuDy.Attack(centerRoot)
                        end
                    else
                        -- Đánh đơn lẻ (Target từng con / Boss hoặc khi tắt Gom quái / chỉ còn 1 con)
                        local mob, mobRoot = nil, nil
                        if #spotMobs > 0 then
                            mob, mobRoot = spotMobs[1].Model, spotMobs[1].Root
                        else
                            mob, mobRoot = HuDy.FindMob(data.MobName)
                        end
                        
                        if mob and mobRoot then
                            local basePos = mobRoot.Position + Vector3.new(0, -2, 0)
                            local targetCFrame
                            if mode == "Above" then
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            elseif mode == "Behind" then
                                targetCFrame = (mobRoot.CFrame * CFrame.new(0, -2, 0)) * CFrame.new(0, 0, distance)
                            elseif mode == "Below" then
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, -distance, 0)) * CFrame.Angles(math.rad(90), 0, 0)
                            else
                                targetCFrame = CFrame.new(basePos + Vector3.new(0, distance, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            end
                            
                            HuDy.TP(targetCFrame, mobRoot.Position)
                            if HuDy.HasOpeV2 and HuDy.HasOpeV2() and not HuDy.IsOpeRoomActive(mobRoot.Position, mob) and not HuDy.OpeRoomCasting then
                                HuDy.CastOpeRoom(mobRoot.CFrame, mob)
                            end
                            HuDy.Attack(mobRoot)
                        else
                            -- Không tìm thấy quái -> Bay lên cao tại data.CFrame để đợi quái spawn
                            HuDy.CurrentCenterMob = nil
                            HuDy.CurrentCenterRoot = nil
                            HuDy.AggroedMobs = {}
                            if data.CFrame then
                                HuDy.TP(data.CFrame * CFrame.new(0, 0, 0)) 
                            else
                                HuDy.StopTP()
                            end
                        end
                    end
                end
            end)
        end
        HuDy.FarmLoopRunning = false
        HuDy.CurrentCenterMob = nil
        HuDy.CurrentCenterRoot = nil
        HuDy.AggroedMobs = {}
        HuDy.StopTP() -- Tắt thì rơi xuống đất
    end)
end

