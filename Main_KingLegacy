HuDy.DungeonLoopRunning = false

function HuDy.GetDungeonElevator()
    local islandFolder = workspace:FindFirstChild("Island")
    if islandFolder then
        for _, isl in ipairs(islandFolder:GetChildren()) do
            if string.find(string.lower(isl.Name), "dungeon") then
                local elevator = isl:FindFirstChild("Elevator")
                if elevator then
                    local meshPart = elevator:FindFirstChild("MeshPart") or elevator:FindFirstChildWhichIsA("BasePart")
                    if meshPart then return meshPart end
                end
            end
        end
    end
    -- Kiểm tra trực tiếp các đảo Dungeon
    local direct = islandFolder and (islandFolder:FindFirstChild("(Real) Hard Dungeon") or islandFolder:FindFirstChild("(Real) Normal Dungeon") or islandFolder:FindFirstChild("(Real) Easy Dungeon"))
    if direct and direct:FindFirstChild("Elevator") then
        return direct.Elevator:FindFirstChild("MeshPart") or direct.Elevator:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

function HuDy.GetDungeonGateEntrance()
    -- 1. Ưu tiên kiểm tra trực tiếp workspace.Dungeon
    local dungeonObj = workspace:FindFirstChild("Dungeon")
    if dungeonObj then
        if dungeonObj:IsA("BasePart") then
            return dungeonObj.CFrame
        elseif dungeonObj:IsA("Model") then
            local primary = dungeonObj.PrimaryPart or dungeonObj:FindFirstChild("HumanoidRootPart") or dungeonObj:FindFirstChildWhichIsA("BasePart")
            if primary then return primary.CFrame end
            local cf = dungeonObj:GetPivot()
            if cf then return cf end
        end
    end

    -- 2. Tọa độ cổng Dungeon chuẩn theo từng Sea (Sea 3: 10959.2, 133.8, 1250.7)
    if game.PlaceId == 15759515082 then
        return CFrame.new(10959.2, 133.8, 1250.7) -- Sea 3
    elseif game.PlaceId == 6381829480 or game.PlaceId == 6500329016 then
        return CFrame.new(1982.5, 48.2, 540.3) -- Sea 2 (Viridans)
    elseif game.PlaceId == 4520749081 or game.PlaceId == 14619717013 then
        return CFrame.new(785.4, 30.5, -425.2) -- Sea 1
    end

    -- 3. Quét tìm trong workspace.Island
    local islandFolder = workspace:FindFirstChild("Island")
    if islandFolder then
        for _, isl in ipairs(islandFolder:GetChildren()) do
            local n = string.lower(isl.Name)
            if n:find("dungeon") or n:find("gate") or n:find("portal") then
                local gate = isl:FindFirstChild("Gate") or isl:FindFirstChild("Portal") or isl:FindFirstChild("Entrance") or isl:FindFirstChild("MeshPart") or isl:FindFirstChild("Spawn")
                if gate then
                    local part = gate:IsA("BasePart") and gate or gate:FindFirstChildWhichIsA("BasePart")
                    if part then return part.CFrame end
                end
            end
        end
    end
    
    return CFrame.new(10959.2, 133.8, 1250.7)
end

function HuDy.GetAllDungeonMobs()
    local mobs = {}
    local char = LocalPlayer.Character
    
    local folders = {
        workspace:FindFirstChild("MOB"),
        workspace:FindFirstChild("Mob"),
        workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"),
        workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"),
        workspace:FindFirstChild("Monster"),
        workspace:FindFirstChild("Dungeon")
    }
    
    for _, f in ipairs(folders) do
        if f then
            for _, m in ipairs(f:GetChildren()) do
                if m:IsA("Model") and m ~= char then
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso")
                    if hum and root and hum.Health > 0 then
                        table.insert(mobs, { Model = m, Root = root, Hum = hum })
                    end
                end
            end
        end
    end
    return mobs
end

function HuDy.IsChaosCrabWarningActive(mobs)
    local crabMob = nil
    if mobs then
        for _, m in ipairs(mobs) do
            if m.Model and m.Hum and m.Hum.Health > 0 then
                local mName = string.lower(m.Model.Name or "")
                if mName:find("chaos crab") or mName:find("craberno") or mName:find("crab") or (m.Hum.MaxHealth >= 800000) then
                    crabMob = m
                    break
                end
            end
        end
    end
    
    if not crabMob or not crabMob.Root or not crabMob.Model then 
        HuDy.CrabBombActive = false
        HuDy.CrabBombStartTime = nil
        return false, nil 
    end

    -- 1. Kiểm tra trực tiếp xem có bất kỳ vòng nổ bom TargetPos nào đang TỒN TẠI trong model không:
    local hasActiveTargetPos = false
    for _, desc in ipairs(crabMob.Model:GetDescendants()) do
        if desc:IsA("Vector3Value") and string.find(desc.Name, "TargetPos") ~= nil then
            hasActiveTargetPos = true
            break
        end
    end

    local now = tick()
    if hasActiveTargetPos then
        if not HuDy.CrabBombActive then
            -- Bắt đầu đợt bom mới: Kích hoạt Ken Haki
            HuDy.CrabBombActive = true
            HuDy.CrabBombStartTime = now
            pcall(function()
                local kenFunc = ReplicatedStorage:FindFirstChild("Chest") and ReplicatedStorage.Chest:FindFirstChild("Remotes") and ReplicatedStorage.Chest.Remotes:FindFirstChild("Functions") and ReplicatedStorage.Chest.Remotes.Functions:FindFirstChild("KenEvent")
                if kenFunc then kenFunc:InvokeServer() end
            end)
        end
        
        -- Giới hạn an toàn tối đa 5.0s (phòng trường hợp game lag không tự xóa TargetPos)
        if (now - (HuDy.CrabBombStartTime or now)) < 5.0 then
            return true, crabMob
        else
            -- Quá 5.0s -> bom chắc chắn đã nổ xong -> tắt né
            return false, nil
        end
    else
        -- Ngay khi TargetPos biến mất khỏi game -> HẾT SKILL BOM NGAY LẬP TỨC -> QUAY LẠI TẤN CÔNG LIỀN!
        HuDy.CrabBombActive = false
        HuDy.CrabBombStartTime = nil
    end

    return false, nil
end

