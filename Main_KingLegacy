                        end
                        data = { MobName = n, SkipQuest = true }
                    elseif HuDy.Flags.AutoHopSerpent and HuDy.CheckBossAlive and HuDy.CheckBossAlive("serpent") then
                        data = { MobName = "Serpent", SkipQuest = true }
                    elseif HuDy.Flags.AutoHopPteradon and HuDy.CheckBossAlive and HuDy.CheckBossAlive("pteradon") then
                        data = { MobName = "Pteradon", SkipQuest = true }
                        
                    -- Ưu tiên 2: Farm Boss
                    elseif HuDy.Flags.AutoFarmBoss and HuDy.Flags.SelectedBoss and HuDy.Flags.SelectedBoss ~= "None" then
                        data = HuDy.GetTargetDataByMob(HuDy.Flags.SelectedBoss)
                        if data then data.SkipQuest = true end
                        
                    -- Ưu tiên 3: Farm Selected Mob
                    elseif HuDy.Flags.AutoFarmSelectedMob and HuDy.Flags.SelectedMob ~= "" then
                        data = HuDy.GetTargetDataByMob(HuDy.Flags.SelectedMob)
                        if data then data.SkipQuest = true end
                        
                    -- Ưu tiên 4: Farm Auto Level
                    elseif HuDy.Flags.AutoFarm or HuDy.Flags.AutoNextSea2 or HuDy.Flags.AutoNextSea3 then
                        data = HuDy.GetTargetData()
                    end
                end
                
                if not data then return end
                
                if data.MobName and data.MobName ~= lastDetectedMob then
                    lastDetectedMob = data.MobName
                    print("[HuDy Hub] Phát hiện mục tiêu: " .. tostring(data.MobName) .. " | Tiến hành khoá mục tiêu (Target Lock)!")
                    if WindUI and WindUI.Notify then
                        WindUI:Notify({ Title = "Target Lock", Content = "Phát hiện mục tiêu: " .. tostring(data.MobName), Icon = "solar:target-bold", Duration = 4 })
                    end
