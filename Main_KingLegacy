local function waitForCollectBtn(timeout)
    timeout = timeout or 3
    local t0 = tick()
    while tick() - t0 < timeout do
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local gui = pgui and pgui:FindFirstChild("EatFruitBecky")
        local dialogue = gui and gui:FindFirstChild("Dialogue")
        if dialogue then
            local btn = dialogue:FindFirstChild("Collect") or dialogue:FindFirstChild("Store")
            if btn and btn.Visible then return btn end
        end
        task.wait(0.1)
    end
    return nil
end

function HuDy.StoreFruit(fruitName)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char then return false end

    local fruitInBag = bp:FindFirstChild(fruitName)
    if not fruitInBag then return false end

    -- 1. Equip trÃ¡i vÃ o nhÃ¢n váº­t
    fruitInBag.Parent = char
    task.wait(0.5)

    if not char:FindFirstChild(fruitName) then
        local retry = bp:FindFirstChild(fruitName)
        if retry then retry.Parent = char; task.wait(0.5) end
    end
    if not char:FindFirstChild(fruitName) then return false end

    -- 2. Click áº£o mÃ n hÃ¬nh Ä‘á»ƒ kÃ­ch hoáº¡t GUI EatFruitBecky
    pcall(function()
        VirtualUser:ClickButton1(Vector2.new(300, 300))
    end)
    task.wait(0.3)

    -- 3. Chá» nÃºt Collect / Store xuáº¥t hiá»‡n
    local collectBtn = waitForCollectBtn(3)
    if not collectBtn then
        pcall(function() VirtualUser:ClickButton1(Vector2.new(300, 300)) end)
        task.wait(0.5)
        collectBtn = waitForCollectBtn(2)
    end

    if collectBtn then
        pcall(function()
            if typeof(firesignal) == "function" then
                pcall(function() firesignal(collectBtn.MouseButton1Click) end)
                pcall(function() firesignal(collectBtn.Activated) end)
            elseif typeof(getconnections) == "function" then
                for _, conn in pairs(getconnections(collectBtn.MouseButton1Click)) do pcall(function() conn:Fire() end) end
                for _, conn in pairs(getconnections(collectBtn.Activated)) do pcall(function() conn:Fire() end) end
            end
        end)
        task.wait(0.5)
    end

    -- 4. Kiá»ƒm tra xÃ¡c nháº­n trÃ¡i Ä‘Ã£ Ä‘Æ°á»£c lÆ°u vÃ o kho thÃ nh cÃ´ng
    local elapsed = 0
    while elapsed < 3 do
        task.wait(0.3)
        elapsed = elapsed + 0.3
        if not bp:FindFirstChild(fruitName) and not char:FindFirstChild(fruitName) then
            return true
        end
    end

    local stuck = char:FindFirstChild(fruitName)
    if stuck then stuck.Parent = bp end
    return false
end

