                                elseif folder:FindFirstChild("ThirdSeaDragon") then n = "ThirdSeaDragon"; break end
                            end
                        end
                        data = { MobName = n, SkipQuest = true }
                    elseif HuDy.Flags.AutoHopDeepseaCrusher and HuDy.CheckBossAlive and HuDy.CheckBossAlive("ds_crusher") then
                        local n = "ThirdSeaEldritch Crab"
                        local searchFolders = { workspace:FindFirstChild("SeaMonster"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"), workspace:FindFirstChild("Monster"), workspace }
                        for _, folder in ipairs(searchFolders) do
                            if folder then
                                if folder:FindFirstChild("Deepsea Crusher") then n = "Deepsea Crusher"; break
                                elseif folder:FindFirstChild("ThirdSeaEldritch Crab") then n = "ThirdSeaEldritch Crab"; break end
                            end
                        end
                        data = { MobName = n, SkipQuest = true }
                    elseif HuDy.Flags.AutoHopAbyssal and HuDy.CheckBossAlive and HuDy.CheckBossAlive("abyssal") then
                        local n = "Abyssal Tyrant"
                        local searchFolders = { workspace:FindFirstChild("SeaMonster"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"), workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"), workspace:FindFirstChild("Monster"), workspace }
                        for _, folder in ipairs(searchFolders) do
                            if folder then
                                if folder:FindFirstChild("Abyssal Tyrant") then n = "Abyssal Tyrant"; break
                                elseif folder:FindFirstChild("SeaDragon") then n = "SeaDragon"; break end
                            end
                        end
                        data = { MobName = n, SkipQuest = true }
                    elseif HuDy.Flags.AutoHopChaosKraken and HuDy.CheckBossAlive and HuDy.CheckBossAlive("chaos_kraken") then
                        local n = "Chaos Kraken"
                        local searchFolders = {
                            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"),
                            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"),
                            workspace:FindFirstChild("Monster"),
                            workspace:FindFirstChild("SeaMonster"),
                            workspace
                        }
                        for _, folder in ipairs(searchFolders) do
                            if folder and n == "Chaos Kraken" then
                                for _, m in ipairs(folder:GetChildren()) do
                                    if string.find(string.lower(m.Name), "tentacle") and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then
