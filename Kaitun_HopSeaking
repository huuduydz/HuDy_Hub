local function SaveAdminLog(player)
    pcall(function()
        if not writefile or not readfile or not isfolder then return end
        local folder = "HuDy Hub/AdminLogs"
        if not isfolder(folder) then
            pcall(function() makefolder("HuDy Hub") end)
            pcall(function() makefolder(folder) end)
        end
        local fileName = folder .. "/AdminDetected.json"
        local logs = {}
        if isfile and isfile(fileName) then
            local raw = readfile(fileName)
            if raw and raw ~= "" then
                pcall(function() logs = HttpService:JSONDecode(raw) end)
            end
        end
        if type(logs) ~= "table" then logs = {} end
        
        local entry = {
            Name = player.Name,
            UserId = player.UserId,
            DisplayName = player.DisplayName,
            JobId = game.JobId,
            PlaceId = game.PlaceId,
            Timestamp = os.time(),
            Date = os.date("!%Y-%m-%d %H:%M:%SZ")
        }
        table.insert(logs, entry)
        writefile(fileName, HttpService:JSONEncode(logs))
    end)
end





