local TaskCleaner = {
    _connections = {},
    _destroyed = false,
}

function TaskCleaner:Add(conn)
    if typeof(conn) == "RBXScriptConnection" then
        table.insert(self._connections, conn)
    end
    return conn
end

function TaskCleaner:Reset()
    self._destroyed = false
    self._connections = {}
end

function TaskCleaner:CleanAll()
    if self._destroyed then return end
    self._destroyed = true
    
    -- 1. Disconnect all registered RBXScriptConnections
    for _, conn in ipairs(self._connections) do
        pcall(function()
            if conn and conn.Connected then
                conn:Disconnect()
            end
        end)
    end
    self._connections = {}
    
    -- 2. Clean character physics constraints & reset anchors
    pcall(function()
        local char = lplr and LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                if root:FindFirstChild("FreezePos") then root.FreezePos:Destroy() end
                if root:FindFirstChild("FreezeRot") then root.FreezeRot:Destroy() end
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = false
                hum.AutoRotate = true
            end
        end
    end)
    -- NOTE: Không gọi Set3dRenderingEnabled(false) - gây màn hình đen/đứng hình
end

