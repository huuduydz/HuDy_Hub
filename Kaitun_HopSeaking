                end
            end
        end)

        -- 3. Click chuột với Fallback tâm màn hình (Chống lỗi onScreen = false khi Obf)
        pcall(function()
            if cam and VIM then
                local screenPos, onScreen = cam:WorldToScreenPoint(npcPart.Position)
                local sX = (onScreen and screenPos.X > 0) and screenPos.X or (cam.ViewportSize.X / 2)
                local sY = (onScreen and screenPos.Y > 0) and screenPos.Y or (cam.ViewportSize.Y / 2)
                
                -- Né Logo Roblox ở góc trái trên
                if sX < 55 and sY < 50 then
                    sX = math.max(60, cam.ViewportSize.X / 2)
                    sY = math.max(55, cam.ViewportSize.Y / 2)
                end

                for i = 1, 3 do
                    VIM:SendMouseButtonEvent(sX, sY, 0, true, game, 1)
                    task.wait(0.06)
                    VIM:SendMouseButtonEvent(sX, sY, 0, false, game, 1)
                    task.wait(0.08)
                end
            end
        end)

        -- 4. Bắn Remote Server dự phòng
        pcall(function()
            local chest = game:GetService("ReplicatedStorage"):FindFirstChild("Chest")
            local functions = chest and chest:FindFirstChild("Remotes") and chest.Remotes:FindFirstChild("Functions")
            local questRemote = functions and functions:FindFirstChild("Quest")
            if questRemote then
                pcall(function() questRemote:InvokeServer("talk", npcName) end)
            end
        end)

        task.wait(1.0)
        if cam then cam.CameraType = Enum.CameraType.Custom end

        -- 5. Bấm nút trong PlayerGui
        local pgui = (lp and lp:FindFirstChild("PlayerGui")) or (lplr and lplr:FindFirstChild("PlayerGui"))
        local clicked = false
        if pgui then
            for _, v in ipairs(pgui:GetDescendants()) do
                if (v:IsA("TextButton") or v:IsA("ImageButton")) and v.Visible then
                    local isVisible = true
                    local parent = v
                    while parent and parent:IsA("GuiObject") do
                        if not parent.Visible then isVisible = false; break end
                        parent = parent.Parent
                    end
                    if isVisible and v.AbsoluteSize.X > 0 then
                        local text = v:IsA("TextButton") and string.lower(v.Text) or ""
                        local childLabel = v:FindFirstChildWhichIsA("TextLabel")
                        if childLabel then text = text .. " " .. string.lower(childLabel.Text) end
                        local name = string.lower(v.Name)
                        if string.find(name, "accept") or string.find(text, "accept") or string.find(name, "confirm") or string.find(text, "confirm") or string.find(name, "next") or string.find(text, "next") then
                            if v and typeof(v) == "Instance" and v:IsA("GuiObject") and v:IsDescendantOf(game) then
                                pcall(function() GS.SelectedObject = v end)
                            end
                            task.wait(0.1)
                            for spam = 1, 5 do
                                VIM:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                                task.wait(0.05)
                                VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                                task.wait(0.05)
                            end
                            if firesignal then
                                pcall(function() firesignal(v.MouseButton1Click) end)
                                pcall(function() firesignal(v.Activated) end)
                            end
                            pcall(function() GS.SelectedObject = nil end)
                            clicked = true
                            break
                        end
                    end
                end
            end
        end
        return clicked
    end

