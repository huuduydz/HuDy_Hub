            local tt = string.lower(tool.ToolTip or "")
            local name = string.lower(tool.Name or "")
            expectedType = string.lower(expectedType)
            
            if expectedType == "melee" then
                return tt:find("melee") or tt:find("combat") or name:find("combat") or name:find("leg") or name:find("water") or name:find("dragon") or name:find("electro") or name:find("cyborg") or name:find("claw")
            elseif expectedType == "sword" then
                return tt:find("sword") or name:find("sword") or name:find("blade") or name:find("katana") or name:find("scythe") or name:find("saber") or name:find("cutlass")
            elseif expectedType == "fruit" then
                return tt:find("fruit") or tt:find("demon") or tt:find("devil") or name:find("fruit") or name:find("df")
            end
            return false
        end
        
        local matchedTools = {}
        for _, tool in ipairs(allTools) do
            for _, sel in ipairs(selectedTable) do
                if MatchesType(tool, sel) then
                    table.insert(matchedTools, tool)
                    break
                end
            end
        end
        
        if #matchedTools > 0 then
            return matchedTools
        end
        
        local currentTool = char:FindFirstChildOfClass("Tool")
        if currentTool then return {currentTool} end
        
        if backpack then
            local firstTool = backpack:FindFirstChildOfClass("Tool")
            if firstTool then return {firstTool} end
        end
        return nil
    end

    -- 6. Attack Engine (Từ main.lua dòng 401)
    local function Attack(mobRoot)
        _G.HuDy_Target = mobRoot
        local tools = GetWeapon()
        if tools and #tools > 0 then
            local char = LocalPlayer.Character
            for _, tool in ipairs(tools) do
                if tool.Parent ~= char and char:FindFirstChild("Humanoid") then
                    char.Humanoid:EquipTool(tool)
                end
                
                pcall(function() tool:Activate() end)
                
                pcall(function()
                    local vu = game:GetService("VirtualUser")
                    if vu then
                        vu:CaptureController()
                        vu:ClickButton1(Vector2.new(0, 0))
                    end
                end)
                
                if mobRoot then
                    pcall(function()
                        local chest = ReplicatedStorage:FindFirstChild("Chest")
                        local skillAction = chest and chest:FindFirstChild("Remotes") and chest.Remotes:FindFirstChild("Functions") and chest.Remotes.Functions:FindFirstChild("SkillAction")
                        if not skillAction then return end
                        
                        local toolToolTip = string.lower(tool.ToolTip or "")
                        local toolNameLower = string.lower(tool.Name or "")
                        local prefix = "FS"
                        if toolToolTip:find("sword") or toolNameLower:find("sword") or toolNameLower:find("blade") or toolNameLower:find("scythe") then
                            prefix = "SW"
                        elseif toolToolTip:find("fruit") or toolNameLower:find("fruit") then
                            prefix = "DF"
                        end
                        
                        local function sendSkill(toolName, pfx, skill, isDown)
                            task.spawn(function()
                                local actionType = (skill == "M1") and "Click" or (isDown and "Down" or "Up")
                                local args = { 
                                    [1] = pfx .. "_" .. toolName .. "_" .. skill, 
                                    [2] = {["MouseHit"] = mobRoot.CFrame, ["Type"] = actionType} 
                                }
                                pcall(function() skillAction:InvokeServer(table.unpack(args)) end)
                            end)
                        end
                        
                        -- Buff tốc độ M1: Spam gửi gói tin Click x2 lần mà không bị kẹt Ping
                        for i = 1, 2 do
                            sendSkill(tool.Name, prefix, "M1", true)
                            sendSkill(tool.Name, "FS", "M1", true)
                        end
                        
                        -- Spam Skill diện rộng
                        local allSkills = _G.skill or {"Z", "X", "C", "V", "E", "B"}
                        for _, skill in ipairs(allSkills) do
                            if skill ~= "M1" then
                                sendSkill(tool.Name, prefix, skill, true)
                                task.delay(0.1, function()
                                    sendSkill(tool.Name, prefix, skill, false)
                                end)
                            end
                        end
                    end)
                end
            end
        end
    end

    -- 7. Quest Helpers & Mob Detection (Từ main.lua dòng 502-565)
    local function GetCurrentActiveQuestMob()
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if not gui then return nil end
        local qGui = gui:FindFirstChild("QuestGui")
        if qGui and qGui:FindFirstChild("MainFrame") and qGui.MainFrame.Visible then
            local qTitle = qGui.MainFrame:FindFirstChild("QuestName") or qGui.MainFrame:FindFirstChildWhichIsA("TextLabel")
            if qTitle and qTitle.Text ~= "" then return string.lower(qTitle.Text) end
        end
        for _, v in pairs(gui:GetDescendants()) do
            if v:IsA("TextLabel") and v.Visible and (string.find(string.lower(v.Text), "progress") or string.find(v.Text, "0/")) then
                local p = v.Parent
                if p then 
                    for _, child in pairs(p:GetChildren()) do 
                        if child:IsA("TextLabel") and child ~= v and string.len(child.Text) > 2 then 
                            return string.lower(child.Text) 
                        end 
                    end 
                end
            end
        end
        return nil
    end

    local function CheckCorrectQuest(targetMobName)
        local activeMobName = GetCurrentActiveQuestMob()
        if not activeMobName then return false end
        local cleanTarget = string.lower(string.match(targetMobName, "^(.-)%s*%[") or targetMobName):match("^%s*(.-)%s*$")
        return string.find(activeMobName, cleanTarget, 1, true) ~= nil
    end

    local function FindMob(baseSearchName)
        baseSearchName = string.lower(string.match(baseSearchName, "^(.-)%s*%[") or baseSearchName):match("^%s*(.-)%s*$")
        local foldersToSearch = {}
        local function addFolder(f) if f then table.insert(foldersToSearch, f) end end
        
        local monsterFolder = workspace:FindFirstChild("Monster")
        if monsterFolder then
            addFolder(monsterFolder:FindFirstChild("Mon"))
            addFolder(monsterFolder:FindFirstChild("Boss"))
            addFolder(monsterFolder)
        end
        addFolder(workspace:FindFirstChild("SeaMonster"))
        addFolder(workspace:FindFirstChild("Boss"))
        addFolder(workspace:FindFirstChild("MOB"))
        addFolder(workspace:FindFirstChild("Mobs"))
        addFolder(workspace:FindFirstChild("Alive"))
        addFolder(workspace:FindFirstChild("Enemies"))

        for _, f in ipairs(foldersToSearch) do
            if f then 
                for _, m in ipairs(f:GetDescendants()) do
                    if m:IsA("Model") and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then
                        local mBase = string.lower(string.match(string.match(m.Name, "^(.-)%s*%[") or m.Name, "^%s*(.-)%s*$"))
                        if mBase == baseSearchName then 
                            local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Head") or m:FindFirstChildWhichIsA("BasePart", true)
                            if r then return m, r end 
                        end
                    end
                end 
            end
        end
        return nil, nil
    end

    local function FindNPC(npcName)
        local targetName = string.lower(npcName)
        local folders = {
            workspace:FindFirstChild("AllNPC"), 
            workspace:FindFirstChild("NPC"), 
            workspace:FindFirstChild("NPCs"),
            game:GetService("ReplicatedStorage"):FindFirstChild("NPC")
        }
        for _, folder in ipairs(folders) do
            if folder then 
                for _, obj in ipairs(folder:GetDescendants()) do 
                    if obj:IsA("Model") and string.find(string.lower(obj.Name), targetName, 1, true) then 
                        local part = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                        if part then return obj, part end 
                    end 
                end 
            end
        end
        return nil, nil
    end

