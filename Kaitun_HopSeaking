                    for _, srv in pairs(srvs) do
                        if type(srv) == "table" then
                            local jId
                            if srv.JobId then jId = srv.JobId end
                            if not jId then
                                for _, v in pairs(srv) do
                                    if type(v) == "string" and string.len(v) == 36 and string.match(v, "%-") then
                                        jId = v
                                    end
                                end
                            end
                            if jId and jId ~= game.JobId then
                                table.insert(validServers, jId)
                            end
                        end
                    end
                    
                    print("[HuDy Hub]: GetServerLists tim thay " .. tostring(#validServers) .. " server hop le!")
                    if #validServers > 0 then
                        local randomJobId = validServers[math.random(1, #validServers)]
