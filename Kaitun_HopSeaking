local function ReportServerToAPI(bossName, waitForResponse)
    local rawKey = string.lower(tostring(bossName))
    local entityKey = string.gsub(string.gsub(rawKey, " ", "_"), "ghost_ship", "gs")
    local isChest = string.find(entityKey, "chest") ~= nil
    
    -- Đọc thời gian thực còn lại của đảo từ ClockTime.SurfaceGui.Countdown
    local islandDespawnSec, activeIslandName = GetIslandRemainingSeconds()
    
    -- 💾 Ghi nhận trực tiếp vào Global JSON trong workspace (hoạt động độc lập, không phụ thuộc API)
    pcall(function()
        GlobalBossTracker:SaveServer(game.JobId, game.PlaceId, tostring(bossName), entityKey, islandDespawnSec or 0, isChest)
    end)
    
    if not Settings.UseAPI or Settings.API_Link == "" then return false end
    if entityKey == "gs" or entityKey == "chest_gs" or entityKey == "chest gs" or string.find(entityKey, "ghost") then
        return false -- Tạm thời ngưng gửi GS và Chest GS lên API
    end
    local spawnMs = os.time() * 1000
    local path = "/scout"
    local cleanLink = string.gsub(Settings.API_Link, "/$", "")
    
    local function sendRequest()
        -- using safeRequest
        local payload = {
            jobId = game.JobId,
            target = entityKey,
            spawnTime = spawnMs
        }
        if islandDespawnSec and islandDespawnSec > 0 then
            payload.despawnSeconds = islandDespawnSec
            payload.expireTime = os.time() + islandDespawnSec
        end
        
        local body = HttpService:JSONEncode({ payload })
        for attempt = 1, 3 do
            local hdrs, ts, sig = _SignedHeaders("POST", path, body)
            local signedUrl = _SignedUrl(cleanLink, path, ts, sig)
            local ok, res = pcall(function()
                return safeRequest({ Url=signedUrl, Method="POST", Headers=hdrs, Body=body })
            end)
            local sc = res and (res.StatusCode or res.status)
            if ok and res and (sc==200 or sc==201) then
                print(string.format("[Radar V45] Scout: %s | Đảo chìm trong: %ds", entityKey, islandDespawnSec or 0))
                return true
            elseif ok and res and sc==401 then
                warn("[Radar V45] ❌ HMAC Failed!")
                return false
            elseif ok and res and sc==429 then
                warn("[Radar V45] ⚠ Rate limited, wait 5s"); task.wait(5)
            else
                warn("[Radar V45] Scout attempt " .. attempt .. " failed: status=" .. tostring(sc))
                task.wait(0.5)
            end
        end
        return false
    end
    if waitForResponse then return sendRequest() else task.spawn(sendRequest); return true end
end

