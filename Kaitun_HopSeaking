            if not cachedMaterial then cachedMaterial = cachedStats:FindFirstChild("Material") end
            if not cachedFruit then cachedFruit = cachedStats:FindFirstChild("FruitStore") end
        end
        
        if cachedMaterial then
            local currentString = cachedMaterial.Value
            if currentString ~= lastDataString then
                lastDataString = currentString
                pcall(function()
                    local decodeFunc = getgenv().SafeDecodeLocal or DecodeData 
                    local data = decodeFunc(currentString)
                    m.T = data["Hydra's Tail"] or 0
                    m.F = data["Sea King's Fin"] or 0
                    m.B = data["Sea King's Blood"] or 0
                    m.W = data["Sea's Wraith"] or 0
                end)
            end
        end

        if cachedFruit then
            local currentFruitString = cachedFruit.Value
            if currentFruitString ~= lastFruitString then
                lastFruitString = currentFruitString
                pcall(function()
                    local decodeFunc = getgenv().SafeDecodeLocal or DecodeData 
                    local data = decodeFunc(currentFruitString)
                    local function getCount(n) 
                        local k = tonumber(data[n]) or 0
                        if LocalPlayer.Backpack:FindFirstChild(n) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(n)) then 
                            k = k + 1 
                        end
                        return k 
                    end
                    f.Do = getCount("DoughFruit")
                    f.Dr = getCount("DragonFruit")
                    f.M = getCount("MelodyFruit")
                    f.P = getCount("PhoenixFruit")
                    f.G = getCount("GateFruit")
                    f.T = getCount("ToyFruit")
                    f.D = getCount("DemonFruit")
                    f.Pter = getCount("PterFruit")
                    f.Tree = getCount("TreeFruit")
                end)
            end
        end

        if WhiteScreenMaterialsLabel then
            WhiteScreenMaterialsLabel.Text = string.format(
                "<b>FPS:</b> <font color='#38bdf8'><b>%d</b></font>   |   <b>Hop Count:</b> <font color='#f43f5e'><b>%d</b></font>\n" ..
                "<b>Tail:</b> <font color='#ff6666'><b>%d</b></font>  |  <b>Fin:</b> <font color='#66ccff'><b>%d</b></font>  |  <b>Blood:</b> <font color='#ff3333'><b>%d</b></font>  |  <b>Wraith:</b> <font color='#cc99ff'><b>%d</b></font>\n\n" ..
                "<font color='#94a3b8'><b>FRUITS INVENTORY</b></font>\n" ..
                "<b>Dough</b>  : <font color='#f59e0b'><b>%d</b></font>  |  <b>Dragon</b> : <font color='#ef4444'><b>%d</b></font>  |  <b>Melody</b> : <font color='#ec4899'><b>%d</b></font>\n" ..
                "<b>Phoenix</b>: <font color='#f97316'><b>%d</b></font>  |  <b>Gate</b>   : <font color='#06b6d4'><b>%d</b></font>  |  <b>Toy</b>    : <font color='#a855f7'><b>%d</b></font>\n" ..
                "<b>Demon</b>  : <font color='#b91c1c'><b>%d</b></font>  |  <b>Pter</b>   : <font color='#10b981'><b>%d</b></font>  |  <b>Tree</b>   : <font color='#84cc16'><b>%d</b></font>",
                fps, tonumber(Settings and Settings.HopCount) or 0,
                m.T, m.F, m.B, m.W,
                f.Do, f.Dr, f.M, f.P, f.G, f.T, f.D, f.Pter, f.Tree
            )
        end
    end
end)

