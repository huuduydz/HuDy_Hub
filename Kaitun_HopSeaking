local DEV_TEST_MODE = false -- Đặt thành true nếu muốn bypass Key khi dev test

local HUDY_SESSION_MEM = nil

local function AuthenticateSession()
    -- [BẢO MẬT LOADER] Kiểm tra token xác nhận load qua loader.lua
    if _G.HUDY_LOADER_KEY ~= "HudyV6_SECURE_3399216308" then
        warn("[Hudy V5] Phát hiện Bypass! Script không được chạy qua Loader chính thức.")
        return false
    end

    if DEV_TEST_MODE then
        _G.HUDY_AUTH = true
        return true
    end

    local BASE_URL = (type(_G) == "table" and _G.KEY_URL and _G.KEY_URL ~= "") and _G.KEY_URL or "https://webkey-hub.vercel.app"

    local function nowMs()
        local ok, v = pcall(function()
            return DateTime.now().UnixTimestampMillis
        end)
        if ok and type(v) == "number" then
            return v
        end
        return os.time() * 1000
    end

    local function getFp()
        local get_exec = identifyexecutor
        local get_hw = gethwid
        local ex = "unknown"
        if type(get_exec) == "function" then
            pcall(function() ex = tostring(get_exec()) end)
        end
        local hw = "nohwid"
        if type(get_hw) == "function" then
            pcall(function() hw = tostring(get_hw()) end)
        end
        return ex .. "|" .. hw .. "|" .. tostring(game.PlaceId or 0)
    end

    local function validSession(s)
        return type(s) == "table"
            and type(s.token) == "string"
            and s.token ~= ""
            and type(s.expireAt) == "number"
            and s.expireAt > nowMs()
    end

    local function loadSession()
        -- 1. Check RAM / Memory
        if validSession(HUDY_SESSION_MEM) then
            return HUDY_SESSION_MEM
        end
        if _G.HUDY_AUTH == true then
            return { token = "AUTH_OK", expireAt = nowMs() + 86400000 }
        end
        local genv = (type(getgenv) == "function" and getgenv()) or {}
        local sess = genv.HUDY_SESSION or _G.HUDY_SESSION
        if validSession(sess) then
            return sess
        end

        -- 2. Check TeleportSetting (V44 HUDY_SESSION_JSON & V45 HUDY_SESSION)
        local ok1, tData1 = pcall(function() return TeleportService:GetTeleportSetting("HUDY_SESSION_JSON") end)
        if ok1 and type(tData1) == "string" and tData1 ~= "" then
            local decodeOk, t = pcall(function() return HttpService:JSONDecode(tData1) end)
            if decodeOk and validSession(t) then
                return t
            end
        end
        local ok2, tData2 = pcall(function() return TeleportService:GetTeleportSetting("HUDY_SESSION") end)
        if ok2 and validSession(tData2) then
            return tData2
        end

        -- 3. Check Local File Cache
        if isfile and readfile then
            local p = "HuDy Hub/WebKey/" .. tostring(LP.Name):gsub("[^%w_%-]", "_"):sub(1, 48) .. "_auth_session.json"
            local fOk, raw = pcall(function() return readfile(p) end)
            if fOk and type(raw) == "string" and raw ~= "" then
                local okDec, t = pcall(function() return HttpService:JSONDecode(raw) end)
                if okDec and validSession(t) then
                    return t
                end
            end
        end

        return nil
    end

    local function saveSession(s)
        HUDY_SESSION_MEM = s
        _G.HUDY_SESSION = s
        _G.HUDY_AUTH = true
        pcall(function()
            local jsonStr = HttpService:JSONEncode(s)
            TeleportService:SetTeleportSetting("HUDY_SESSION_JSON", jsonStr)
            TeleportService:SetTeleportSetting("HUDY_SESSION", s)
            
            if writefile and makefolder then
                if not isfolder("HuDy Hub") then makefolder("HuDy Hub") end
                if not isfolder("HuDy Hub/WebKey") then makefolder("HuDy Hub/WebKey") end
                local p = "HuDy Hub/WebKey/" .. tostring(LP.Name):gsub("[^%w_%-]", "_"):sub(1, 48) .. "_auth_session.json"
                writefile(p, jsonStr)
            end
        end)
    end

    local function requestJson(url)
        local delaySec = 1
        for i = 1, 3 do
            local ok, res = pcall(function()
                return game:HttpGet(url)
            end)
            if ok and type(res) == "string" and res ~= "" then
                local ok2, data = pcall(function()
                    return HttpService:JSONDecode(res)
                end)
                if ok2 and type(data) == "table" then
                    return data
                end
            end
            if i < 3 then
                task.wait(delaySec)
                delaySec = delaySec * 2
            end
        end
        return nil
    end

    local session = loadSession()
    if not session then
        local genv = (type(getgenv) == "function" and getgenv()) or {}
        local userKey = ""
        pcall(function()
            local raw = genv.HUDY_KEY or genv.Key or genv.key or _G.HUDY_KEY or _G.Key or _G.key
            if type(raw) == "string" then userKey = raw:gsub("%s+", "") end
        end)

        local url = BASE_URL
            .. "/api/execute?format=json&name=" .. HttpService:UrlEncode(LP.Name)
            .. "&fp=" .. HttpService:UrlEncode(getFp())
            .. (userKey ~= "" and ("&key=" .. HttpService:UrlEncode(userKey)) or "")

        local data = requestJson(url)
        if not data or data.ok ~= true or type(data.token) ~= "string" then
            return false
        end
        -- Set TTL to exact 2 hours (7200000 ms) as requested to save file for 2h
        local ttlMs = 2 * 3600 * 1000
        if ttlMs <= 0 then
            return false
        end
        session = {
            token = data.token,
            expireAt = nowMs() + ttlMs - 5000
        }
        saveSession(session)
    else
        saveSession(session)
    end
    return true
end

