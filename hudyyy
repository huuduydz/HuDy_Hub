function HuDy.EquipBestSerpentSword()
    if not HuDy.IsCharacterReady() then return nil end
    local now = tick()
    if (now - (HuDy.LastEquipSerpentSwordAt or 0)) < 1.0 then return end
    HuDy.LastEquipSerpentSwordAt = now

    local char = LocalPlayer.Character or LP.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack") or LP:FindFirstChild("Backpack")
    local humanoid = char and char:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return nil end
    local etcRemote = ReplicatedStorage:FindFirstChild("Chest") 
        and ReplicatedStorage.Chest:FindFirstChild("Remotes")
        and ReplicatedStorage.Chest.Remotes:FindFirstChild("Functions")
        and ReplicatedStorage.Chest.Remotes.Functions:FindFirstChild("EtcFunction")

    -- 1. Nếu trên tay đang cầm Cần Câu (Rod) -> Chỉ tháo cần câu ra khi trong backpack chắc chắn có vũ khí thay thế (chống tay không None)
    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool and string.find(string.lower(currentTool.Name), "rod") then
        local hasOtherTool = false
        if backpack then
            for _, t in ipairs(backpack:GetChildren()) do
                if t:IsA("Tool") and not string.find(string.lower(t.Name), "rod") then
                    hasOtherTool = true
                    break
                end
            end
        end
        if hasOtherTool then
            humanoid:UnequipTools()
            task.wait(0.1)
        end
    end

    -- 2. ƯU TIÊN 1: Acrodagger
    local acroTool = (char and (char:FindFirstChild("Acrodagger") or char:FindFirstChild("AcrodaggerStyle")))
        or (backpack and (backpack:FindFirstChild("Acrodagger") or backpack:FindFirstChild("AcrodaggerStyle")))
    
    if not acroTool and etcRemote then
        pcall(function()
            local args = {
                "EquipWeapon",
                {
                    WeaponName = "Acrodagger",
                    Type = "Primary"
                }
            }
            etcRemote:InvokeServer(unpack(args))
        end)
        task.wait(0.2)
        acroTool = (char and (char:FindFirstChild("Acrodagger") or char:FindFirstChild("AcrodaggerStyle")))
            or (backpack and (backpack:FindFirstChild("Acrodagger") or backpack:FindFirstChild("AcrodaggerStyle")))
    end

    if acroTool then
        if humanoid and acroTool.Parent ~= char then
            humanoid:EquipTool(acroTool)
        end
        return "Acrodagger"
    end

    -- 3. ƯU TIÊN 2: Bisento (nếu chưa có Acrodagger)
    local bisentoTool = (char and (char:FindFirstChild("Bisento") or char:FindFirstChild("Quake Spear") or char:FindFirstChild("QuakeSpear")))
        or (backpack and (backpack:FindFirstChild("Bisento") or backpack:FindFirstChild("Quake Spear") or backpack:FindFirstChild("QuakeSpear")))

    if not bisentoTool and etcRemote then
        pcall(function()
            local args = {
                "EquipWeapon",
                {
                    WeaponName = "Bisento",
                    Type = "Primary"
                }
            }
            etcRemote:InvokeServer(unpack(args))
        end)
        task.wait(0.2)
        bisentoTool = (char and (char:FindFirstChild("Bisento") or char:FindFirstChild("Quake Spear") or char:FindFirstChild("QuakeSpear")))
            or (backpack and (backpack:FindFirstChild("Bisento") or backpack:FindFirstChild("Quake Spear") or backpack:FindFirstChild("QuakeSpear")))
    end

    if bisentoTool then
        if humanoid and bisentoTool.Parent ~= char then
            humanoid:EquipTool(bisentoTool)
        end
        return "Bisento"
    end

    -- 4. Fallback: Trang bị bất kỳ Tool nào khác không phải Cần câu
    if backpack and humanoid then
        for _, t in ipairs(backpack:GetChildren()) do
            if t:IsA("Tool") and not string.find(string.lower(t.Name), "rod") then
                humanoid:EquipTool(t)
                return t.Name
            end
        end
    end
    return nil
end

