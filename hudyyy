function ReadyTracker:GetCandidateServers()
    -- Luôn kiểm tra và đẩy các server vừa đạt mốc BossEarlyJoinSec từ GlobalBossServers.json sang ready.json
    pcall(function()
        if GlobalBossTracker then
            GlobalBossTracker:Load()
            GlobalBossTracker:CleanAndPromoteReady()
        end
    end)

    self:Load()
    self:Clean()
    local now = os.time()
    local candidates = {}
    
    for id, srv in pairs(self.Data.servers) do
        local rawId = srv.jobId
        local pid = tonumber(srv.placeId) or game.PlaceId
        local isCurrentPlace = (pid == game.PlaceId)
        
        if rawId and rawId ~= game.JobId 
            and isCurrentPlace
            and not sessionIgnoredServers[rawId]
            and not (AppData.blacklist2 and AppData.blacklist2[rawId]) then
            
            local readyAt = tonumber(srv.readyAt) or now
            local elapsedInReady = now - readyAt
            local remainingReadyTime = 150 - elapsedInReady
            local isChest = srv.isChest == true
            local targetType = tostring(srv.targetType or "")
            
            local isAllowed = false
            if isChest then
                isAllowed = true
            elseif string.find(targetType, "hd") or string.find(string.lower(srv.bossName), "hydra") then
                isAllowed = allowedBosses.HydraSeaKing
            elseif string.find(targetType, "sk") or string.find(string.lower(srv.bossName), "sea") then
                isAllowed = allowedBosses.SeaKing
            elseif string.find(targetType, "gs") or string.find(string.lower(srv.bossName), "ghost") then
                isAllowed = allowedBosses.GhostShip
            else
                isAllowed = true
            end
            
            if isAllowed and remainingReadyTime > 0 then
                table.insert(candidates, {
                    jobId = rawId,
                    placeId = pid,
                    bossName = srv.bossName or "Boss",
                    targetType = targetType,
                    remainingReadyTime = remainingReadyTime,
                    isChest = isChest,
                    priority = isChest and 1 or 2
                })
            end
        end
    end
    
    table.sort(candidates, function(a, b)
        return a.priority < b.priority
    end)
    
    return candidates
end

