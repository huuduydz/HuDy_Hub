function GlobalBossTracker:CleanAndPromoteReady()
    local now = os.time()
    local changed = false
    local earlyJoinSec = (type(_G) == "table" and type(_G.BossEarlyJoinSec) == "number") and _G.BossEarlyJoinSec or 30
    
    for id, srv in pairs(self.Data.servers) do
        local spawnTs = tonumber(srv.spawnTimestamp) or 0
        local isChest = srv.isChest == true
        local age = now - (srv.discoveredAt or now)
        local timeUntilSpawn = spawnTs - now
        
        -- Nếu server quá cũ (> 30 phút không update hoặc quá hạn 15 phút) -> xóa
        if age > 1800 or timeUntilSpawn < -900 then
            self.Data.servers[id] = nil
            changed = true
        -- 🛑 NẾU SERVER ĐÃ ĐỦ TIME (rương có sẵn HOẶC boss sắp spawn trong earlyJoinSec HOẶC boss đang có) -> CHUYỂN SANG READY.JSON
        elseif isChest or (timeUntilSpawn <= earlyJoinSec) then
            pcall(function()
                ReadyTracker:AddServer(srv)
            end)
            self.Data.servers[id] = nil
            changed = true
        end
    end
    if changed then
        self:Save()
    end
end

function GlobalBossTracker:SaveServer(jobId, placeId, bossName, targetType, remainingSeconds, isChest)
    if not jobId or jobId == "" then return end
    -- Bỏ qua Global JSON đối với Sea 3 và Set Sail (chỉ dùng Cloud API)
    local tKey = string.lower(tostring(targetType or ""))
    local bLower = string.lower(tostring(bossName or ""))
    local isSetSail = (tKey == "serpent" or tKey == "df_inferno" or tKey == "ds_crusher" or tKey == "abyssal" or tKey == "chaos_kraken")
        or string.find(bLower, "setsail", 1, true)
    if isSea3 or isSetSail or (ServerHop and ServerHop.Mode == "set_sail") or (placeId == 15759515082) then
        return
    end
    local now = os.time()
    local spawnTs = now + (tonumber(remainingSeconds) or 0)
    local srvData = {
        jobId = jobId,
        placeId = placeId or game.PlaceId,
        bossName = bossName or "Boss",
        targetType = targetType or "sk",
        spawnTimestamp = spawnTs,
        discoveredAt = now,
        isChest = isChest == true,
        scoutedBy = tostring(LocalPlayer.Name)
    }
    
    local earlyJoinSec = (type(_G) == "table" and type(_G.BossEarlyJoinSec) == "number") and _G.BossEarlyJoinSec or 30
    local timeUntilSpawn = spawnTs - now
    
    -- Nếu đã đủ time ngay lúc phát hiện (vd: rương thật hoặc boss xuất hiện hoặc remainingSec <= earlyJoinSec) -> đưa thẳng vào ready.json
    if isChest or timeUntilSpawn <= earlyJoinSec then
        pcall(function()
            ReadyTracker:AddServer(srvData)
        end)
    else
        self:Load()
        self.Data.servers[jobId] = srvData
