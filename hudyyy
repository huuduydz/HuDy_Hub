local function NormalizeWeaponName(value)
    return string.lower(tostring(value or "")):gsub("[^%w]", "")
end

local function IsBisentoOrQuakeSpear(rawName)
    if not rawName then return false end
    local n = NormalizeWeaponName(rawName)
    if n:find("bisento", 1, true) or n:find("quakespear", 1, true) then
        return true
    end
    if n:find("quake", 1, true) and n:find("spear", 1, true) then
        return true
    end
    return false
end

function HuDy.IsBisentoEquipped()
    local char = LocalPlayer.Character or LP.Character
    if not char then return false, nil end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and IsBisentoOrQuakeSpear(item.Name) then
            HuDy.BisentoOwned = true
            return true, item
        end
    end
    return false, nil
end

function HuDy.GetBisentoTool()
    local char = LocalPlayer.Character or LP.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack") or LP:FindFirstChild("Backpack")
    for _, container in ipairs({char, backpack}) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and IsBisentoOrQuakeSpear(item.Name) then
                    HuDy.BisentoOwned = true
                    return item
                end
            end
        end
    end
    return nil
end

function HuDy.HasBisento()
    -- 1. Nếu cờ trong RAM đã xác nhận -> true ngay
    if HuDy.BisentoOwned then return true end

    -- 2. Kiểm tra file lưu trữ trên disk
    local bisentoFile = "HuDy Hub/" .. tostring(LP.Name) .. "/BisentoOwned.txt"
    if isfile and isfile(bisentoFile) then
        local content = nil
        pcall(function() content = readfile(bisentoFile) end)
        if content == "OWNED" or content == "DONE" or content == "TRUE" then
            HuDy.BisentoOwned = true
            return true
        end
    end

    -- 3. Kiểm tra Tool trên tay Character hoặc trong Backpack
    if HuDy.GetBisentoTool() then
        HuDy.BisentoOwned = true
        pcall(function()
            if writefile then
                if not isfolder("HuDy Hub") then makefolder("HuDy Hub") end
                if not isfolder("HuDy Hub/" .. tostring(LP.Name)) then makefolder("HuDy Hub/" .. tostring(LP.Name)) end
                writefile(bisentoFile, "OWNED")
            end
        end)
        return true
    end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui") or LP:FindFirstChild("PlayerGui")
    if playerGui then
        -- 4. Quét ScrollingFrameSwords trong PlayerGui (Inventory)
        -- Kiểm tra cả tên nút item và SwordName text label bên trong (như Quake Spear)
        for _, desc in ipairs(playerGui:GetDescendants()) do
            if desc:IsA("ScrollingFrame") and desc.Name == "ScrollingFrameSwords" then
                for _, swordItem in ipairs(desc:GetChildren()) do
                    if IsBisentoOrQuakeSpear(swordItem.Name) then
                        HuDy.BisentoOwned = true
                        pcall(function()
                            if writefile then
                                if not isfolder("HuDy Hub") then makefolder("HuDy Hub") end
                                if not isfolder("HuDy Hub/" .. tostring(LP.Name)) then makefolder("HuDy Hub/" .. tostring(LP.Name)) end
                                writefile(bisentoFile, "OWNED")
                            end
                        end)
                        return true
                    end
                    local swordNameLbl = swordItem:FindFirstChild("SwordName", true)
                    if swordNameLbl and swordNameLbl:IsA("TextLabel") and IsBisentoOrQuakeSpear(swordNameLbl.Text) then
                        HuDy.BisentoOwned = true
                        pcall(function()
                            if writefile then
                                if not isfolder("HuDy Hub") then makefolder("HuDy Hub") end
                                if not isfolder("HuDy Hub/" .. tostring(LP.Name)) then makefolder("HuDy Hub/" .. tostring(LP.Name)) end
                                writefile(bisentoFile, "OWNED")
                            end
                        end)
                        return true
                    end
                end
            end
        end

        -- 5. Quét PlayerGui.Backpack.Slots (Hotbar / Ô trang bị vũ khí)
        local bpGui = playerGui:FindFirstChild("Backpack")
        if bpGui then
            local slots = bpGui:FindFirstChild("Slots")
            if slots then
                for _, slot in ipairs(slots:GetChildren()) do
                    local toolNameLbl = slot:FindFirstChild("ToolName", true)
                    if toolNameLbl and toolNameLbl:IsA("TextLabel") and IsBisentoOrQuakeSpear(toolNameLbl.Text) then
                        HuDy.BisentoOwned = true
                        pcall(function()
                            if writefile then
                                if not isfolder("HuDy Hub") then makefolder("HuDy Hub") end
                                if not isfolder("HuDy Hub/" .. tostring(LP.Name)) then makefolder("HuDy Hub/" .. tostring(LP.Name)) end
                                writefile(bisentoFile, "OWNED")
                            end
                        end)
                        return true
                    end
                end
            end
        end

        -- 6. Quét toàn bộ TextLabel trong PlayerGui có nội dung là "Quake Spear" hoặc "Bisento"
        -- (chính xác như hình ảnh hiển thị trong UI của người dùng, loại trừ thanh máu Boss / Drop list)
        for _, lbl in ipairs(playerGui:GetDescendants()) do
            if lbl:IsA("TextLabel") and IsBisentoOrQuakeSpear(lbl.Text) then
                local p = lbl.Parent
                local pName = p and string.lower(p.Name) or ""
                local pp = p and p.Parent
                local ppName = pp and string.lower(pp.Name) or ""
                if not pName:find("drop") and not ppName:find("drop") and not pName:find("boss") and not ppName:find("boss") then
                    HuDy.BisentoOwned = true
                    pcall(function()
                        if writefile then
                            if not isfolder("HuDy Hub") then makefolder("HuDy Hub") end
                            if not isfolder("HuDy Hub/" .. tostring(LP.Name)) then makefolder("HuDy Hub/" .. tostring(LP.Name)) end
                            writefile(bisentoFile, "OWNED")
                        end
                    end)
                    return true
                end
            end
        end
    end

    -- 7. Kiểm tra PlayerScripts ClientSkillHandler
    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts") or LP:FindFirstChild("PlayerScripts")
