local function ParseGUITimeToSeconds(timeText)
    if not timeText or timeText == "" then return nil end
    local text = string.lower(tostring(timeText))
    if string.find(text, "spawn") or string.find(text, "alive") then return 0 end
    local h, m, s = string.match(text, "(%d+):(%d+):(%d+)")
    if h and m and s then return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s) end
    m, s = string.match(text, "(%d+):(%d+)")
    if m and s then return tonumber(m) * 60 + tonumber(s) end
    return nil
end

local function GetIslandRemainingSeconds(targetIslandName)
    local wIsland = workspace:FindFirstChild("Island")
    if not wIsland then return nil, nil end
    
    local bestSec = nil
    local bestIslandName = nil

    for _, isl in ipairs(wIsland:GetChildren()) do
        -- Lọc chuẩn 100% theo test_island_countdown.lua: chỉ nhận Sea King & Legacy Island, bỏ qua Third Sea Rock
        local isEventIsland = (string.find(isl.Name, "Sea King") or string.find(isl.Name, "Legacy Island"))
            and not string.find(isl.Name, "Rock")

        if isEventIsland and (not targetIslandName or isl.Name == targetIslandName) then
            local anchor = isl:FindFirstChild("HydraStand") or isl:FindFirstChild("ChestSpawner")
            local isUp = true
            if anchor and anchor:IsA("BasePart") and anchor.Position.Y < 0 then
                isUp = false
            end

            if isUp then
                local clockTime = isl:FindFirstChild("ClockTime")
                local countdownText = nil

                if clockTime then
                    for _, desc in ipairs(clockTime:GetDescendants()) do
                        if desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then
                            local rawText = desc.Text or desc.ContentText or ""
                            if rawText ~= "" and string.match(rawText, "%d+:%d+") then
                                countdownText = rawText
                                break
                            end
                        end
                    end
                end

                if not countdownText then
                    for _, desc in ipairs(isl:GetDescendants()) do
                        if desc:IsA("TextLabel") and string.match(desc.Text or "", "%d+:%d+") then
                            countdownText = desc.Text
                            break
                        end
                    end
                end

                if countdownText then
                    local secs = ParseGUITimeToSeconds(countdownText)
                    if secs ~= nil then
                        if bestSec == nil or (secs < bestSec and secs > 0) then
                            bestSec = secs
                            bestIslandName = isl.Name
                        end
                    end
                end
            end
        end
    end

    return bestSec, bestIslandName
end

