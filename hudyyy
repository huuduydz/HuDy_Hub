        -- 🛑 TỰ ĐỘNG XÓA SERVER NẾU ĐÃ Ở TRONG READY.JSON QUÁ 150S (KHÔNG XÓA KHI 1 ACC BLACKLIST)
        if readyDuration >= 150 then
