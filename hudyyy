function HuDy.ExecuteQuestFarm(data)
    if HuDy.AutoFishSerpentActive then
        return
    end
    local root = GetRootPart()
    local hum = GetHumanoid()
    if not root or not hum then return end

    -- Material farm không cần quest. Nếu bảng chọn quest cũ còn mở do phiên
    -- trước, đóng nó một lần để GUI không che màn hình và không giữ state NPC.
    if data.SkipQuest and data.MaterialName and not HuDy.ClosedMaterialQuestDialog then
        HuDy.ClosedMaterialQuestDialog = true
        pcall(function()
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            if not playerGui then return end
            for _, button in ipairs(playerGui:GetDescendants()) do
                if button:IsA("TextButton") and button.Visible then
                    local text = string.lower(tostring(button.Text or ""))
                    if text == "abandon" or text == "cancel" or text == "close" then
                        if firesignal then
                            firesignal(button.MouseButton1Click)
                            firesignal(button.Activated)
                        end
                        break
                    end
                end
            end
        end)
    end

    if data.MaterialName and data.RequiredAmount then
        local materialCount = HuDy.GetMaterialCount(data.MaterialName)
        if materialCount >= data.RequiredAmount then return end
        CurrentStatusText = string.format(
            "<b>Status:</b> Farm %s %d/%d - %s",
            tostring(data.MaterialName),
            materialCount,
            data.RequiredAmount,
            tostring(data.MobName)
        )
    end
    
    local shouldSkipQuest = data.SkipQuest or _G.SkipQuest or _G.NoQuest
    local hasCorrectQuest = shouldSkipQuest or CheckCorrectQuest(data.MobName)
    if not hasCorrectQuest and data.QuestName then
        -- Game King Legacy cho phép nhận Quest từ xa qua RemoteFunction.
        -- Tuyệt đối KHÔNG tìm NPC và KHÔNG TP về NPC, bay thẳng ra bãi quái nhận từ xa giống main.lua!
        local mobModelNear = FindMob(data.MobName)
        local isNearMobSpot = (data.CFrame and (root.Position - data.CFrame.Position).Magnitude <= 35) or (mobModelNear ~= nil)

        if not isNearMobSpot and data.CFrame then
            TP(data.CFrame * CFrame.new(0, 5, 0))
            return
        end

        CurrentStatusText = "<b>Status:</b> [Từ Xa] Nhận nhiệm vụ: " .. tostring(data.QuestName)
        StopTP()
        task.wait(0.3)
        local chest = ReplicatedStorage:FindFirstChild("Chest")
        local qFunc = chest and chest:FindFirstChild("Remotes") and chest.Remotes:FindFirstChild("Functions") and chest.Remotes.Functions:FindFirstChild("Quest")
        if qFunc then
            pcall(function() qFunc:InvokeServer("take", data.QuestName) end)
            task.wait(0.5)

            -- Nếu nhận quest bằng tên mặc định thất bại -> Brute Force các biến thể tên quái (như main.lua)
            if not CheckCorrectQuest(data.MobName) then
                local base = string.match(data.MobName, "^(.-)%s*%[") or data.MobName
                base = base:match("^%s*(.-)%s*$")
                local amounts = {4, 6, 1, 5, 8, 10, 2, 3}
                local prefixes = {"Kill ", "Defeat ", "Quest ", ""}
                local found = false

                for _, amt in ipairs(amounts) do
                    local variations = {base, base .. "s", base .. "es"}
                    if string.find(string.lower(base), "man") then 
                        table.insert(variations, base:gsub("man", "men"):gsub("Man", "Men")) 
                    end
                    if string.sub(string.lower(base), -1) == "y" then 
                        table.insert(variations, string.sub(base, 1, -2) .. "ies") 
                    end

                    for _, prefix in ipairs(prefixes) do 
                        for _, mobVar in ipairs(variations) do 
                            local guess = (prefix == "") and mobVar or (prefix .. amt .. " " .. mobVar)
                            pcall(function() qFunc:InvokeServer("take", guess) end)
                            task.wait(0.2)
                            if CheckCorrectQuest(data.MobName) then 
                                data.QuestName = guess -- Cache lại tên đúng
                                found = true
                                break 
                            end 
                        end
                        if found then break end 
                    end
                    if found then break end 
                end
            end
        end
    end
    
    local targetMob, targetRoot = FindMob(data.MobName)
    if targetMob and targetRoot then
        if not HuDy.IsCharacterReady() then
            task.wait(0.4)
            return
        end
        if not data.MaterialName then
            CurrentStatusText = "<b>Status:</b> Tiêu diệt quái: " .. tostring(data.MobName)
        end
        local dist = _G.FarmDistance or 8
        local targetCFrame = CFrame.new(targetRoot.Position + Vector3.new(0, dist, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
        TP(targetCFrame, targetRoot.Position)
        Attack(targetRoot)
    else
        if data.MaterialName then
            local materialCount = HuDy.GetMaterialCount(data.MaterialName)
            CurrentStatusText = string.format(
                "<b>Status:</b> Farm %s %d/%d - đợi %s spawn",
                tostring(data.MaterialName),
                materialCount,
                data.RequiredAmount,
                tostring(data.MobName)
            )
        else
            CurrentStatusText = "<b>Status:</b> Đang đợi quái spawn: " .. tostring(data.MobName)
        end
        if data.CFrame then
            TP(data.CFrame * CFrame.new(0, 15, 0))
        else
            StopTP()
        end
    end
end

