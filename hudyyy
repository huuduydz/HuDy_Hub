                local sKraken = HuDy.GetMaterialCount("Severed Kraken")
                local dScale  = HuDy.GetMaterialCount("Dragon Scale")
                local pTear   = HuDy.GetMaterialCount("Phoenix's Tear")
                local tShard  = HuDy.GetTrickshardCount and HuDy.GetTrickshardCount() or HuDy.GetMaterialCount("Trickshard")
