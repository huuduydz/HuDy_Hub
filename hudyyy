                    "Kraken's Ink  : <font color='#38bdf8'><b>%d</b></font>  | Crab Meat     : <font color='#38bdf8'><b>%d</b></font>\n" ..
                    "Severed Kraken: <font color='#38bdf8'><b>%d</b></font>  | Dragon Scale  : <font color='#38bdf8'><b>%d</b></font>\n" ..
                    "Phoenix's Tear: <font color='#f59e0b'><b>%d</b></font>  | Trickster: %s\n" ..
                    "<font color='#94a3b8'>Stat Build: %s | Stat Points: %d</font>",
                    dFang, sFin, kInk, cMeat, sKraken, dScale, pTear, tricksterStatus, CurrentStatMode, availablePoints
