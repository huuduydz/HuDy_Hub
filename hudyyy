    local function FindMob(baseSearchName)
        baseSearchName = string.lower(string.match(baseSearchName, "^(.-)%s*%[") or baseSearchName):match("^%s*(.-)%s*$")
        local foldersToSearch = {}
        local function addFolder(f) if f then table.insert(foldersToSearch, f) end end
        
        local monsterFolder = workspace:FindFirstChild("Monster")
        if monsterFolder then
            addFolder(monsterFolder:FindFirstChild("Mon"))
            addFolder(monsterFolder:FindFirstChild("Boss"))
            addFolder(monsterFolder)
        end
        addFolder(workspace:FindFirstChild("SeaMonster"))
        addFolder(workspace:FindFirstChild("Boss"))
        addFolder(workspace:FindFirstChild("MOB"))
        addFolder(workspace:FindFirstChild("Mobs"))
        addFolder(workspace:FindFirstChild("Alive"))
        addFolder(workspace:FindFirstChild("Enemies"))

        for _, f in ipairs(foldersToSearch) do
            if f then 
                for _, m in ipairs(f:GetDescendants()) do
                    if m:IsA("Model") and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then
                        local mBase = string.lower(string.match(string.match(m.Name, "^(.-)%s*%[") or m.Name, "^%s*(.-)%s*$"))
                        if mBase == baseSearchName then 
                            local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Head") or m:FindFirstChildWhichIsA("BasePart", true)
                            if r then return m, r end 
                        end
                    end
                end 
            end
        end
        return nil, nil
    end

    local function FindNPC(npcName)
        local targetName = string.lower(npcName)
        local folders = {
            workspace:FindFirstChild("AllNPC"), 
            workspace:FindFirstChild("NPC"), 
            workspace:FindFirstChild("NPCs"),
            game:GetService("ReplicatedStorage"):FindFirstChild("NPC")
        }
        for _, folder in ipairs(folders) do
            if folder then 
                for _, obj in ipairs(folder:GetDescendants()) do 
                    if obj:IsA("Model") and string.find(string.lower(obj.Name), targetName, 1, true) then 
                        local part = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                        if part then return obj, part end 
                    end 
                end 
            end
        end
        return nil, nil
    end

