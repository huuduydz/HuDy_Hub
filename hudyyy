local function ResolveSelectedWeaponTypes(customWeaponType)
        local source = customWeaponType
        if source == nil then source = _G.tool end
        if source == nil then source = HuDy.Flags.SelectedWeapons end

        local selected = {}
        local seen = {}
        local function add(value)
            local lower = string.lower(tostring(value or ""))
            if lower == "all" or lower == "alltool" or lower == "all tools" then
                add("Melee"); add("Sword"); add("Fruit")
                return
            end
            if lower:find("melee", 1, true) or lower:find("combat", 1, true) then
                if not seen.Melee then seen.Melee = true; table.insert(selected, "Melee") end
            end
            if lower:find("sword", 1, true) then
                if not seen.Sword then seen.Sword = true; table.insert(selected, "Sword") end
            end
            if lower:find("fruit", 1, true) or lower:find("devil", 1, true) then
                if not seen.Fruit then seen.Fruit = true; table.insert(selected, "Fruit") end
            end
        end

        if type(source) == "table" then
            for key, value in pairs(source) do
                if type(key) == "number" then
                    add(value)
                elseif value == true then
                    add(key)
                elseif type(value) == "string" then
                    add(value)
                end
            end
        else
            add(source)
        end

        if #selected == 0 then
            selected = {"Melee", "Sword", "Fruit"}
        end
        HuDy.Flags.SelectedWeapons = selected
        HuDy.Flags.SelectedWeaponsList = selected
        return selected
    end

local function GetWeapon(customWeaponType)
        if not HuDy.IsCharacterReady() then
            return {}, nil
        end
        local selectedTable = ResolveSelectedWeaponTypes(customWeaponType)

        local char = LocalPlayer.Character
        if not char then return {}, nil end
        local humanoid = char:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return {}, nil end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        
        local allTools = {}
        for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then table.insert(allTools, t) end end
        if backpack then
            for _, t in ipairs(backpack:GetChildren()) do if t:IsA("Tool") then table.insert(allTools, t) end end
        end
        
        local function MatchesType(tool, expectedType)
            if not tool or not tool:IsA("Tool") then return false end
            local tt = string.lower(tool.ToolTip or "")
            local name = string.lower(tool.Name or "")
            expectedType = string.lower(expectedType)
            
            if expectedType == "melee" then
                return tt:find("melee") or tt:find("combat") or name:find("combat") or name:find("leg") or name:find("water") or name:find("dragon") or name:find("electro") or name:find("cyborg") or name:find("claw")
            elseif expectedType == "sword" then
                return tt:find("sword") or name:find("sword") or name:find("blade") or name:find("katana") or name:find("scythe") or name:find("saber") or name:find("cutlass") or name:find("bisento") or name:find("spear")
            elseif expectedType == "fruit" then
                return tt:find("fruit") or tt:find("demon") or tt:find("devil") or name:find("fruit") or name:find("df")
            end
            return false
        end
        
        -- 1. Tập hợp TẤT CẢ vũ khí khớp với các mục được chọn để spam skill qua remote
        local matchedTools = {}
        local seenTool = {}
        for _, tool in ipairs(allTools) do
            for _, sel in ipairs(selectedTable) do
                if MatchesType(tool, sel) and not seenTool[tool] then
                    seenTool[tool] = true
                    table.insert(matchedTools, tool)
                    break
                end
            end
        end

        -- 2. Phân tích loại vũ khí ĐƯỢC PHÉP EQUIP TRÊN TAY:
        -- - Nếu chọn hết (Sword + Melee + Fruit) -> CHỈ DÙNG SWORD
        -- - Nếu chọn Fruit và Melee               -> CHỈ DÙNG MELEE
        -- - Nếu chọn Sword và Fruit               -> CHỈ DÙNG SWORD
        -- - Nếu chọn Sword và Melee               -> ƯU TIÊN SWORD
        -- - Nếu chỉ chọn 1 loại                    -> Dùng đúng loại đó
        local hasSword = false
        local hasMelee = false
        local hasFruit = false

        for _, sel in ipairs(selectedTable) do
            local s = string.lower(tostring(sel))
            if s:find("sword") then
                hasSword = true
            elseif s:find("melee") or s:find("combat") then
                hasMelee = true
            elseif s:find("fruit") then
                hasFruit = true
            end
        end

        local equipPriority = {}
        if hasSword and hasMelee and hasFruit then
            equipPriority = {"sword", "melee", "fruit"}
        elseif hasFruit and hasMelee and not hasSword then
            equipPriority = {"melee", "fruit"}
        elseif hasSword and hasFruit and not hasMelee then
            equipPriority = {"sword", "fruit"}
        elseif hasSword and hasMelee then
            equipPriority = {"sword", "melee"}
        elseif hasSword then
            equipPriority = {"sword"}
        elseif hasMelee then
            equipPriority = {"melee"}
        elseif hasFruit then
            equipPriority = {"fruit"}
        else
            equipPriority = {"melee", "sword", "fruit"}
        end

        local currentTool = char:FindFirstChildOfClass("Tool")
        local chosenEquipTool = nil

        -- Nếu nhân vật đang cầm sẵn Bisento (đặc biệt khi đang farm log / chop tree),
        -- thì GIỮ NGUYÊN Bisento trên tay, KHÔNG đổi sang vũ khí khác!
        if currentTool then
            local cName = string.lower(currentTool.Name or "")
            if cName:find("bisento", 1, true) or cName:find("spear", 1, true) then
                chosenEquipTool = currentTool
            end
        end

        -- Tìm 1 tool duy nhất để cầm trên tay theo thứ tự ưu tiên
        if not chosenEquipTool then
            for _, pType in ipairs(equipPriority) do
                if currentTool and MatchesType(currentTool, pType) then
                    chosenEquipTool = currentTool
                    break
                end
                for _, tool in ipairs(matchedTools) do
                    if MatchesType(tool, pType) then
                        chosenEquipTool = tool
                        break
                    end
                end
                if chosenEquipTool then break end
            end
        end

        if not chosenEquipTool then
            chosenEquipTool = matchedTools[1] or currentTool or (backpack and backpack:FindFirstChildOfClass("Tool"))
        end

        if #matchedTools == 0 and chosenEquipTool then
            matchedTools = {chosenEquipTool}
        end

        return matchedTools, chosenEquipTool
    end

    -- 6. Attack Engine (Từ main.lua dòng 401)
    local function Attack(mobRoot, customWeaponType)
        if not HuDy.IsCharacterReady() then return end
        _G.HuDy_Target = mobRoot
        local tools, equipTool = GetWeapon(customWeaponType)
        if tools and #tools > 0 then
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChild("Humanoid")

            -- CHỈ EQUIP DUY NHẤT 1 VŨ KHÍ ƯU TIÊN TRÊN TAY (KHÔNG ĐỔI TOOL LIÊN TỤC):
            if equipTool and equipTool:IsA("Tool") and equipTool.Parent and humanoid and humanoid.Health > 0 then
                if equipTool.Parent ~= char then
                    humanoid:EquipTool(equipTool)
                end
                pcall(function() equipTool:Activate() end)
            end

            if mobRoot then
                pcall(function()
                    local chest = ReplicatedStorage:FindFirstChild("Chest")
                    local skillAction = chest and chest:FindFirstChild("Remotes") and chest.Remotes:FindFirstChild("Functions") and chest.Remotes.Functions:FindFirstChild("SkillAction")
                    if not skillAction then return end

                    -- GIỮ NGUYÊN 100% LOGIC SPAM SKILL BẰNG REMOTE CHO TẤT CẢ VŨ KHÍ ĐƯỢC CHỌN:
                    for _, tool in ipairs(tools) do
                        local toolToolTip = string.lower(tool.ToolTip or "")
                        local toolNameLower = string.lower(tool.Name or "")
                        local prefix = "FS"
                        if toolToolTip:find("sword") or toolNameLower:find("sword") or toolNameLower:find("blade") or toolNameLower:find("scythe") or toolNameLower:find("bisento") or toolNameLower:find("spear") or toolNameLower:find("katana") or toolNameLower:find("saber") or toolNameLower:find("cutlass") then
                            prefix = "SW"
                        elseif toolToolTip:find("fruit") or toolNameLower:find("fruit") or toolNameLower:find("df") then
                            prefix = "DF"
                        end
                        
                        local targetCF = mobRoot and mobRoot.CFrame
                        local function sendSkill(toolName, pfx, skill, isDown)
                            if not targetCF then return end
                            task.spawn(function()
                                local actionType = (skill == "M1") and "Click" or (isDown and "Down" or "Up")
                                pcall(function()
                                    skillAction:InvokeServer(pfx .. "_" .. toolName .. "_" .. skill, {
                                        MouseHit = targetCF,
                                        Type = actionType
                                    })
                                end)
                            end)
                        end
                        
                        -- Buff tốc độ M1: Spam gửi gói tin Click x2 lần mà không bị kẹt Ping
                        for i = 1, 2 do
                            sendSkill(tool.Name, prefix, "M1", true)
                            sendSkill(tool.Name, "FS", "M1", true)
                        end
                        
                        -- Spam Skill diện rộng
                        local allSkills = _G.skill or {"Z", "X", "C", "V", "E", "B"}
                        for _, skill in ipairs(allSkills) do
                            if skill ~= "M1" then
                                sendSkill(tool.Name, prefix, skill, true)
                                task.delay(0.1, function()
                                    sendSkill(tool.Name, prefix, skill, false)
                                end)
                            end
                        end
                    end
                end)
            end
        end
    end

