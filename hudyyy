-- VÒNG LẶP CẬP NHẬT UI STATUS & THỐNG KÊ TIẾN TRÌNH (TỰ ĐỘNG THEO SEA)
-- =============================================================================
task.spawn(function()
    local lastStatusText = nil
    local lastMaterialsText = nil
    local lastBadgeText = nil
    local lastProgressLevel = -1

    while task.wait(1) do
        pcall(function()
            local level = HuDy.GetCurrentLevel()
            local seaName = GetCurrentSeaName()
            local statsFolder = LocalPlayer:FindFirstChild("PlayerStats")
            local pointsObj = statsFolder and (statsFolder:FindFirstChild("Point") or statsFolder:FindFirstChild("Points") or statsFolder:FindFirstChild("point"))
            local availablePoints = pointsObj and tonumber(pointsObj.Value) or 0

            -- 1. Badge Sea hiển thị ở góc Header
            local badgeText = isSea3 and "SEA 3" or (isSea2 and "SEA 2" or "SEA 1")
            if StatusSeaBadge and badgeText ~= lastBadgeText then
                lastBadgeText = badgeText
                StatusSeaBadge.Text = badgeText
                StatusSeaBadge.TextColor3 = isSea3 and Color3.fromRGB(192, 132, 252)
                    or (isSea2 and Color3.fromRGB(56, 189, 248) or Color3.fromRGB(52, 211, 153))
            end

            -- 2. Cập nhật thanh tiến trình Level
            if level ~= lastProgressLevel then
                lastProgressLevel = level
                local stageMin, stageMax = 1, 2250
                if isSea2 then stageMin, stageMax = 2250, 4000 end
                if isSea3 then stageMin, stageMax = 4000, 5450 end
                local progress = level > 0 and math.clamp((level - stageMin) / math.max(stageMax - stageMin, 1), 0, 1) or 0
                if LevelProgressFill then
                    LevelProgressFill.Size = UDim2.new(progress, 0, 1, 0)
                    LevelProgressFill.BackgroundColor3 = isSea3 and Color3.fromRGB(192, 132, 252)
                        or (isSea2 and Color3.fromRGB(56, 189, 248) or Color3.fromRGB(52, 211, 153))
                end
                if LevelProgressText then
                    if level >= stageMax then
                        LevelProgressText.Text = string.format("LEVEL PROGRESS: Lv %d / %d  [MAX LEVEL]", level, stageMax)
                    elseif level > 0 then
                        LevelProgressText.Text = string.format("LEVEL PROGRESS: Lv %d / %d  [%d%%]", level, stageMax, math.floor(progress * 100))
                    else
                        LevelProgressText.Text = "LEVEL PROGRESS: Lv -- / " .. tostring(stageMax) .. "  [SYNC]"
                    end
                end
            end

            -- 3. Cập nhật Status Box (Không dùng icon, text sắc nét phân cấp rõ ràng)
            local cleanStatus = StripGuiIcons(CurrentStatusText)
            if not cleanStatus or cleanStatus == "" then
                cleanStatus = "Sẵn sàng (Idle)"
            end
            local nextStatusText = string.format(
                "<font color='#38bdf8'><b>LOCATION:</b></font> %s | %s\n" ..
                "<font color='#38bdf8'><b>LEVEL:</b></font> %s\n" ..
                "<font color='#cbd5e1'><b>ACTION:</b></font> %s",
                seaName,
                string.sub(tostring(game.JobId), 1, 8),
                level > 0 and tostring(level) or "Đang đồng bộ",
                cleanStatus
            )
            if WhiteScreenStatusLabel then
                if nextStatusText ~= lastStatusText then
                    lastStatusText = nextStatusText
                    WhiteScreenStatusLabel.Text = nextStatusText
                end
            end

            -- 4. Cập nhật Materials Box:
            -- Nếu ở SEA 3 -> Hiển thị danh sách nguyên liệu Boss Sea 3 (Dragon Fang, Serpent Fin, Kraken's Ink, Crab Meat, Severed Kraken, Dragon Scale, Phoenix's Tear)
            -- Nếu ở SEA 1 hoặc SEA 2 -> Hiển thị nguyên liệu chế tạo Heart of Sea
            local nextMaterialsText = ""
            if isSea3 then
                local dFang   = HuDy.GetMaterialCount("Dragon Fang")
                local sFin    = HuDy.GetMaterialCount("Serpent Fin")
