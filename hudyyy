        -- Fingerprint thiết bị (Không kèm PlaceId để giữ nguyên phiên khi chuyển Sea 1 -> Sea 2 -> Sea 3)
        local function getFp()
            local executor = (identifyexecutor and identifyexecutor()) or "unknown"
            local hwid = (gethwid and gethwid()) or "nohwid"
            return tostring(executor) .. "|" .. tostring(hwid)
        end

        local fingerprint = getFp()

        local function validSession(session)
            if type(session) ~= "table" then return false end
            if session.name and session.name ~= LP.Name then return false end
            if type(session.token) ~= "string" or session.token == "" then return false end
            local exp = tonumber(session.expireAt or session.expiresAt or 0)
            return exp > nowMs()
        end

        local function decode(value)
            if type(value) ~= "string" or value == "" then return nil end
            local ok, result = pcall(function() return HttpService:JSONDecode(value) end)
            return ok and type(result) == "table" and result or nil
        end

        local function loadSession()
            -- 1. Kiểm tra RAM / Bộ nhớ tiến trình
            if validSession(HUDY_SESSION_MEM) then return HUDY_SESSION_MEM end
            if _G.HUDY_AUTH == true and validSession(_G.HUDY_SESSION) then return _G.HUDY_SESSION end

            local genv = (type(getgenv) == "function" and getgenv()) or {}
            local sess = genv.HUDY_SESSION or _G.HUDY_SESSION
            if validSession(sess) then return sess end

            -- 2. Kiểm tra TeleportSetting (Hỗ trợ HUDY_SESSION_JSON, HUDY_SESSION, HUDY_HUB_SESSION)
            local tKeys = {"HUDY_SESSION_JSON", "HUDY_HUB_SESSION", "HUDY_SESSION"}
            for _, tKey in ipairs(tKeys) do
                local ok, raw = pcall(function() return TeleportService:GetTeleportSetting(tKey) end)
                if ok and raw then
                    local s = (type(raw) == "table" and raw) or decode(raw)
                    if validSession(s) then return s end
                end
            end

            -- 3. Kiểm tra File Cache trên máy
            if isfile and readfile then
                local fileList = {KEY_CACHE_V1, KEY_CACHE_USER, KEY_CACHE_AUTH}
                for _, fPath in ipairs(fileList) do
                    if isfile(fPath) then
                        local fOk, fileRaw = pcall(readfile, fPath)
                        local s = fOk and decode(fileRaw) or nil
                        if validSession(s) then return s end
                    end
                end
            end

            return nil
        end

        local function saveSession(session)
            HUDY_SESSION_MEM = session
            _G.HUDY_SESSION = session
            _G.HUDY_AUTH = true

            local genv = (type(getgenv) == "function" and getgenv()) or {}
            pcall(function() genv.HUDY_SESSION = session end)

            pcall(function()
                local encoded = HttpService:JSONEncode(session)
                -- Đồng bộ toàn bộ các khóa TeleportSetting để auto hop Sea không bao giờ bị mất phiên
                TeleportService:SetTeleportSetting("HUDY_SESSION_JSON", encoded)
                TeleportService:SetTeleportSetting("HUDY_SESSION", session)
                TeleportService:SetTeleportSetting("HUDY_HUB_SESSION", encoded)

                if writefile and makefolder then
                    if not isfolder("HuDy Hub") then makefolder("HuDy Hub") end
                    if not isfolder(KEY_CACHE_DIR) then makefolder(KEY_CACHE_DIR) end
                    writefile(KEY_CACHE_V1, encoded)
                    writefile(KEY_CACHE_USER, encoded)
                end
            end)
        end

        local session = loadSession()
        if session then
            saveSession(session)
            return true
        end

        -- Đọc Key do người dùng nhập (nếu có qua _G hoặc getgenv)
        local genv = (type(getgenv) == "function" and getgenv()) or {}
        local userKey = ""
        pcall(function()
            local raw = genv.HUDY_KEY or genv.Key or genv.key or _G.HUDY_KEY or _G.Key or _G.key
            if type(raw) == "string" then userKey = raw:gsub("%s+", "") end
        end)

        -- WebKey xác thực Roblox name + fingerprint và cấp token phiên
        local fpParam = fingerprint .. "|" .. tostring(game.PlaceId or 0)
        local baseUrls = {
            BASE_URL:gsub("/+$", ""),
            "https://webkey-hub-eta.vercel.app"
        }

        local function requestJson(url)
            local delaySec = 1
            for i = 1, 3 do
                local ok, res = pcall(function() return game:HttpGet(url) end)
                if ok and type(res) == "string" and res ~= "" then
                    local data = decode(res)
                    if data and type(data) == "table" then return data end
                end
                if i < 3 then
                    task.wait(delaySec)
                    delaySec = delaySec * 2
                end
            end
            return nil
        end

        local data = nil
        for _, domain in ipairs(baseUrls) do
            local url = domain .. "/api/execute?format=json&product=HuDyHub"
                .. "&name=" .. HttpService:UrlEncode(LP.Name)
                .. "&fp=" .. HttpService:UrlEncode(fpParam)
                .. (userKey ~= "" and ("&key=" .. HttpService:UrlEncode(userKey)) or "")

            data = requestJson(url)
            if data and data.ok == true then break end
        end

        if not data or data.ok ~= true then
            warn("[HuDy Hub Kaitun V1] Xác thực WebKey thất bại hoặc server không phản hồi.")
            _G.HUDY_KEY_ERROR = "auth_failed"
            return false
        end

        local token = type(data.token) == "string" and data.token or ""
        if token == "" then return false end

        -- TTL phiên mặc định (nếu Vercel không trả expireAt thì cấp 2 giờ)
        local expireAt = tonumber(data.expireAt or data.expiresAt)
        if not expireAt or expireAt <= nowMs() then
            local ttlMs = tonumber(data.expiresInMs) or (2 * 3600 * 1000)
            expireAt = nowMs() + ttlMs - 5000
        end

        saveSession({
            product = "HuDyHub",
            script = "KaitunV1",
            name = LP.Name,
            fp = fingerprint,
            token = token,
            expireAt = expireAt,
        })
        return true
    end

    local isAuthed = false
    local success, result = pcall(AuthenticateSession)
    if (success and result == true) or DEV_TEST_MODE or _G.HUDY_AUTH == true then
        isAuthed = true
        _G.HUDY_AUTH = true
    end

    _G.HUDY_RUNTIME_CHECK = function()
        return isAuthed or DEV_TEST_MODE or _G.HUDY_AUTH == true
    end

    if not isAuthed then
        pcall(function() LP:Kick("Kích hoạt thất bại! Vui lòng kiểm tra lại Key / Whitelist tại WebKey.") end)
        return
    end
end

