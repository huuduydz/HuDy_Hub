function HuDy.GetTargetData()
    local level = HuDy.GetCurrentLevel()
    if not level or level <= 0 then return nil end
    local activeTable = LevelDataSea1
    if isSea2 then activeTable = LevelDataSea2 end
    if isSea3 then activeTable = LevelDataSea3 end
    
    for _, data in ipairs(activeTable) do
        if level >= data.MinLv and level <= data.MaxLv then
            return data
        end
    end
    -- Chỉ dùng quest cuối khi thật sự vượt MaxLv. Nếu level bị thiếu/sai,
    -- tuyệt đối không ép chạy Ryu (Sea 2) như trước.
    local lastData = activeTable[#activeTable]
    if lastData and level > lastData.MaxLv then
        return lastData
    end
    return nil
end

