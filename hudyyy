local function autoClaimPassiveTree()
    -- Chỉ áp dụng tìm Passive Tree tại Sea 1 & Sea 2
    if not isSea1 and not isSea2 then return end

    -- Kiểm tra file đã hoàn thành Chance V trước đó chưa
    local PassiveFile = "HuDy Hub/" .. tostring(LP.Name) .. "/PassiveDone.txt"
    if isfile and isfile(PassiveFile) then
        local contentFile = nil
        pcall(function() contentFile = readfile(PassiveFile) end)
        if contentFile == "DONE" then
            print("[HuDy Hub]: Da co Passive / Chance V truoc do! Bo qua tim tree.")
            HuDy.HasClaimedPassiveTree = true
            HuDy.IsFindingTree = false
            return
        end
    end

    -- Chỉ đợi nhân vật spawn hoàn chỉnh khi chạy luồng Passive Tree (chuẩn V6)
    EnsurePlayerSpawned()
    
    print("[HuDy Hub]: Dang cho du lieu Passives tu Server...")
    task.wait(2)
    local maxWait = 10
    local waited = 0
    while waited < maxWait do
        local stats = LP:FindFirstChild("PlayerStats")
        if stats and stats:FindFirstChild("Passives") then
            local val = tostring(stats.Passives.Value)
            if val ~= "" and val ~= "nil" and val ~= "{}" and val ~= "[]" then
                break
            end
        end
        task.wait(1)
        waited = waited + 1
    end
    
    -- Nếu đã mở Passive Tree rồi -> Bỏ qua ngay lập tức để chạy tiếp các luồng chính (farm lv, etc.)
    if checkAlreadyClaimedTree() then
        print("[HuDy Hub]: Passive Tree da duoc mo san! Tiep tuc cac luong chinh...")
        HuDy.HasClaimedPassiveTree = true
        HuDy.IsFindingTree = false
        return
    end

    -- Nếu CHƯA có Passive -> Chặn toàn bộ luồng khác (Blocking mode), ưu tiên tìm Tree / Hop Server trước!
    print("[HuDy Hub]: CHUA CO PASSIVE! Uu tien tim Passive Tree truoc (BLOCKING)...")
    HuDy.IsFindingTree = true
    CurrentStatusText = "<b>Status:</b> [Passive Tree] Chưa có Passive! Đang tìm Passive Tree..."
    
    while not checkAlreadyClaimedTree() do
        local treeModel = nil
        local prompt = nil
        
        -- Quét Workspace tìm Passive Tree (quét trong 5s để đảm bảo tài nguyên server stream về đầy đủ)
        for scan = 1, 5 do
            CurrentStatusText = string.format("<b>Status:</b> [Passive Tree] Đang quét tìm cây (giây %d/5)...", scan)
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    local name = string.lower(obj.Name)
                    if string.find(name, "passive tree", 1, true) or string.find(name, "passivetree", 1, true) or name == "passivetreemodel" then
                        treeModel = obj
                        break
                    end
                end
                if not treeModel and workspace:FindFirstChild("AllNPC") then
                    treeModel = workspace.AllNPC:FindFirstChild("PassiveTree")
                end
                if treeModel then
                    for _, v in ipairs(treeModel:GetDescendants()) do
                        if v:IsA("ProximityPrompt") then prompt = v; break end
                    end
                end
            end)
            if treeModel or prompt then break end
            task.wait(1)
        end

        if treeModel or prompt then
            print("[HuDy Hub]: Tim thay Passive Tree tai Server nay! Dang di chuyen toi de Claim...")
            CurrentStatusText = "<b>Status:</b> [Passive Tree] Tìm thấy Cây! Đang tới nhận Blessing..."
            local char = LP.Character or LP.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart", 10)
            if hrp then
                local targetPart = (prompt and prompt.Parent) or (treeModel:IsA("Model") and treeModel.PrimaryPart) or (treeModel:IsA("BasePart") and treeModel)
                if not targetPart and treeModel and treeModel:IsA("Model") then
                    targetPart = treeModel:FindFirstChild("HumanoidRootPart") or treeModel:FindFirstChildWhichIsA("BasePart")
                end
                if targetPart and (hrp.Position - targetPart.Position).Magnitude > 10 then
                    hrp.CFrame = targetPart.CFrame * CFrame.new(0, 0, 3)
                    task.wait(0.3)
                    hrp.CFrame = targetPart.CFrame * CFrame.new(0, 0, 3)
                    task.wait(0.5)
                end
            end
            
            if prompt then
                if typeof(fireproximityprompt) == "function" then
                    pcall(function() fireproximityprompt(prompt) end)
                else
                    pcall(function() prompt:InputHoldBegin(); task.wait(prompt.HoldDuration + 0.1); prompt:InputHoldEnd() end)
                end
                task.wait(1)
            end
            
            pcall(function()
                local etcFunc = game:GetService("ReplicatedStorage"):WaitForChild("Chest", 3)
                if etcFunc then etcFunc = etcFunc:WaitForChild("Remotes", 3) end
                if etcFunc then etcFunc = etcFunc:WaitForChild("Functions", 3) end
                if etcFunc then etcFunc = etcFunc:WaitForChild("EtcFunction", 3) end
                if etcFunc then etcFunc = etcFunc:InvokeServer("Blessing Passive", {}) end
            end)
            
            print("[HuDy Hub]: Da ban Remote Claim, dang Reset nhan vat de nhan Passive...")
            CurrentStatusText = "<b>Status:</b> [Passive Tree] Đã nhận Blessing! Đang Reset nhân vật..."
            task.wait(7)
            if LP.Character and LP.Character:FindFirstChild("Humanoid") then
                LP.Character.Humanoid.Health = 0
            end
            
            print("[HuDy Hub]: Dang cho nhan vat hoi sinh...")
            CurrentStatusText = "<b>Status:</b> [Passive Tree] Đang chờ nhân vật hồi sinh..."
            while not (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character:FindFirstChild("Humanoid") and LP.Character.Humanoid.Health > 0) do
                task.wait(0.5)
            end
            task.wait(2)
            
            -- Roll 1 cuốn sách đầu tiên nếu có để kích hoạt passives
            local book = GetAvailableEnchantBook()
            if book then
                local enchantRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Chest") 
                    and game:GetService("ReplicatedStorage").Chest:FindFirstChild("Remotes") 
                    and game:GetService("ReplicatedStorage").Chest.Remotes:FindFirstChild("Functions") 
                    and game:GetService("ReplicatedStorage").Chest.Remotes.Functions:FindFirstChild("Enchant")
                if enchantRemote then
                    pcall(function() enchantRemote:InvokeServer(book) end)
                    print("[HuDy Hub]: Da Roll 1 cuon sach [" .. tostring(book) .. "] de khoi tao Passives!")
                end
            end
            task.wait(2)
            
            if checkAlreadyClaimedTree() then
                print("[HuDy Hub]: UNLOCK PASSIVE TREE THANH CONG!")
                CurrentStatusText = "<b>Status:</b> [Passive Tree] UNLOCK PASSIVE TREE THÀNH CÔNG!"
                HuDy.HasClaimedPassiveTree = true
                HuDy.IsFindingTree = false
                break
            end
        else
            print("[HuDy Hub]: Server nay KHONG co Passive Tree! Dang Hop Server...")
            CurrentStatusText = "<b>Status:</b> [Passive Tree] Không có Cây, đang hop server..."
            HuDy.IsFindingTree = true
            task.wait(1)
            if type(HuDy.ServerHop) == "function" then
                HuDy.ServerHop()
            elseif type(_G.FinalHop) == "function" then
                _G.FinalHop()
            else
                hopUsingGetServerLists()
            end
            task.wait(5)
        end
        task.wait(1.5)
    end
    HuDy.IsFindingTree = false
end
HuDy.AutoClaimPassiveTree = autoClaimPassiveTree

