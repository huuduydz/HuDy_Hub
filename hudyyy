-- =========================================================================
-- QUAN TRỌNG: Hai listener này KHÔNG được thêm vào TaskCleaner.
-- Lý do: CleanAll() được gọi ngay sau khi bắn lệnh teleport. Nếu teleport
-- thất bại (game bị treo/hang), các listener này đã bị disconnect nên không
-- thể phát hiện lỗi và trigger recovery. Chúng phải tồn tại độc lập.
-- Dùng biến riêng để có thể cleanup thủ công khi thực sự cần.
local _teleportFailConn = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage, targetPlaceId, teleportOptions)
    if player == lplr or player == LP then
        warn(string.format("[ServerHop Turbo] ❌ TeleportInitFailed: Result=%s, Msg=%s", tostring(teleportResult), tostring(errorMessage)))
        ServerHop:HandleTeleportFailure("TeleportInitFailed: " .. tostring(teleportResult))
    end
end)

local _guiErrorConn = GuiService.ErrorMessageChanged:Connect(function(errMsg)
    if not errMsg or errMsg == "" then return end
    local lower = string.lower(errMsg)
    
    local errorCode = 0
    pcall(function() errorCode = GuiService:GetErrorCode().Value end)
    local DisconnectErrors = (Enum.ConnectionError and Enum.ConnectionError.DisconnectErrors and Enum.ConnectionError.DisconnectErrors.Value) or 256
    local PlaceLaunchOtherError = (Enum.ConnectionError and Enum.ConnectionError.PlacelaunchOtherError and Enum.ConnectionError.PlacelaunchOtherError.Value) or 768

    -- Kiểm tra nếu là lỗi Shut Down hoặc Disconnect (mất kết nối, kick, bảo trì, server shutdown)
    -- -> TUYỆT ĐỐI KHÔNG XÓA BẢNG LỖI để Tool Rejoin ngoài nhận diện và tự động restart / rejoin!
    local isShutdownOrDisconnect = string.find(lower, "shut down") 
        or string.find(lower, "shutdown") 
        or string.find(lower, "disconnect") 
        or string.find(lower, "kicked") 
        or string.find(lower, "same account") 
        or string.find(lower, "lost connection")
        or string.find(lower, "unexpected client")
        or (errorCode == 1 or (errorCode >= DisconnectErrors and errorCode < PlaceLaunchOtherError))
    
    if isShutdownOrDisconnect then
        warn(string.format("[ServerHop] ⚠️ Phát hiện lỗi Shutdown/Disconnect: '%s' (Code=%s) -> Giữ nguyên bảng lỗi để Tool Rejoin xử lý!", tostring(errMsg), tostring(errorCode)))
        ServerHop.IsHopping = false
        return
    end

    -- CHỈ xóa bảng lỗi khi đúng là Lỗi Teleport thông thường (teleport failed, full server, restricted, 773, 769, 772...)
    local isTeleportError = string.find(lower, "teleport") 
        or string.find(lower, "full") 
        or string.find(lower, "restricted")
        or (errorCode == 773 or errorCode == 769 or errorCode == 772 or errorCode >= PlaceLaunchOtherError)

    if isTeleportError then
        ServerHop:HandleTeleportFailure("GuiService Error: " .. tostring(errMsg))
    end
end)

_G._SuperActiveClick = function(btn)
