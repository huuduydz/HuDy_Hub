function HuDy.FishSerpentWhirlpool(wp)
    if not wp then return false end
    
    local wpPos = nil
    if wp:IsA("BasePart") then
        wpPos = wp.Position
    elseif wp:IsA("Model") then
        wpPos = wp.PrimaryPart and wp.PrimaryPart.Position or wp:GetPivot().Position
    else
        local bp = wp:FindFirstChildWhichIsA("BasePart")
        if bp then wpPos = bp.Position end
    end
    if not wpPos then return false end

    -- Vị trí đứng câu: cách tâm xoáy khoảng 20 studs, cao hơn mặt nước 14 studs
    local standPos = wpPos + Vector3.new(20, 5, 20)
    local aimLookCFrame = CFrame.lookAt(standPos, Vector3.new(wpPos.X, standPos.Y, wpPos.Z))
    
    local root = GetRootPart()
    local char = LocalPlayer.Character
    if not root or not char then return false end

    -- 1. Đang trên đường bay tới xoáy nước (khoảng cách > 6 studs):
    if (root.Position - standPos).Magnitude > 6 then
        -- TUYỆT ĐỐI CHƯA LÔI CẦN CÂU RA KHI ĐANG BAY ĐẾN XOÁY ĐỂ TRÁNH LỖI VŨ KHÍ
        HuDy.AutoFishSerpentActive = false
        HuDy.TP(aimLookCFrame)
        CurrentStatusText = "<b>Status:</b> [Sea 3] 🌀 Đang di chuyển đến Xoáy nước Serpent..."
        return true
    end

    -- 2. ĐÃ TỚI NƠI AN TOÀN TẠI XOÁY NƯỚC (khoảng cách <= 6 studs):
    HuDy.StopTP()
    root.CFrame = aimLookCFrame

    -- Tạo bệ đứng siêu rộng (35x2x35) ngay dưới chân để không bao giờ bị té
    local platformPos = Vector3.new(standPos.X, standPos.Y - 3.2, standPos.Z)
    HuDy.EnsureFishingPlatform(platformPos)

    -- Khóa vị trí nhân vật bằng BodyVelocity MaxForce để không bị sóng biển làm trượt té
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local bv = hrp:FindFirstChild("HuDyFishStandBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "HuDyFishStandBV"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = hrp
        end
    end

    HuDy.AutoFishSerpentActive = true

