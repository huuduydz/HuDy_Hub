                    if writefile then
                        if not isfolder("HuDy Hub") then makefolder("HuDy Hub") end
                        if not isfolder("HuDy Hub/" .. tostring(LP.Name)) then makefolder("HuDy Hub/" .. tostring(LP.Name)) end
                        writefile(bisentoFile, "OWNED")
                    end
                end)
