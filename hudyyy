-- LOG & TREE FARMING SYSTEM (High-Performance Zero-Lag Tree Cache & Anti-Stuck)
-- ==============================================================================
HuDy.CurrentTree = nil
HuDy.CurrentTreeRoot = nil
HuDy.CurrentTreeStartTime = 0
HuDy.BlacklistedTrees = {}
HuDy.CachedValidTrees = {}
HuDy.LastTreeCacheTime = 0
HuDy.LastBlacklistCleanTime = 0

local INVALID_TREE_KEYWORDS = {
    "house", "building", "home", "roof", "wall", "floor", "door", "fence", "dock",
    "bridge", "shop", "ship", "boat", "pillar", "table", "chair", "furniture", "pot",
    "ladder", "stair", "gate", "prop", "room", "tower", "pagoda", "castle", "temple",
    "lamp", "lantern", "bench", "barrel", "crate", "chest", "sign", "light", "stage",
    "statue", "well", "cart", "wagon", "pavilion", "chimney", "window", "shed", "hut",
    "inn", "tavern", "dojo", "barrier", "frame", "railing", "balcony", "deck", "plank",
    "fake", "faketree", "fake_tree", "dummy", "deco", "decoration",
    "primeval", "small garden", "smallgarden", "crownfall", "battle island", "battleisland",
    "bubble tree", "bubble_tree"
}

local function isBlacklistedTreeArea(inst)
    if not inst then return false end
    local cur = inst
    local depth = 0
    while cur and cur ~= workspace and depth < 8 do
        depth = depth + 1
        local n = cur.Name:lower()
        if n:find("primeval", 1, true) 
           or n:find("small garden", 1, true) 
           or n:find("smallgarden", 1, true) 
           or n:find("crownfall", 1, true)
           or n:find("battle island", 1, true)
           or n:find("battleisland", 1, true)
           or n:find("bubble tree", 1, true) 
           or n:find("bubble_tree", 1, true) then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function isBuildingOrProp(inst)
    if not inst then return false end
    if isBlacklistedTreeArea(inst) then return true end
    
    local cur = inst
    local depth = 0
    while cur and cur ~= workspace and depth < 8 do
        depth = depth + 1
        local nameLower = cur.Name:lower()
        for _, kw in ipairs(INVALID_TREE_KEYWORDS) do
            if nameLower:find(kw, 1, true) then
                return true
            end
        end
        cur = cur.Parent
    end
    return false
end

local function getTreeRootPart(treeInst, allowTransparent)
    if not treeInst then return nil end
    if isBlacklistedTreeArea(treeInst) then return nil end
    local tName = treeInst.Name:lower()
    if tName:find("fake", 1, true) then return nil end
    if isBuildingOrProp(treeInst) then return nil end
    local root = nil
    if treeInst:IsA("Model") then
        root = treeInst:FindFirstChild("Wood") 
            or treeInst:FindFirstChild("Trunk") 
            or treeInst:FindFirstChild("Stem")
            or treeInst:FindFirstChild("Log")
            or treeInst:FindFirstChild("HumanoidRootPart") 
            or treeInst.PrimaryPart
        if not root then
            for _, child in ipairs(treeInst:GetChildren()) do
                if child:IsA("BasePart") then
                    local cName = child.Name:lower()
                    if not cName:find("leave", 1, true) and not cName:find("foliage", 1, true) and not cName:find("branch", 1, true) then
                        root = child
                        break
                    end
                end
            end
        end
    elseif treeInst:IsA("BasePart") then
        root = treeInst
    end
    
    if not root or not root:IsA("BasePart") then return nil end
    if isBlacklistedTreeArea(root) then return nil end
    
    -- Loại bỏ lá / cành / nền sàn nếu bị nhận nhầm
    local rName = root.Name:lower()
    if rName:find("leave", 1, true) or rName:find("foliage", 1, true) or rName:find("branch", 1, true)
       or rName:find("ground", 1, true) or rName:find("floor", 1, true) or rName:find("terrain", 1, true) then
        return nil
    end
    
    -- Kiểm tra kích thước: Tránh sàn/tường nhà gỗ to bất thường
    if root.Size.X > 30 or root.Size.Z > 30 or root.Size.Y > 100 then
        return nil
    end
    
    -- Kiểm tra độ trong suốt (Cây còn tồn tại) - Bỏ qua khi tạo Tree Cache
    if not allowTransparent and root.Transparency >= 1 then
        return nil
    end
    
    -- Kiểm tra máu nếu là Model có Humanoid
    local hum = treeInst:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        return nil
    end
    
    return root
end

-- Tối ưu hóa: Xây dựng bộ nhớ đệm cây (Tree Cache) nhẹ nhàng, không duyệt GetDescendants toàn bản đồ
function HuDy.RebuildTreeCache()
    local newCache = {}
    local seen = {}

    local function addCandidate(item)
        if not item or seen[item] then return end
        seen[item] = true
        if isBlacklistedTreeArea(item) then return end
        if isBuildingOrProp(item) then return end
        local rootPart = getTreeRootPart(item, true)
        if not rootPart or seen[rootPart] then return end
        seen[rootPart] = true
        if isBlacklistedTreeArea(rootPart) then return end
        if isBuildingOrProp(rootPart) then return end

        local pos = rootPart.Position
        local posKey = string.format("%d_%d_%d", math.floor(pos.X / 8), math.floor(pos.Y / 8), math.floor(pos.Z / 8))
        table.insert(newCache, {
            Model = item,
            Root = rootPart,
            Position = pos,
            PosKey = posKey
        })
    end

    -- 1. Quét workspace.Trees hoặc workspace.Tree
    for _, fName in ipairs({"Trees", "Tree"}) do
        local f = workspace:FindFirstChild(fName)
        if f then
            for _, item in ipairs(f:GetChildren()) do
                addCandidate(item)
            end
        end
    end

    -- 2. Quét Sea 2 A - Japan Trees trực tiếp (nhanh, chuẩn xác)
    pcall(function()
        local sea2Trees = workspace:FindFirstChild("Island") 
            and workspace.Island:FindFirstChild("A - Japan") 
            and workspace.Island["A - Japan"]:FindFirstChild("A - Japan") 
            and workspace.Island["A - Japan"]["A - Japan"]:FindFirstChild("Base") 
            and workspace.Island["A - Japan"]["A - Japan"].Base:FindFirstChild("Trees")
        if sea2Trees then
            for _, item in ipairs(sea2Trees:GetChildren()) do
                addCandidate(item)
            end
        end
    end)

    -- 3. Quét các Folder / Model cây ở các đảo (duyệt cây thư mục tối đa 5 cấp, KHÔNG dùng GetDescendants toàn bộ map)
    local islandFolder = workspace:FindFirstChild("Island") or workspace:FindFirstChild("Islands")
    if islandFolder then
        local function scanContainer(parent, depth)
            if not parent or depth > 5 then return end
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("Folder") or child:IsA("Model") then
                    if not isBlacklistedTreeArea(child) then
                        local cName = child.Name:lower()
                        if cName == "trees" or cName == "tree" then
                            -- Nếu child chính là Model cây độc lập có Wood/Trunk
                            if child:IsA("Model") and (child:FindFirstChild("Wood") or child:FindFirstChild("Trunk") or child:FindFirstChild("Stem") or child:FindFirstChild("Log")) then
                                addCandidate(child)
                            else
                                for _, tree in ipairs(child:GetChildren()) do
                                    addCandidate(tree)
                                end
                            end
                        elseif cName:find("tree", 1, true) and not isBuildingOrProp(child) then
                            addCandidate(child)
                        else
                            scanContainer(child, depth + 1)
                        end
                    end
                end
            end
        end
        scanContainer(islandFolder, 1)
    end

    HuDy.CachedValidTrees = newCache
    HuDy.LastTreeCacheTime = tick()
end

function HuDy.ChopTree(playerHrp)
    local hrp = playerHrp or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
    local myPos = hrp and hrp.Position or Vector3.zero
    local now = tick()

    -- Log chỉ farm bằng Bisento. Nếu chưa cầm trên tay thì trang bị, đã cầm rồi thì không loop.
    if not HuDy.IsBisentoEquipped() then
        HuDy.EquipBisento()
    end
    
    -- 1. Dọn dẹp blacklist đã hết hạn (Throttled mỗi 2s để không lãng phí CPU)
    if (now - (HuDy.LastBlacklistCleanTime or 0)) > 2 then
        HuDy.LastBlacklistCleanTime = now
        for k, expireTime in pairs(HuDy.BlacklistedTrees) do
            if now >= expireTime or (typeof(k) == "Instance" and not k.Parent) then
                HuDy.BlacklistedTrees[k] = nil
            end
        end
    end
    
    -- 2. Kiểm tra cây hiện tại đang chặt (Target Lock)
    if HuDy.CurrentTree and HuDy.CurrentTree.Parent and HuDy.CurrentTreeRoot and HuDy.CurrentTreeRoot.Parent then
        local validRoot = HuDy.CurrentTreeRoot
        -- Kiểm tra nếu cây đã bị chặt đổ (Transparency >= 1) hoặc bị di dời
        if validRoot.Transparency >= 1 or isBlacklistedTreeArea(HuDy.CurrentTree) or isBuildingOrProp(HuDy.CurrentTree) then
            HuDy.CurrentTree = nil
            HuDy.CurrentTreeRoot = nil
            HuDy.CurrentTreeStartTime = 0
        else
            -- Cơ chế chống kẹt: Quá 10s chưa chặt xong cây -> Bỏ cây, blacklist 15s và nhảy cây khác
            if now - HuDy.CurrentTreeStartTime > 10 then
                local pos = validRoot.Position
                local posKey = string.format("%d_%d_%d", math.floor(pos.X / 8), math.floor(pos.Y / 8), math.floor(pos.Z / 8))
                HuDy.BlacklistedTrees[HuDy.CurrentTree] = now + 15
                HuDy.BlacklistedTrees[posKey] = now + 15
                HuDy.CurrentTree = nil
                HuDy.CurrentTreeRoot = nil
                HuDy.CurrentTreeStartTime = 0
            else
                -- Vẫn đang chặt cây hợp lệ -> Giữ target và tấn công (Zero Workspace Scan)
                local targetCF = validRoot.CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                HuDy.TP(targetCF, validRoot.Position)
                HuDy.Attack(validRoot, {"Sword"})
                return true
            end
        end
    else
        HuDy.CurrentTree = nil
        HuDy.CurrentTreeRoot = nil
        HuDy.CurrentTreeStartTime = 0
    end
    
    -- 3. Cần tìm cây mới: Đảm bảo cache cây đã được xây dựng
    if not HuDy.CachedValidTrees or #HuDy.CachedValidTrees == 0 or (now - (HuDy.LastTreeCacheTime or 0) > 30) then
        HuDy.RebuildTreeCache()
    end
    
    -- 4. Tìm cây gần nhất trong Cache (Siêu nhẹ: chỉ duyệt mảng vài chục cây, không quét Workspace)
    local bestTree = nil
    local bestRoot = nil
    local bestDist = math.huge
    
    for _, item in ipairs(HuDy.CachedValidTrees) do
        local treeModel = item.Model
        local rootPart = item.Root
        
        if treeModel and treeModel.Parent and rootPart and rootPart.Parent and rootPart.Transparency < 1 then
            local isBl = (HuDy.BlacklistedTrees[treeModel] and HuDy.BlacklistedTrees[treeModel] > now)
                      or (HuDy.BlacklistedTrees[item.PosKey] and HuDy.BlacklistedTrees[item.PosKey] > now)
                      or (HuDy.BlacklistedTrees[rootPart] and HuDy.BlacklistedTrees[rootPart] > now)
            
            if not isBl then
                local dist = (item.Position - myPos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestTree = treeModel
                    bestRoot = rootPart
                end
            end
        end
    end
    
    -- 5. Nếu tìm thấy cây hợp lệ -> Khoá mục tiêu và tấn công
    if bestTree and bestRoot then
        HuDy.CurrentTree = bestTree
        HuDy.CurrentTreeRoot = bestRoot
        HuDy.CurrentTreeStartTime = now
        
        local targetCF = bestRoot.CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        HuDy.TP(targetCF, bestRoot.Position)
        HuDy.Attack(bestRoot, {"Sword"})
        return true
    end
    
    -- Fail-safe: Nếu tất cả cây đều bị blacklist tạm thời nhưng có cây còn sống, reset blacklist để không bị đứng im kẹt
    if not bestTree and HuDy.CachedValidTrees and #HuDy.CachedValidTrees > 0 then
        local anyAlive = false
        for _, item in ipairs(HuDy.CachedValidTrees) do
            if item.Root and item.Root.Parent and item.Root.Transparency < 1 then
                anyAlive = true
                break
            end
        end
        if anyAlive then
            HuDy.BlacklistedTrees = {}
        end
    end
    
    return false
end

function HuDy.DoSea3Quest()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Guard trạng thái Sky Safe an toàn (không kéo nhân vật đi quái)
    if HuDy.SkySafeUntil and tick() < HuDy.SkySafeUntil then
        return
    end

    -- [AUTO DETECT] Nếu đã unlock thì chỉ thực hiện teleport, không chạy tiếp các
    -- bước material/summon trong cùng tick (return bên trong pcall không thoát hàm).
    local thirdSeaUnlocked = false
    pcall(function()
        local stats = LocalPlayer:FindFirstChild("PlayerStats")
        if stats then
            local progression = stats:FindFirstChild("ThirdSeaProgression")
            if progression and progression.Value == "Yes" then
                thirdSeaUnlocked = true
            end
        end
    end)
    if thirdSeaUnlocked then
        local now = tick()
        if not HuDy.LastThirdSeaTeleportAt or (now - HuDy.LastThirdSeaTeleportAt) >= 5 then
            HuDy.LastThirdSeaTeleportAt = now
            CurrentStatusText = "<b>Status:</b> Đã mở Third Sea, đang dịch chuyển..."
            pcall(function()
                local args = { "TeleportSea", { SeaName = "ThirdSea" } }
                ReplicatedStorage:WaitForChild("Chest", 5):WaitForChild("Remotes", 5):WaitForChild("Functions", 5):WaitForChild("EtcFunction", 5):InvokeServer(unpack(args))
            end)
        end
        return
    end

    local heart = HuDy.GetMaterialCount("Heart of Sea")
    
    local function getNPC(name)
        local rep = game:GetService("ReplicatedStorage")
        local folders = {
            rep:FindFirstChild("NPC"), 
            workspace:FindFirstChild("NPC"), 
            workspace:FindFirstChild("NPCs"), 
            workspace:FindFirstChild("AllNPC")
        }
        for _, f in ipairs(folders) do
            if f then
                local found = f:FindFirstChild(name)
                if found then return found end
            end
        end
        return nil
    end
    
    local function findSea3KrakenBoss()
        local searchFolders = {
            workspace:FindFirstChild("SeaMonster"),
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"),
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"),
            workspace:FindFirstChild("Monster"),
            workspace:FindFirstChild("MOB"),
            workspace:FindFirstChild("Mobs"),
            workspace
        }
        for _, folder in ipairs(searchFolders) do
            if folder then
                for _, m in ipairs(folder:GetChildren()) do
                    if m:IsA("Model") then
                        local nameLower = string.lower(m.Name)
                        if (nameLower:find("tentacle", 1, true) or nameLower:find("kraken", 1, true)) and not nameLower:find("chaos", 1, true) then
                            local hum = m:FindFirstChildOfClass("Humanoid") or m:FindFirstChild("Humanoid")
                            if not hum or hum.Health > 0 then
                                local rootPart = m:FindFirstChild("HumanoidRootPart")
                                    or m.PrimaryPart
                                    or m:FindFirstChild("Hitbox")
                                    or m:FindFirstChild("Body")
                                    or m:FindFirstChild("Torso")
                                    or m:FindFirstChildWhichIsA("BasePart")
                                if rootPart then
                                    return m, rootPart, hum
                                end
                            end
                        end
                    end
                end
            end
        end
        local m, r = HuDy.FindMob("Tentacle")
        if m and r then
            return m, r, m:FindFirstChildOfClass("Humanoid")
        end
        return nil, nil, nil
    end

    local boss, bossRoot, bossHumanoid = findSea3KrakenBoss()

    -- ƯU TIÊN SỐ 1: NẾU BOSS KRAKEN / TENTACLE CÒN TỒN TẠI -> TẤN CÔNG TỪ CỰ LY AN TOÀN!
    if boss and bossRoot then
        HuDy.Flags.TentacleEngaged = true
        HuDy.TentacleLostSince = nil -- Reset bộ đếm mất dấu boss khi boss còn sống

        if bossHumanoid and HuDy.TrackedTentacleHumanoid ~= bossHumanoid then
            HuDy.TrackedTentacleHumanoid = bossHumanoid
            if HuDy.TentacleDiedConnection then
                pcall(function() HuDy.TentacleDiedConnection:Disconnect() end)
            end
            HuDy.TentacleDiedConnection = bossHumanoid.Died:Connect(function()
                HuDy.Flags.KilledTentacle = true
                HuDy.Flags.WaitingTentacleSpawn = false
            end)
        end
        if bossHumanoid and bossHumanoid.Health <= 0 then
            HuDy.Flags.KilledTentacle = true
        end

        HuDy.CurrentFarmMob = boss
        CurrentStatusText = "<b>Status:</b> [Sea 3 Quest] Đang đánh Kraken Boss (Target khoảng cách an toàn 28 studs)..."

        -- =========================================================================
        -- GIẢI PHÁP CHỐNG LỖI / CHỐNG BUG CHO BOSS KRAKEN:
        -- 1. Target từ cự ly an toàn 28-32 studs (cao 26 studs, lùi chéo 12 studs).
        --    Tuyệt đối KHÔNG đứng sát 8 studs khiến hitbox va chạm làm boss bị fling/lún nước/desync.
        -- 2. Đảm bảo độ cao tối thiểu Y >= 36 studs: không bao giờ chạm mặt nước biển gây mất máu DF/stun.
        -- 3. CFrame.lookAt chéo xuống boss: loại bỏ Gimbal Lock, giữ nhân vật đứng yên ổn định.
        -- 4. Bật NoClip toàn thân: không thể tác dụng lực vật lý đẩy làm boss bị trôi hay rơi địa hình.
        -- =========================================================================
        local targetY = math.max(bossRoot.Position.Y + 26, 36)
        local safePos = Vector3.new(bossRoot.Position.X, targetY, bossRoot.Position.Z + 12)
        local standCF = CFrame.lookAt(safePos, bossRoot.Position)

        pcall(function()
            local char = LocalPlayer.Character
            if char then
                for _, p in ipairs(char:GetChildren()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false) end
            end
        end)

        HuDy.TP(standCF, bossRoot.Position)
        HuDy.Attack(bossRoot)
        return -- Dừng lại để tập trung diệt boss, KHÔNG kiểm tra nguyên liệu
    end

    -- Nếu đang trong trận chiến mà boss tạm thời biến mất (do animation lặn hoặc chuyển phase):
    if HuDy.Flags.TentacleEngaged and not boss then
        if not HuDy.TentacleLostSince then
            HuDy.TentacleLostSince = tick()
        end

        local timeLost = tick() - HuDy.TentacleLostSince
        -- Nếu chưa kích hoạt Died và mất dấu chưa đủ 6 giây -> Kiên nhẫn chờ boss ngoi lên, KHÔNG bỏ chạy!
        if timeLost < 6 and not HuDy.Flags.KilledTentacle then
            CurrentStatusText = string.format("<b>Status:</b> [Sea 3 Quest] Đang chờ Kraken ngoi lên (%.1fs/6s)...", 6 - timeLost)
            local altarSafeCF = CFrame.new(-8055.0, 50.0, 3219.1)
            HuDy.TP(altarSafeCF)
            return
        end
    end

    -- KHI TIÊU DIỆT XONG THẬT SỰ (hoặc Died = true, hoặc đã đánh và biến mất hoàn toàn > 6s):
    if (HuDy.Flags.KilledTentacle or (HuDy.Flags.TentacleEngaged and not boss)) and not boss then
        HuDy.Flags.TentacleEngaged = false
        HuDy.Flags.KilledTentacle = false
        HuDy.TentacleLostSince = nil
        print("[Sea 3 Quest] Đã tiêu diệt TOÀN BỘ Boss Tentacle xong! TP ngẫu nhiên lên Sky & Dịch chuyển qua Sea 3...")
        CurrentStatusText = "<b>Status:</b> Hạ Boss Tentacle xong! TP ngẫu nhiên lên Sky an toàn..."
        HuDy.RandomSkyTP(3)
        pcall(function()
            local args = { "TeleportSea", { SeaName = "ThirdSea" } }
            game:GetService("ReplicatedStorage"):WaitForChild("Chest", 5):WaitForChild("Remotes", 5):WaitForChild("Functions", 5):WaitForChild("EtcFunction", 5):InvokeServer(unpack(args))
        end)
        task.wait(2)
        return
    end

    -- Đặt guard trước nhánh Heart; nếu để sau thì mỗi tick lại bấm summon lần nữa.
    if HuDy.Flags.WaitingTentacleSpawn then
        CurrentStatusText = "<b>Status:</b> Đang chờ Tentacle xuất hiện tại Altar..."
        local altarSafeCF = CFrame.new(-8055.0, 48.0, 3219.1)
        HuDy.TP(altarSafeCF)
        return
    end

    -- ƯU TIÊN SỐ 2: Đã có Heart of Sea -> Tới Mystery Altar (Summon Tentacle) để Triệu hồi Boss
    if heart >= 1 then
        print("[Sea 3 Quest] Đã có Heart of Sea! Đang tiến tới Mystery Altar để triệu hồi Boss...")
        CurrentStatusText = "<b>Status:</b> [Sea 3 Quest] Đang tới Mystery Altar triệu hồi Tentacle..."
        local npc, targetRoot = HuDy.FindNPC("Summon Tentacle")
        if npc then
            if targetRoot and (root.Position - targetRoot.Position).Magnitude > 5 then
                HuDy.TP(targetRoot.CFrame * CFrame.new(0, 0, 3.5))
                return
            end
            print("[Sea 3 Quest] Đang tương tác với Mystery Altar...")
            HuDy.StopTP()
            
            -- Tương tác bằng ProximityPrompt hoặc click
            HuDy.Flags.WaitingTentacleSpawn = true
            HuDy.LastTentacleSummonAt = tick()
            HuDy.OpenDialogueAndAccept("Summon Tentacle")
            task.delay(15, function()
                if HuDy.LastTentacleSummonAt and (tick() - HuDy.LastTentacleSummonAt) >= 14 then
                    HuDy.Flags.WaitingTentacleSpawn = false
                end
            end)
        else
            warn("[Sea 3 Quest] Không tìm thấy NPC 'Summon Tentacle' (Mystery Altar)!")
            HuDy.TP(CFrame.new(-8055.0, 34.1, 3219.1))
        end
        return
    end

    -- Nếu CHƯA CÓ Heart of Sea thì mới đi kiểm tra nguyên liệu
    -- Bước 3: Check nguyên liệu chế tạo
    local fish = HuDy.GetMaterialCount("Fresh Fish")
    local ooze = HuDy.GetMaterialCount("Undead's Ooze")
    local feather = HuDy.GetMaterialCount("Angellic's Feather")
    
    if fish < 50 or ooze < 10 or feather < 15 then
        -- Thiếu nguyên liệu Sea 1 -> Teleport về Sea 1
        warn("Thiếu nguyên liệu Sea 1! Đang tự động Teleport về First Sea...")
        pcall(function()
            local args = { "TeleportSea", { SeaName = "FirstSea" } }
            game:GetService("ReplicatedStorage"):WaitForChild("Chest"):WaitForChild("Remotes"):WaitForChild("Functions"):WaitForChild("EtcFunction"):InvokeServer(unpack(args))
            task.wait(2)
            game:GetService("TeleportService"):Teleport(4520749081, LocalPlayer)
        end)
        return
    end

    local blood = HuDy.GetMaterialCount("Sea King's Blood")
    local bones = HuDy.GetMaterialCount("Pile of Bones")
    local logCount = HuDy.GetMaterialCount("Log")
    
    if blood < 1 then
        CurrentStatusText = "<b>Status:</b> Tìm rương Hydra / Sea King lấy Sea King's Blood..."

        -- Cùng state guard như V6: mỗi rương chỉ có một worker loot và API chỉ
        -- được report khi đổi trạng thái hoặc sau tối thiểu 30 giây.
        HuDy.BloodChestState = HuDy.BloodChestState or {
            Looting = false,
            Looted = {},
            LastReportedState = "",
            LastApiReportTime = 0
        }
        local chestState = HuDy.BloodChestState

        -- 1. Ưu tiên rương thật trong server hiện tại: cả Hydra và Sea King.
        local wIsland = workspace:FindFirstChild("Island")
        local foundChest = nil
        local foundAnchor = nil
        local foundReportState = nil
        if wIsland then
            local islandTargets = {
                {Name = "Sea King Thunder", Anchor = "HydraStand", State = "chest hd", Prefix = "HD_"},
                {Name = "Sea King Water", Anchor = "HydraStand", State = "chest hd", Prefix = "HD_"},
                {Name = "Sea King Lava", Anchor = "HydraStand", State = "chest hd", Prefix = "HD_"},
                {Name = "Legacy Island1", Anchor = "ChestSpawner", State = "chest sk", Prefix = "SK_"},
                {Name = "Legacy Island2", Anchor = "ChestSpawner", State = "chest sk", Prefix = "SK_"},
                {Name = "Legacy Island3", Anchor = "ChestSpawner", State = "chest sk", Prefix = "SK_"},
                {Name = "Legacy Island4", Anchor = "ChestSpawner", State = "chest sk", Prefix = "SK_"}
            }

            for _, target in ipairs(islandTargets) do
                local n = target.Name
                local isl = wIsland:FindFirstChild(n)
                local anchor = isl and isl:FindFirstChild(target.Anchor)
                if isl and anchor then
                    local targetChest = nil
                    for _, obj in ipairs(isl:GetDescendants()) do 
                        if obj:IsA("Model") and string.match(obj.Name, "Chest$")
                            and obj:GetPivot().Position.Y > -5
                            and not chestState.Looted[obj] then
                            targetChest = obj
                            break 
                        end 
                    end
                    if targetChest then
                        foundChest = targetChest
                        foundAnchor = anchor
                        foundReportState = target.State
                        break
                    end
                end
            end
        end

        if foundChest then
            CurrentStatusText = "<b>Status:</b> Đang nhặt " .. tostring(foundReportState) .. " lấy Sea King's Blood..."
            local nowClock = os.clock()
            if foundReportState ~= chestState.LastReportedState
                or (nowClock - chestState.LastApiReportTime) >= 30 then
                chestState.LastReportedState = foundReportState
                chestState.LastApiReportTime = nowClock
                pcall(function() ReportServerToAPI(foundReportState, false) end)
            end

            if not chestState.Looting then
                chestState.Looting = true
                HuDy.CurrentFarmMob = nil
                task.spawn(function()
                    local attempts = 0
                    while attempts < 40 and foundChest and foundChest.Parent do
                        if HuDy.GetMaterialCount("Sea King's Blood") >= 1 then break end
                        local currentRoot = GetRootPart()
                        if not currentRoot then break end

                        pcall(function()
                            local chestCFrame = CFrame.new((foundAnchor.CFrame * CFrame.new(0, -4.5, 0)).Position)
                            HuDy.TP(chestCFrame)
                            for _, part in ipairs(foundChest:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    if firetouchinterest then
                                        firetouchinterest(currentRoot, part, 0)
                                        firetouchinterest(currentRoot, part, 1)
                                    end
                                    local click = part:FindFirstChildOfClass("ClickDetector")
                                    if click and fireclickdetector then fireclickdetector(click) end
                                elseif part:IsA("ProximityPrompt") and fireproximityprompt then
                                    fireproximityprompt(part)
                                end
                            end
                        end)

                        attempts = attempts + 1
                        task.wait(0.1)
                    end
                    chestState.Looted[foundChest] = true
                    chestState.Looting = false

                    -- Lụm rương xong -> TP ngẫu nhiên lên Sky an toàn
                    print("[Sea 3 Quest] Lụm rương xong! TP ngẫu nhiên lên Sky an toàn...")
                    CurrentStatusText = "<b>Status:</b> Lụm rương xong! TP ngẫu nhiên lên Sky an toàn..."
                    HuDy.RandomSkyTP(2.5)

                    -- Sau khi nhặt rương xong, nếu vẫn chưa có Sea King's Blood:
                    -- Server này đã hết rương -> Blacklist server & Hop tiếp!
                    if HuDy.GetMaterialCount("Sea King's Blood") < 1 then
                        print("[Sea 3 Quest] Đã nhặt rương nhưng chưa đủ Blood! Blacklist server và Hop tiếp...")
                        if game.JobId and game.JobId ~= "" then
                            sessionIgnoredServers[game.JobId] = true
                            pcall(function()
                                saveTeleportedServers(game.JobId)
                                AddToBlacklist2(game.JobId)
                                ReportDeadServerToAPI()
                            end)
                        end
                        HuDy.HopBloodChest()
                    else
                        print("[Sea 3 Quest] Đã nhặt được Sea King's Blood thành công!")
                    end
                end)
            end
            return
        end

        -- Một worker đang xử lý rương vừa phát hiện; master loop không được
        -- khởi động hop hoặc tạo thêm worker trong thời gian này.
        if chestState.Looting then return end

        -- 2. Nếu không có rương, tìm Sea King để đánh
        local mob, mobRoot = HuDy.FindMob("Sea King")
        if mob and mobRoot then
            CurrentStatusText = "<b>Status:</b> Đang đánh Sea King lấy rương Blood..."
            HuDy.CurrentFarmMob = mob
            HuDy.WasFightingSeaKing = true
            local distance = HuDy.Flags.FarmDistance or 8
            HuDy.TP(mobRoot.CFrame * CFrame.new(0, distance + 30, 0) * CFrame.Angles(math.rad(-90), 0, 0), mobRoot.Position)
            HuDy.Attack(mobRoot)
        else
            -- Nếu vừa đánh Sea King xong (boss vừa chết)
            if HuDy.WasFightingSeaKing then
                HuDy.WasFightingSeaKing = false
                print("[Sea 3 Quest] Đã tiêu diệt Sea King xong! TP ngẫu nhiên lên Sky an toàn...")
                CurrentStatusText = "<b>Status:</b> Đã hạ Sea King! TP ngẫu nhiên lên Sky an toàn..."
                HuDy.RandomSkyTP(2.5)
                HuDy.WaitingSeaKingChestUntil = tick() + 22
            end

            -- Chờ rương spawn sau khi boss chết (tối đa 22s như V6)
            if HuDy.WaitingSeaKingChestUntil and tick() < HuDy.WaitingSeaKingChestUntil then
                local remaining = math.ceil(HuDy.WaitingSeaKingChestUntil - tick())
                CurrentStatusText = "<b>Status:</b> Đã hạ Sea King! Đang ở Sky an toàn chờ rương (" .. remaining .. "s)..."
                return
            end
            HuDy.WaitingSeaKingChestUntil = nil

            -- 3. Không có Boss & Không có Rương -> TP ngẫu nhiên lên Sky & Server Hop
            print("[Sea 3 Quest] Không có rương Sea King! TP ngẫu nhiên lên Sky & Hop server...")
