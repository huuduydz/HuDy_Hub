            else
                local heart   = HuDy.GetMaterialCount("Heart of Sea")
                local blood   = HuDy.GetMaterialCount("Sea King's Blood")
                local bones   = HuDy.GetMaterialCount("Pile of Bones")
                local logs    = HuDy.GetMaterialCount("Log")
                local scrap   = HuDy.GetMaterialCount("Rusted Scrap")
                local fish    = HuDy.GetMaterialCount("Fresh Fish")
                local ooze    = HuDy.GetMaterialCount("Undead's Ooze")
                local feather = HuDy.GetMaterialCount("Angellic's Feather")

                nextMaterialsText = string.format(
                    "<font color='#38bdf8'><b>SEA %s QUEST PROGRESS:</b></font>\n" ..
                    "Heart: <font color='#ec4899'><b>%d</b></font> | Blood: <font color='#ef4444'><b>%d/1</b></font> | Bones: <font color='#e2e8f0'><b>%d/10</b></font>\n" ..
                    "Logs: <font color='#10b981'><b>%d/30</b></font> | Scrap: <font color='#cbd5e1'><b>%d/10</b></font> | Fish: <font color='#38bdf8'><b>%d/50</b></font>\n" ..
                    "Ooze: <font color='#a855f7'><b>%d/10</b></font> | Feather: <font color='#f59e0b'><b>%d/15</b></font>\n" ..
                    "<font color='#94a3b8'>Stat Build: %s | Stat Points: %d</font>",
                    isSea2 and "2" or "1", heart, blood, bones, logs, scrap, fish, ooze, feather, CurrentStatMode, availablePoints
                )
            end

            if WhiteScreenMaterialsLabel then
                if nextMaterialsText ~= lastMaterialsText then
                    lastMaterialsText = nextMaterialsText
                    WhiteScreenMaterialsLabel.Text = nextMaterialsText
                end
            end
        end)
    end
end)

