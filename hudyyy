local function safeRequest(options)
    local fn = (type(request) == "function" and request)
        or (type(http_request) == "function" and http_request)
        or (syn and type(syn.request) == "function" and syn.request)
        or (fluxus and type(fluxus.request) == "function" and fluxus.request)
        or (http and type(http.request) == "function" and http.request)
    if fn and type(options) == "table" then
        if options.Timeout == nil and options.timeout == nil then
            options.Timeout = 5
        end
        local ok, res = pcall(fn, options)
        if ok then return res end
    end
    return nil
end
