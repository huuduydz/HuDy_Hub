function HuDy.CheckBossAlive(targetStr)
    local function isAlive(mob)
        return mob and mob:IsA("Model") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0
    end

    if targetStr == "serpent" or targetStr == "sp" or targetStr == "sea_serpent" then
        local folders = {
            workspace:FindFirstChild("SeaMonster"),
            workspace:FindFirstChild("Monster"),
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"),
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"),
            workspace:FindFirstChild("MOB"),
            workspace
        }
        for _, f in ipairs(folders) do
            if f then
                local m1 = f:FindFirstChild("Serpent")
                if isAlive(m1) then return m1 end
                local m2 = f:FindFirstChild("Sea Serpent")
                if isAlive(m2) then return m2 end
                local m3 = f:FindFirstChild("SeaSerpent")
                if isAlive(m3) then return m3 end
                for _, child in ipairs(f:GetChildren()) do
                    if isAlive(child) and string.find(string.lower(child.Name), "serpent", 1, true) then
                        return child
                    end
                end
            end
