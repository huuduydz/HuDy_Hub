-- King Legacy không thống nhất tên object level giữa các bản/server
-- (Level, Lvl, lvl và đôi lúc nằm trong Data/leaderstats). Không được trả về
-- level 1 khi chưa đọc được vì master loop sẽ hiểu nhầm và farm sai quest.
local LastKnownLevel = nil

local function ParseLevelNumber(rawValue)
    if rawValue == nil then return nil end
    local cleaned = tostring(rawValue):gsub(",", "")
    local value = tonumber(cleaned)
    if not value then
        value = tonumber(cleaned:match("(%d+)") or "")
    end
    if not value or value < 1 or value > 100000 then return nil end
    return math.floor(value)
end

local function IsLevelObjectName(name)
    local normalized = string.lower(tostring(name or "")):gsub("[^%w]", "")
    return normalized == "level"
        or normalized == "lvl"
        or normalized == "lv"
        or normalized == "playerlevel"
        or normalized == "leveltext"
        or normalized == "levellabel"
end

local function ReadLevelFromContainer(container)
    if not container then return nil end
    local best = nil

    local function inspect(object)
        if not IsLevelObjectName(object.Name) then return end
        local value = nil
        pcall(function()
            if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                value = ParseLevelNumber(object.Text)
            else
                value = ParseLevelNumber(object.Value)
            end
        end)
        if value and (not best or value > best) then
            best = value
        end
    end

    inspect(container)
    for _, object in ipairs(container:GetDescendants()) do
        inspect(object)
    end
    return best
end

local function GetCurrentLevel()
    local best = nil
    local sources = {
        LocalPlayer:FindFirstChild("PlayerStats"),
        LocalPlayer:FindFirstChild("Data"),
        LocalPlayer:FindFirstChild("leaderstats")
    }

    for _, source in ipairs(sources) do
        local value = ReadLevelFromContainer(source)
        if value and (not best or value > best) then
            best = value
        end
    end

    -- Fallback có kiểm soát cho các server chỉ replicate level lên HUD.
    if not best then
        best = ReadLevelFromContainer(LocalPlayer:FindFirstChild("PlayerGui"))
    end

    if best then
        LastKnownLevel = math.max(LastKnownLevel or 0, best)
    end
    return LastKnownLevel or 0
end
HuDy.GetCurrentLevel = GetCurrentLevel

