                    end
                end

                local autoKen = HuDy.Flags.AutoKen ~= false
                    and _G.AutoKen ~= false and _G.ken ~= false
                if autoKen then
                    local playerCharacters = workspace:FindFirstChild("PlayerCharacters")
                    local playerCharacter = playerCharacters and playerCharacters:FindFirstChild(LocalPlayer.Name)
                    local services = playerCharacter and playerCharacter:FindFirstChild("Services")
                    local kenOpen = services and services:FindFirstChild("KenOpen")
                    if kenOpen and kenOpen.Value == false then
                        local functions = remotes and remotes:FindFirstChild("Functions")
                        local kenEvent = functions and functions:FindFirstChild("KenEvent")
                        if kenEvent then kenEvent:InvokeServer() end
                    end
                end
            end)
        end
    end)
end

