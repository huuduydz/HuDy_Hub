HuDy.FarmLoopRunning = false

function HuDy.StartAutoFarm()
    if HuDy.FarmLoopRunning then return end
    HuDy.FarmLoopRunning = true
    
    task.spawn(function()
        while (_G.AutoFarm or (isSea3 and _G.AutoHopSetSail)) and HuDy.FarmLoopRunning do
            task.wait(0.1)
            pcall(function()
                -- Khi server-hop đã nắm quyền thì master loop không được TP/đánh
                -- thêm trong lúc radar đang chọn server đích.
                if isHoppingFinal then return end

                -- KIỂM TRA SẴN SÀNG CỦA NHÂN VẬT & TOOLS (CHỐNG EQUIP "NONE" KHI DIE / VỪA VÀO GAME):
                -- Nếu nhân vật đang chết (die/respawn) hoặc vừa vào server mà Backpack chưa kịp load tool:
                -- Tạm dừng loop, đợi nhân vật và tool xuất hiện hoàn chỉnh, chống lỗi equip "None"!
                if not HuDy.IsCharacterReady() then
                    CurrentStatusText = "<b>Status:</b> Đang đợi nhân vật & Tools load hoàn tất (chống equip None)..."
                    task.wait(0.4)
                    return
                end

                -- Khi đang ở trạng thái Sky Safe (sau khi lụm rương hoặc đánh boss xong):
                -- Giữ nguyên vị trí an toàn trên trời, không kéo nhân vật đi quái.
                if HuDy.SkySafeUntil and tick() < HuDy.SkySafeUntil then
                    CurrentStatusText = "<b>Status:</b> [Sky Safe] Đang ở vị trí ngẫu nhiên an toàn trên trời..."
                    return
                end

                -- ƯU TIÊN BLOCKING: Nếu ở Sea 1 hoặc Sea 2 mà chưa có Passive Tree
                -- thì dừng hoàn toàn farm quái, ưu tiên tìm Tree và unlock Passive trước!
                if (isSea1 or isSea2) and (_G.AutoFindTree ~= false or _G.AutoHopTree) and not HuDy.HasClaimedPassiveTree then
                    if not checkAlreadyClaimedTree() then
                        HuDy.IsFindingTree = true
                        autoClaimPassiveTree()
                        return
                    else
                        HuDy.HasClaimedPassiveTree = true
                        HuDy.IsFindingTree = false
                    end
                end

                -- Khi đang trong tiến trình tìm & nhận Passive Tree:
                -- Tạm dừng loop farm level để không kéo nhân vật rời khỏi cây
                if HuDy.IsFindingTree then return end

                local root = GetRootPart()
                if not root then return end
                
                -- -------------------------------------------------------------
                -- GIAI ĐOẠN 1: FIRST SEA (SEA 1)
                -- -------------------------------------------------------------
                if isSea1 then
                    local level = HuDy.GetCurrentLevel()
                    if level <= 0 then
                        CurrentStatusText = "<b>Status:</b> Đang đồng bộ level từ server..."
                        return
                    end

                    -- ĐẶC BIỆT: Tài khoản Lv >= 4000 về Sea 1 chỉ để chế tạo cần câu Rod
                    if level >= 4000 then
                        if HuDy.HasBasicRod() then
                            if HuDy.IsThirdSeaUnlocked() then
                                CurrentStatusText = "<b>Status:</b> [Craft Rod] Đã có Cần câu & Đã mở Sea 3! Dịch chuyển về lại Sea 3..."
                                HuDy.TeleportToThirdSea()
                                return
                            elseif HuDy.IsSecondSeaUnlocked() then
                                CurrentStatusText = "<b>Status:</b> [Craft Rod] Đã có Cần câu (Chưa mở Sea 3)! Dịch chuyển sang Sea 2..."
                                HuDy.TeleportToSecondSea()
                                return
                            end
                            -- Nếu chưa mở SecondSea thì để code trôi xuống dưới làm Traveler Quest mở Sea 2
                        else
                            if HuDy.CheckAndCraftBasicRod(true) then
                                return
                            end
                            return
                        end
                    end

                    -- Từ mốc Quake Woman trở đi phải có Quake Spear/Bisento mới
                    -- được tiếp tục level, gom material hoặc làm Traveler Quest.
                    if level >= 1925 and not HuDy.HasBisento() then
                        HuDy.FarmBisento()
                        return
                    end

                    -- Kiểm tra chế tạo cần câu Basic Rod (chế sẵn trong lúc kaitun lv Sea 1 hoặc khi _G.CraftRod bật)
                    if (_G.CraftRod or HuDy.HasBisento()) and not HuDy.HasBasicRod() then
                        if HuDy.CheckAndCraftBasicRod(true) then
                            return
                        end
                    end

                    if level >= 2250 and (_G.AutoNextSea2 or _G.AutoNextSea3) then
                        -- Trước khi rời Sea 1: nếu chưa có Basic Rod -> ưu tiên chế tạo trước khi sang Sea 2
                        if (_G.CraftRod or HuDy.HasBisento()) and not HuDy.HasBasicRod() then
                            if HuDy.CheckAndCraftBasicRod(true) then
                                return
                            end
                        end

                        -- Gom đủ bộ nguyên liệu Sea 1 trước khi rời Sea 1 để không
                        -- bị vòng Sea 3 Quest kéo ngược qua lại giữa hai Sea.
                        local missingData = _G.AutoNextSea3 and HuDy.GetSea3MissingMaterialData() or nil
                        if missingData then
                            CurrentStatusText = "<b>Status:</b> [Sea 1] Chuẩn bị Sea 3: " .. tostring(missingData.MobName)
                            HuDy.ExecuteQuestFarm(missingData)
                        else
                            CurrentStatusText = "<b>Status:</b> [Sea 1] Lv " .. level .. " >= 2250 -> Thực hiện Traveler Quest mở Sea 2..."
                            HuDy.DoTravelerQuest()
                        end
                        return
                    end

                    local data = HuDy.GetTargetData()
                    if data then
                        HuDy.ExecuteQuestFarm(data)
                    end
                    return
                end
                
                -- -------------------------------------------------------------
                -- GIAI ĐOẠN 2: SECOND SEA (SEA 2)
                -- TIẾP TỤC CÀY CẤP LÊN 4000 & MỞ SEA 3 (BỎ HOP SEAKING HYDRA)
                -- -------------------------------------------------------------
                if isSea2 then
                    local level = HuDy.GetCurrentLevel()
                    if level <= 0 then
                        CurrentStatusText = "<b>Status:</b> Đang đồng bộ level từ server..."
                        return
                    end
                    -- Nếu _G.CraftRod bật mà acc chưa có Cần câu (Rod) -> Về Sea 1 chế tạo
                    if _G.CraftRod and not HuDy.HasBasicRod() then
                        HuDy.ReturnFirstSeaForRod()
                        return
                    end
                    if level >= 4000 and _G.AutoNextSea3 then
                        -- Account cũ đã ở Sea 2 nhưng chưa có Bisento cũng phải quay
                        -- lại Sea 1 lấy weapon trước khi bước vào chuỗi Sea 3 Quest.
                        if not HuDy.HasBisento() then
                            HuDy.ReturnFirstSeaForBisento()
                            return
                        end
                        CurrentStatusText = "<b>Status:</b> [Sea 2] Lv " .. level .. " >= 4000 -> Thực hiện Sea 3 Quest mở Third Sea..."
                        HuDy.DoSea3Quest()
                        return
                    end
                    
                    local data = HuDy.GetTargetData()
                    if data then
                        HuDy.ExecuteQuestFarm(data)
                    end
                    return
                end
                
                -- -------------------------------------------------------------
                -- GIAI ĐOẠN 3: THIRD SEA (SEA 3) - SĂN & HOP SET SAILS
                -- -------------------------------------------------------------
                if isSea3 then
                    local level = HuDy.GetCurrentLevel()
                    if level <= 0 then
                        CurrentStatusText = "<b>Status:</b> Đang đồng bộ level từ server..."
                        return
                    end
                    -- Nếu acc chưa có Cần câu (Rod) -> Tự động về Sea 1 chế tạo rồi quay lại Sea 3
                    if not HuDy.HasBasicRod() then
                        CurrentStatusText = "<b>Status:</b> [Sea 3] Chưa có Cần câu (Rod) -> Đang về Sea 1 craft..."
                        HuDy.ReturnFirstSeaForRod()
                        return
                    end

                    -- 1. Ưu tiên kiểm tra lấy Melee Trickster khi đã đủ 10 Trickshard
                    if _G.AutoGetTrickster and not HuDy.HasTrickster() and HuDy.GetTrickshardCount() >= 10 then
                        if HuDy.CheckAndUnlockTrickster() then
                            return
                        end
                    end

                    -- 2. Ưu tiên săn Boss Set Sail xuất hiện trên map
                    local setSailTarget = nil
                    local setSailKey = nil
                    local setSailList = {"df_inferno", "ds_crusher", "abyssal", "chaos_kraken", "serpent"}
                    
                    for _, key in ipairs(setSailList) do
                        if not HuDy.IsBossEnabled or HuDy.IsBossEnabled(key) then
                            local m = HuDy.CheckBossAlive(key)
                            if m then
                                setSailTarget = m
                                setSailKey = key
                                break
                            end
                        end
                    end
                    
                    if setSailTarget then
                        HuDy.IsWaitingBossSpawn = false
                        if HuDy.AutoFishSerpentActive then
                            HuDy.AutoFishSerpentActive = false
                            HuDy.DestroyFishingPlatform()
                        end
                        -- Tự động đổi từ Cần câu sang Sword tốt nhất (Acrodagger -> Bisento) để đánh Boss/Serpent
                        HuDy.EquipBestSerpentSword()

                        -- KIỂM TRA NGAY TỨC THÌ: Nếu boss đã hết máu (Health <= 0) trước đòn đánh
                        local bHum = setSailTarget:FindFirstChildOfClass("Humanoid")
                        if bHum and bHum.Health <= 0 then
                            print(string.format("[Sea 3 Boss] ⚡ Boss %s đã hết máu (Health <= 0)! TP thẳng Sky Random ngay lập tức!", tostring(setSailTarget.Name)))
                            HuDy.WasFightingSetSail = false
                            local kKey = setSailKey or HuDy.LastFightingBossKey
                            local kName = tostring(setSailTarget.Name) or HuDy.LastFightingBossName or "Boss"
                            HuDy.StopTP()
                            HuDy.RandomSkyTP()
                            HuDy.HandleBossKilledSetSail(kKey, kName)
                            return
                        end

                        local bRoot = HuDy.GetMobRoot(setSailTarget)
                        if bRoot then
                            CurrentStatusText = "<b>Status:</b> [Sea 3] PHÁT HIỆN BOSS SET SAIL: " .. tostring(setSailTarget.Name) .. "! Đang tiêu diệt..."
                            local dist = _G.SetSailDistance or 45
                            local targetCFrame = CFrame.new(bRoot.Position + Vector3.new(0, dist, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                            TP(targetCFrame, bRoot.Position)
                            Attack(bRoot)
                            HuDy.WasFightingSetSail = true
                            HuDy.LastFightingBossKey = setSailKey
                            HuDy.LastFightingBossName = tostring(setSailTarget.Name)
                            HuDy.LastSeenFightingBossTick = tick()
                            HuDy.HasScannedDirectionsThisServer = false

                            -- KIỂM TRA NGAY SAU ĐÒN ĐÁNH: Nếu vừa ra đòn kết liễu boss -> bay Sky Random ngay không chờ đợi!
                            local humAfter = setSailTarget:FindFirstChildOfClass("Humanoid")
                            if humAfter and humAfter.Health <= 0 then
                                print(string.format("[Sea 3 Boss] ⚡ Boss %s vừa bị hạ gục sau đòn đánh! TP thẳng Sky Random ngay lập tức!", tostring(setSailTarget.Name)))
                                HuDy.WasFightingSetSail = false
                                HuDy.StopTP()
                                HuDy.RandomSkyTP()
                                HuDy.HandleBossKilledSetSail(setSailKey, tostring(setSailTarget.Name))
                                return
                            end
                            return
                        end
                    end

                    -- Đã đánh xong Boss Set Sail (boss vừa chết hoặc model đã biến mất/despawn)
                    if HuDy.WasFightingSetSail then
                        local timeSinceSeen = tick() - (HuDy.LastSeenFightingBossTick or tick())
                        if timeSinceSeen >= 0.3 then
                            HuDy.WasFightingSetSail = false
                            local kKey = HuDy.LastFightingBossKey
                            local kName = HuDy.LastFightingBossName or "Boss"
                            print(string.format("[Sea 3 Boss] ⚡ Boss %s đã biến mất/chết! TP thẳng Sky Random ngay lập tức!", tostring(kName)))
                            HuDy.StopTP()
                            HuDy.RandomSkyTP()
                            HuDy.HandleBossKilledSetSail(kKey, kName)
                            return
                        else
                            task.wait(0.05)
                            return
                        end
                    end
                    
                    -- 3. BossEarlyJoinSec Guard: Kiểm tra xem boss có chuẩn bị spawn không trước khi quyết định Hop!
                    local earlyJoinSec = (type(_G) == "table" and type(_G.BossEarlyJoinSec) == "number") and _G.BossEarlyJoinSec or 90
                    if earlyJoinSec < 60 then earlyJoinSec = 90 end
                    
                    -- A) Kiểm tra xoáy nước Serpent Whirlpool (Serpent sắp trồi lên hoặc đang chờ câu)
                    local hasWhirlpool = workspace:FindFirstChild("Effects") and workspace.Effects:FindFirstChild("SerpentWhirlpool")
                    local isSerpentWanted = (not HuDy.IsBossEnabled or HuDy.IsBossEnabled("serpent", "Sea Serpent"))
                    if hasWhirlpool and isSerpentWanted then
                        if HuDy.HasBasicRod() then
                            -- ĐÃ CÓ CẦN CÂU (ROD) -> TP LẠI XOÁY NƯỚC VÀ CÂU SERPENT!
                            HuDy.FishSerpentWhirlpool(hasWhirlpool)
                            return
                        else
                            -- CHƯA CÓ CẦN CÂU: Quay về Sea 1 craft cần câu
                            print("[Sea 3]: 🌀 Phát hiện Xoáy nước Serpent nhưng acc chưa có Rod! Quay về Sea 1 craft cần câu...")
                            CurrentStatusText = "<b>Status:</b> [Sea 3] 🌀 Phát hiện Xoáy nước Serpent (chưa có Rod) -> Quay về Sea 1 craft..."
                            HuDy.ReturnFirstSeaForRod()
                            return
                        end
                    else
                        if HuDy.AutoFishSerpentActive then
                            HuDy.AutoFishSerpentActive = false
                            HuDy.DestroyFishingPlatform()
                        end
                    end

                    -- B) Kiểm tra Pose đồng hồ hẹn giờ 4 boss Set Sail
                    local ssKey, ssName, ssSecs = HuDy.GetThirdSeaBossTimer()
                    local isSsWanted = ssKey and (not HuDy.IsBossEnabled or HuDy.IsBossEnabled(ssKey, ssName))
                    if ssSecs and ssSecs > 0 and ssSecs <= (earlyJoinSec + 5) and isSsWanted then
                        -- Boss đang trong khung chờ spawn (<= BossEarlyJoinSec)!
                        -- Logic: Chỉ cần ở Spawn rồi đợi boss spawn, KHÔNG cần random lên sky!
                        HuDy.IsWaitingBossSpawn = true
                        HuDy.WaitingBossKey = ssKey
                        HuDy.WaitingBossName = ssName
                        HuDy.WaitingBossDueAt = os.clock() + ssSecs
                        HuDy.HasScannedDirectionsThisServer = false

                        CurrentStatusText = string.format("<b>Status:</b> [Sea 3] ⏳ Đang đợi tại Spawn chờ %s spawn (còn %ds / EarlyJoin %ds)...", ssName or ssKey or "Boss", ssSecs, earlyJoinSec)
                        local spawnCF = CFrame.new(1550.5, 35.6, 970.8)
                        local root = GetRootPart()
                        if root and (root.Position - spawnCF.Position).Magnitude > 300 then
                            TP(spawnCF)
                        else
                            HuDy.StopTP()
                        end
                        return
                    end

                    -- C) KHI BOSS SPAWN NẾU KHÔNG TÌM ĐƯỢC BOSS TẠI SPAWN:
                    -- Cần tele 5000 stud 4 hướng để check xem đã spawn chưa để đánh, nếu lỗi và không thấy thì cứ hop tiếp!
                    local shouldScanDirections = false
                    if not HuDy.HasScannedDirectionsThisServer then
                        if HuDy.IsWaitingBossSpawn and (not ssSecs or ssSecs <= 0 or (HuDy.WaitingBossDueAt and os.clock() >= HuDy.WaitingBossDueAt)) then
                            shouldScanDirections = true
                        elseif ssSecs and ssSecs <= 0 and isSsWanted then
                            shouldScanDirections = true
                        elseif (not ssSecs or ssSecs <= 0) and _G.AutoHopSetSail then
                            shouldScanDirections = true
                        end
                    end

                    if shouldScanDirections then
                        HuDy.IsWaitingBossSpawn = false
                        local scannedTarget, scannedKey = HuDy.ScanFourDirectionsForBoss()
                        if scannedTarget then
                            setSailTarget = scannedTarget
                            setSailKey = scannedKey
                            local bHum = setSailTarget:FindFirstChildOfClass("Humanoid")
                            if bHum and bHum.Health <= 0 then
                                HuDy.WasFightingSetSail = false
                                HuDy.StopTP()
                                HuDy.RandomSkyTP()
                                HuDy.HandleBossKilledSetSail(setSailKey, tostring(setSailTarget.Name))
                                return
                            end
                            local bRoot = HuDy.GetMobRoot(setSailTarget)
                            if bRoot then
                                HuDy.EquipBestSerpentSword()
                                CurrentStatusText = "<b>Status:</b> [Sea 3] PHÁT HIỆN BOSS SET SAIL: " .. tostring(setSailTarget.Name) .. "! Đang tiêu diệt..."
                                local dist = _G.SetSailDistance or 45
                                local targetCFrame = CFrame.new(bRoot.Position + Vector3.new(0, dist, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                                TP(targetCFrame, bRoot.Position)
                                Attack(bRoot)
                                HuDy.WasFightingSetSail = true
                                HuDy.LastFightingBossKey = setSailKey
                                HuDy.LastFightingBossName = tostring(setSailTarget.Name)
                                HuDy.LastSeenFightingBossTick = tick()
                                HuDy.HasScannedDirectionsThisServer = false
                                local humAfter = setSailTarget:FindFirstChildOfClass("Humanoid")
                                if humAfter and humAfter.Health <= 0 then
                                    HuDy.WasFightingSetSail = false
                                    HuDy.StopTP()
                                    HuDy.RandomSkyTP()
                                    HuDy.HandleBossKilledSetSail(setSailKey, tostring(setSailTarget.Name))
                                    return
                                end
                                return
                            end
                            -- Nếu đã phát hiện model boss nhưng bRoot đang load: lập tức return, TUYỆT ĐỐI KHÔNG ĐƯỢC HOP!
                            return
                        end
                    end

                    -- 4. Bật Hop Set Sail:
                    -- CHỈ HOP KHI: Không có Boss trên map, không đang đánh Boss, và (đã quét 4 hướng không thấy HOẶC thời gian timer > earlyJoinSec + 5)!
                    if _G.AutoHopSetSail and not setSailTarget and not HuDy.WasFightingSetSail then
                        if (ssSecs and ssSecs > (earlyJoinSec + 5)) or HuDy.HasScannedDirectionsThisServer then
                            local waitDetail = ssSecs and string.format("còn %ds > %ds", ssSecs, earlyJoinSec) or "hết boss"
                            CurrentStatusText = string.format("<b>Status:</b> [Sea 3] Đã check 4 hướng (5000 studs) không có Boss (%s). Đang Hop tiếp...", waitDetail)
                            HuDy.HopSetSailServer()
                            return
                        end
                    end

                    -- 3. Tắt Hop Set Sail: tiếp tục cày level đến 5450.
                    if level < 5450 then
                        local data = HuDy.GetTargetData()
                        if data then
                            CurrentStatusText = "<b>Status:</b> [Sea 3] Cày cấp (Lv " .. level .. "/5450)..."
                            HuDy.ExecuteQuestFarm(data)
                            return
                        end
                    end
                    
                    CurrentStatusText = "<b>Status:</b> [Sea 3] Đã đạt Lv 5450; Hop Set Sail đang tắt."
                    HuDy.StopTP()
                    return
                end
            end)
        end
        HuDy.FarmLoopRunning = false
        HuDy.StopTP()
    end)
end

