            pcall(function() value = object.Value end)
            local valueName = NormalizeWeaponName(value)
            if IsBisentoOrQuakeSpear(object.Name) and object:IsA("ValueBase")
                and value ~= false and tostring(value) ~= "0" and string.lower(tostring(value)) ~= "no" then
