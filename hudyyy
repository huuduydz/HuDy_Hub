function HuDy.IsCharacterReady()
    local lp = game:GetService("Players").LocalPlayer
    if not lp then return false end

    local char = lp.Character
    if not char or not char.Parent or not char:IsDescendantOf(workspace) then
        return false
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not hrp then
        return false
    end

    local backpack = lp:FindFirstChild("Backpack")
    if not backpack then
        return false
    end

    -- 1. Kiểm tra xem Tool đã load vào Character hoặc Backpack chưa
    local hasAnyTool = (char:FindFirstChildOfClass("Tool") ~= nil) or (backpack:FindFirstChildOfClass("Tool") ~= nil)
    if hasAnyTool then
        HuDy.CharacterReady = true
        HuDy.IsCharacterSpawning = false
        return true
    end

    -- 2. Nếu chưa có tool nào xuất hiện trong Character và Backpack:
    -- Trong 6 giây đầu kể từ lúc respawn/vào server: CHỜ SERVER LOAD TOOL, TUYỆT ĐỐI KHÔNG COI LÀ READY để tránh equip "None"!
    local elapsed = os.clock() - (HuDy.LastRespawnTime or 0)
    if elapsed < 6 then
        return false
    end

    -- 3. Timeout an toàn sau 6 giây nếu nhân vật thực sự không có bất kỳ tool nào
    HuDy.CharacterReady = true
    return true
end

function HuDy.WaitForCharacterAndTools(maxWait)
    maxWait = maxWait or 5
    local start = os.clock()
    while (os.clock() - start) < maxWait do
        if HuDy.IsCharacterReady() then
            return true
        end
        task.wait(0.2)
    end
    return HuDy.IsCharacterReady()
end

local function SetupCharacterLoadListeners(charInstance)
    if not charInstance then return end
    HuDy.LastRespawnTime = os.clock()
    HuDy.IsCharacterSpawning = true
    HuDy.CharacterReady = false

    local hum = charInstance:WaitForChild("Humanoid", 10)
    if hum then
        hum.Died:Connect(function()
            HuDy.CharacterReady = false
            HuDy.IsCharacterSpawning = true
            HuDy.LastRespawnTime = os.clock()
        end)
    end

    task.spawn(function()
        charInstance:WaitForChild("HumanoidRootPart", 10)
        local bp = LocalPlayer:WaitForChild("Backpack", 10)
        local timeout = os.clock() + 6
        while os.clock() < timeout do
            if (charInstance:FindFirstChildOfClass("Tool") ~= nil) or (bp and bp:FindFirstChildOfClass("Tool") ~= nil) then
                break
            end
            task.wait(0.2)
        end
        task.wait(0.5) -- Đệm 0.5s để server đồng bộ đầy đủ các Tool và UI hotbar
        HuDy.IsCharacterSpawning = false
        HuDy.CharacterReady = true
    end)
end

