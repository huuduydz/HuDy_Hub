        if not root then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.AutoRotate = false
            hum.PlatformStand = false
        end
        local randomX = math.random(2000, 4000) * (math.random(1, 2) == 1 and 1 or -1)
        local randomZ = math.random(2000, 4000) * (math.random(1, 2) == 1 and 1 or -1)
        local randomY = math.random(350, 450)
        local skyCFrame = CFrame.new(randomX, randomY, randomZ)
        
        pcall(function() char:PivotTo(skyCFrame) end)
        root.CFrame = skyCFrame
        pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
        pcall(function() root.AssemblyAngularVelocity = Vector3.zero end)
        
        if not root:FindFirstChild("FreezePos") then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FreezePos"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = root
        else
            root.FreezePos.Velocity = Vector3.new(0, 0, 0)
        end
        
        if not root:FindFirstChild("FreezeRot") then
            local bg = Instance.new("BodyGyro")
            bg.Name = "FreezeRot"
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.P = 500000
            bg.CFrame = skyCFrame
            bg.Parent = root
        else
            root.FreezeRot.CFrame = skyCFrame
        end

        local dur = (type(waitDuration) == "number" and waitDuration > 0) and waitDuration or 2.5
        HuDy.SkySafeUntil = tick() + dur
    end)
    if type(waitDuration) == "number" and waitDuration > 0 then
        task.wait(waitDuration)
    end
end

