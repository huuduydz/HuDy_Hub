                if isAlive(m2) then return m2 end
            end
        end
        return nil
    elseif targetStr == "chaos_kraken" then
        local searchFolders = {
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Boss"),
            workspace:FindFirstChild("Monster") and workspace.Monster:FindFirstChild("Mon"),
