local function DoTravelerQuest()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        
        local SEA_2_ID = 6381829480

        -- Kiểm tra xem đã hoàn thành điều kiện qua Sea 2 chưa (SecondSeaProgression == "Yes")
        local isProgressionDone = false
        pcall(function()
            local stats = LocalPlayer:FindFirstChild("PlayerStats")
            if stats then
                local progression = stats:FindFirstChild("SecondSeaProgression")
                if progression and progression.Value == "Yes" then
                    isProgressionDone = true
                end
            end
        end)

        -- BƯỚC 4: Khi ĐÃ TRẢ XONG QUEST TRAVELER hoặc SecondSeaProgression == "Yes" -> Đến gặp Elite Pirate để qua Sea 2
        if ((type(getgenv) == "function" and getgenv().TravelerQuestDone) or _G.TravelerQuestDone) or isProgressionDone then
            local telePart = GetNPCPart("Elite Pirate")
            if telePart then
                if (root.Position - telePart.Position).Magnitude > 15 then
                    TP(telePart.CFrame * CFrame.new(0, 5, 0))
                    return
                end
                StopTP()
                
                _elitePirateAttempts = _elitePirateAttempts + 1
                
                -- Mở hội thoại với Elite Pirate, click Accept và thực hiện chuyển Sea
                OpenDialogueAndAccept("Elite Pirate")
                task.wait(1.5)
                pcall(function()
                    local args = { "TeleportSea", { SeaName = "SecondSea" } }
                    game:GetService("ReplicatedStorage"):WaitForChild("Chest", 5):WaitForChild("Remotes", 5):WaitForChild("Functions", 5):WaitForChild("EtcFunction", 5):InvokeServer(unpack(args))
                end)
                task.wait(1)
                pcall(function() TeleportService:Teleport(SEA_2_ID, LocalPlayer) end)
                task.wait(8)
                
                if _elitePirateAttempts >= 3 then
                    _elitePirateAttempts = 0
                    ResetCharacter()
                end
                return
            else
                TP(CFrame.new(-2450, 50, -3200))
                return
            end
        end

        -- BƯỚC 3: Đã có Map trong kho -> Bay về gặp Traveler, ĐỨNG YÊN mở hộp thoại trả quest và bấm Accept
        if HasTravelerMap() then
            local tPart = GetNPCPart("Traveler")
            if tPart then
                if (root.Position - tPart.Position).Magnitude > 15 then
                    TP(tPart.CFrame * CFrame.new(0, 5, 0))
                    return
                end
                StopTP()
                
                -- Khóa cố định vị trí sát mặt NPC Traveler
                root.CFrame = CFrame.new((tPart.CFrame * CFrame.new(0, 0, 3.5)).Position, tPart.Position)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                
                _travelerTurnInAttempts = _travelerTurnInAttempts + 1
                print("[HuDy Hub]: Đang tương tác trả quest cho Traveler (Lần " .. _travelerTurnInAttempts .. ")...")
                
                -- Mở dialogue NPC Traveler & click Accept trả quest
                OpenDialogueAndAccept("Traveler")
                
                -- Gửi thêm remote trả quest trực tiếp
                pcall(function()
                    local questRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Chest")
                        and game:GetService("ReplicatedStorage").Chest:FindFirstChild("Remotes")
                        and game:GetService("ReplicatedStorage").Chest.Remotes:FindFirstChild("Functions")
                        and game:GetService("ReplicatedStorage").Chest.Remotes.Functions:FindFirstChild("Quest")
                    if questRemote then
                        questRemote:InvokeServer("talk", "Traveler")
                        questRemote:InvokeServer("take", "Traveler")
                        questRemote:InvokeServer("take", "TravelerQuest")
                    end
                end)
                
                task.wait(2.5)
                
                -- Kiểm tra nếu Map đã biến mất khỏi kho hoặc progression đã thành Yes -> Xác nhận hoàn thành
                if not HasTravelerMap() or isProgressionDone then
                    _travelerTurnInAttempts = 0
                    pcall(function() if type(getgenv) == "function" then getgenv().TravelerQuestDone = true end end)
                    _G.TravelerQuestDone = true
                    print("[HuDy Hub]: Trả quest cho Traveler thành công!")
                    return
                end
                
                -- NẾU THỬ >= 3 LẦN MÀ VẪN CÒN MAP (NPC BỊ KẸT CLICK) -> TỰ ĐỘNG RESET MÁU = 0 ĐỂ LÀM MỚI!
                if _travelerTurnInAttempts >= 3 then
                    print("[HuDy Hub]: Trả quest thất bại 3 lần liên tiếp -> Tiến hành Reset nhân vật (Health = 0)...")
                    _travelerTurnInAttempts = 0
                    ResetCharacter()
                end
                return
            else
                TP(CFrame.new(-3400, 50, 4800))
                return
            end
        end

        -- BƯỚC 1: Chưa có Map & chưa nhận Quest -> Bay đến gặp Traveler nhận nhiệm vụ
        local activeQuestName = GetCurrentActiveQuestMob()
        local hasTravelerQuest = activeQuestName and (string.find(string.lower(activeQuestName), "map") or string.find(string.lower(activeQuestName), "seasoned fishman") or string.find(string.lower(activeQuestName), "traveler"))
        
        if not hasTravelerQuest then
            local tPart = GetNPCPart("Traveler")
            if tPart then
                if (root.Position - tPart.Position).Magnitude > 15 then
                    TP(tPart.CFrame * CFrame.new(0, 5, 0))
                    return
                end
                StopTP()
                
                root.CFrame = CFrame.new((tPart.CFrame * CFrame.new(0, 0, 3.5)).Position, tPart.Position)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                
                _travelerAcceptAttempts = _travelerAcceptAttempts + 1
                
                -- Mở dialogue NPC Traveler & click Accept nhận quest
                OpenDialogueAndAccept("Traveler")
                pcall(function()
                    local questRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Chest")
                        and game:GetService("ReplicatedStorage").Chest:FindFirstChild("Remotes")
                        and game:GetService("ReplicatedStorage").Chest.Remotes:FindFirstChild("Functions")
                        and game:GetService("ReplicatedStorage").Chest.Remotes.Functions:FindFirstChild("Quest")
                    if questRemote then
                        questRemote:InvokeServer("talk", "Traveler")
                        questRemote:InvokeServer("take", "TravelerQuest")
                    end
                end)
                task.wait(2)
                
                local newActiveQuest = GetCurrentActiveQuestMob()
                local gotQuest = newActiveQuest and (string.find(string.lower(newActiveQuest), "map") or string.find(string.lower(newActiveQuest), "seasoned fishman") or string.find(string.lower(newActiveQuest), "traveler"))
                if gotQuest then
                    _travelerAcceptAttempts = 0
                elseif _travelerAcceptAttempts >= 4 then
                    print("[HuDy Hub]: Nhận quest Traveler thất bại 4 lần -> Tiến hành Reset nhân vật (Health = 0)...")
                    _travelerAcceptAttempts = 0
                    ResetCharacter()
                end
                return
            else
                TP(CFrame.new(-3400, 50, 4800))
                return
            end
        end

        -- BƯỚC 2: Đã có Quest & Chưa có Map -> Đánh Seasoned Fishman [Lv. 2200] đến khi rơi Map
        local bossMap, bossRoot = FindMob("Seasoned Fishman")
        if bossMap and bossRoot then
            local distance = 10
            local targetCFrame = bossRoot.CFrame * CFrame.new(0, distance, 0) * CFrame.Angles(math.rad(-90), 0, 0)
            TP(targetCFrame, bossRoot.Position)
            Attack(bossRoot)
        else
            TP(CFrame.new(-1858.9, 45.2, 6711.0))
            task.wait(1)
        end
    end

    -- Legacy duplicate: auto stats đã được điều phối ở KAITUN AUTO STATS.
    if false then
    task.spawn(function()
        while task.wait(0.5) do
            pcall(function()
                local statsFolder = LocalPlayer:FindFirstChild("PlayerStats")
                local pointsObj = statsFolder and (statsFolder:FindFirstChild("Point") or statsFolder:FindFirstChild("Points") or statsFolder:FindFirstChild("point"))
                
