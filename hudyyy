    local backpack = LocalPlayer:FindFirstChild("Backpack") or LP:FindFirstChild("Backpack")
    local humanoid = char and char:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end

    -- 1. Nếu Character đang cầm sẵn Basic Rod -> Xong
    local cur = char:FindFirstChild("Basic Rod") or char:FindFirstChild("BasicRod")
    if cur then
        return true
    end

    -- 2. Nếu trong Backpack có Basic Rod -> Trang bị lên tay
    local tool = backpack and (backpack:FindFirstChild("Basic Rod") or backpack:FindFirstChild("BasicRod"))
    if tool then
        humanoid:EquipTool(tool)
