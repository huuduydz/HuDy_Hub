    local bosses = {}
    if allowedBosses.HydraSeaKing then table.insert(bosses, "HydraSeaKing") end
    if allowedBosses.SeaKing then table.insert(bosses, "SeaKing") end
    if allowedBosses.GhostShip then table.insert(bosses, "Ghost Ship") end
    for _, folder in ipairs(bossFolders) do
        if folder then
            for _, bossName in ipairs(bosses) do
                local boss = folder:FindFirstChild(bossName)
                if boss then
                    local hum = boss:FindFirstChildOfClass("Humanoid") or boss:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local hrp = boss:FindFirstChild("HumanoidRootPart") or boss:FindFirstChild("Torso") or boss:FindFirstChild("Engine") or boss.PrimaryPart or boss:FindFirstChildWhichIsA("BasePart")
