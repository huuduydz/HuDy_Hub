    local function GetCurrentActiveQuestMob()
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if not gui then return nil end
        local qGui = gui:FindFirstChild("QuestGui")
        if qGui and qGui:FindFirstChild("MainFrame") and qGui.MainFrame.Visible then
            local qTitle = qGui.MainFrame:FindFirstChild("QuestName") or qGui.MainFrame:FindFirstChildWhichIsA("TextLabel")
            if qTitle and qTitle.Text ~= "" then return string.lower(qTitle.Text) end
        end
        for _, v in pairs(gui:GetDescendants()) do
            if v:IsA("TextLabel") and v.Visible and (string.find(string.lower(v.Text), "progress") or string.find(v.Text, "0/")) then
                local p = v.Parent
                if p then 
                    for _, child in pairs(p:GetChildren()) do 
                        if child:IsA("TextLabel") and child ~= v and string.len(child.Text) > 2 then 
