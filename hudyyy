materialCacheData = {}
function HuDy.GetMaterialCount(matName)
    local count = nil

    -- Nguồn chính: StringValue PlayerStats.Material. Cách này không phụ thuộc việc
    -- Inventory GUI đã mở/load hay chưa và tránh đọc sai 0 lúc chuyển Sea.
    pcall(function()
        local stats = LocalPlayer:FindFirstChild("PlayerStats")
        local materialValue = stats and stats:FindFirstChild("Material")
        if materialValue and type(materialValue.Value) == "string" then
            local raw = materialValue.Value
            if raw ~= materialCacheRaw then
                materialCacheRaw = raw
                materialCacheData = {}
                local decoded = HttpService:JSONDecode(raw)
                materialCacheData = type(decoded) == "table" and decoded or {}
            end
            local direct = materialCacheData[matName]
            if direct == nil and (matName == "Rusted Scrap" or matName == "RustedScrap") then
                direct = materialCacheData["Rusted Scrap"] or materialCacheData["RustedScrap"] or materialCacheData["Scrap"] or materialCacheData["Rusted_Scrap"]
            end
            if direct == nil and (matName == "Log" or matName == "Logs") then
                direct = materialCacheData["Log"] or materialCacheData["Logs"]
            end
            if direct == nil then
                local lowerMat = string.lower(matName)
                for k, v in pairs(materialCacheData) do
                    local lk = string.lower(tostring(k))
                    if lk == lowerMat or (lowerMat == "rusted scrap" and (lk:find("rusted", 1, true) or lk:find("scrap", 1, true))) then
                        direct = v
                        break
                    end
                end
            end
            if direct ~= nil then count = tonumber(direct) or 0 end
        end
    end)

    if count ~= nil then return count end

    -- Fallback: đọc Inventory GUI cho các phiên bản game không có Material StringValue.
    count = 0
    pcall(function()
        local pgui = LocalPlayer:FindFirstChild("PlayerGui")
        local mainGui = pgui and pgui:FindFirstChild("MainGui")
        local starterFrame = mainGui and mainGui:FindFirstChild("StarterFrame")
        local invFrame = starterFrame and starterFrame:FindFirstChild("Inventory_Frame")
        local scrollMat = invFrame and invFrame:FindFirstChild("ScrollingFrameMaterial")
        if scrollMat then
            local mat = scrollMat:FindFirstChild(matName)
            if not mat and (matName == "Rusted Scrap" or matName == "RustedScrap") then
                mat = scrollMat:FindFirstChild("Rusted Scrap") or scrollMat:FindFirstChild("RustedScrap") or scrollMat:FindFirstChild("Scrap")
            end
            if not mat and (matName == "Log" or matName == "Logs") then
                mat = scrollMat:FindFirstChild("Log") or scrollMat:FindFirstChild("Logs")
            end
            if not mat then
                local lowerMat = string.lower(matName)
                for _, child in ipairs(scrollMat:GetChildren()) do
                    local lcn = string.lower(child.Name)
                    if lcn == lowerMat or (lowerMat == "rusted scrap" and (lcn:find("rusted", 1, true) or lcn:find("scrap", 1, true))) then
                        mat = child
                        break
                    end
                end
            end
            if mat then
                for _, v in ipairs(mat:GetDescendants()) do
                    if v:IsA("TextLabel") then
                        local text = string.gsub(v.Text, ",", "")
                        if tonumber(text) then
                            count = tonumber(text)
                            break
                        end
                    end
                end
                if count == 0 then count = 1 end
            end
        end
    end)
    return count
end

