function HuDy.StartAutoHaki()
    -- Khi execute lại script, token mới khiến loop cũ tự dừng; tránh nhiều loop
    -- cùng gọi Armament/KenEvent trong một client.
    local token = {}
    _G.HuDyAutoHakiToken = token

    task.spawn(function()
        while _G.HuDyAutoHakiToken == token do
            task.wait(2)
            pcall(function()
                local chest = ReplicatedStorage:FindFirstChild("Chest")
                local remotes = chest and chest:FindFirstChild("Remotes")

                local autoBuso = HuDy.Flags.AutoBuso ~= false
                    and _G.AutoBuso ~= false and _G.buso ~= false
                if autoBuso then
                    local workshop = workspace:FindFirstChild("CharacterWorkshop")
                    local armamentActive = workshop
                        and workshop:FindFirstChild(LocalPlayer.Name .. "ArmamentGroup")
                    if workshop and not armamentActive then
                        local events = remotes and remotes:FindFirstChild("Events")
