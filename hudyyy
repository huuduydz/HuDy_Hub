-- HÀM LẤY ROOT PART CỦA BOSS TUYỆT ĐỐI CHÍNH XÁC (HỖ TRỢ MỌI MODEL ROBLOX)
function HuDy.GetMobRoot(mob)
    if not mob then return nil end
    if mob:IsA("BasePart") then return mob end
    if not mob:IsA("Model") and not mob:IsA("Folder") then return nil end

    local hrp = mob:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end

    if mob.PrimaryPart and mob.PrimaryPart:IsA("BasePart") then
        return mob.PrimaryPart
    end

    local namedParts = {"Torso", "UpperTorso", "LowerTorso", "Head", "Hitbox", "Main", "Root"}
    for _, partName in ipairs(namedParts) do
        local p = mob:FindFirstChild(partName)
        if p and p:IsA("BasePart") then return p end
    end

    -- Đệ quy tìm BasePart bất kỳ trong Model
    local bp = mob:FindFirstChildWhichIsA("BasePart", true)
    if bp then return bp end

    -- Quét toàn bộ Descendants tìm BasePart
    for _, desc in ipairs(mob:GetDescendants()) do
        if desc:IsA("BasePart") then
            return desc
        end
    end

    return nil
end

function HuDy.ScanFourDirectionsForBoss()
    if HuDy.IsScanningDirections then return nil, nil end
    HuDy.IsScanningDirections = true

    local root = GetRootPart()
    local char = LocalPlayer.Character
    if not root or not char then
        HuDy.IsScanningDirections = false
        return nil, nil
    end

    -- Tâm quét xuất phát từ đảo Spawn (The Unearthly) ở độ cao an toàn Y = 65
    local basePos = Vector3.new(1550.5, 65, 970.8)

    -- 4 Hướng cách 5000 studs: Đông (+X), Tây (-X), Bắc (+Z), Nam (-Z)
    local directions = {
        { name = "Đông (+X 5000)", cf = CFrame.new(basePos.X + 5000, 65, basePos.Z) },
        { name = "Tây (-X 5000)", cf = CFrame.new(basePos.X - 5000, 65, basePos.Z) },
        { name = "Bắc (+Z 5000)", cf = CFrame.new(basePos.X, 65, basePos.Z + 5000) },
        { name = "Nam (-Z 5000)", cf = CFrame.new(basePos.X, 65, basePos.Z - 5000) },
    }

    local setSailList = {"df_inferno", "ds_crusher", "abyssal", "chaos_kraken", "serpent"}
    print("[Set Sail Scan]: 🌊 Bắt đầu tele 5000 studs 4 hướng để check xem Boss đã spawn chưa...")

    local foundMob = nil
    local foundKey = nil

    local ok, err = pcall(function()
        for idx, dir in ipairs(directions) do
            if isHoppingFinal then break end
            if not HuDy.IsCharacterReady() then break end

            CurrentStatusText = string.format("<b>Status:</b> [Sea 3] 🔍 Tele 5000 studs hướng %s (%d/4) kiểm tra Boss...", dir.name, idx)
            print(string.format("[Set Sail Scan]: 🔍 Teleport 5000 studs hướng %s (%d/4)...", dir.name, idx))

            -- Teleport đến vị trí 5000 studs
            HuDy.TP(dir.cf)

            -- Neo nhân vật lơ lửng an toàn trên mặt biển bằng BodyVelocity (tránh chìm nước chết do Fruit)
            local curRoot = GetRootPart()
            if curRoot then
                curRoot.CFrame = dir.cf
                pcall(function() curRoot.AssemblyLinearVelocity = Vector3.zero end)
                local bv = curRoot:FindFirstChild("HuDyScanBV")
                if not bv then
                    bv = Instance.new("BodyVelocity")
                    bv.Name = "HuDyScanBV"
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = Vector3.zero
                    bv.Parent = curRoot
                end
            end

            -- Chờ và quét lặp lại mỗi 0.25s (tối đa 1.5s) để server stream in chunks và entities
            local scanStart = tick()
            while (tick() - scanStart) < 1.5 do
                if isHoppingFinal then break end
                if not HuDy.IsCharacterReady() then break end

                local r = GetRootPart()
                if r then
                    r.CFrame = dir.cf
                    pcall(function() r.AssemblyLinearVelocity = Vector3.zero end)
                end

                -- Quét kiểm tra tất cả các boss Set Sail
                for _, key in ipairs(setSailList) do
                    if not HuDy.IsBossEnabled or HuDy.IsBossEnabled(key) then
                        local m = HuDy.CheckBossAlive(key)
                        if m then
                            foundMob = m
                            foundKey = key
                            print(string.format("[Set Sail Scan]: 🎯 PHÁT HIỆN BOSS %s tại hướng %s! Đang khóa mục tiêu & tấn công...", tostring(m.Name), dir.name))
                            
                            -- Khóa mục tiêu và lập tức tiếp cận đánh ngay
                            local bRoot = HuDy.GetMobRoot(m)
                            if bRoot then
                                HuDy.EquipBestSerpentSword()
                                local dist = _G.SetSailDistance or 45
                                local targetCF = CFrame.new(bRoot.Position + Vector3.new(0, dist, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                                HuDy.TP(targetCF, bRoot.Position)
                                HuDy.Attack(bRoot)
                                HuDy.WasFightingSetSail = true
                                HuDy.LastFightingBossKey = key
                                HuDy.LastFightingBossName = tostring(m.Name)
                                HuDy.LastSeenFightingBossTick = tick()
                                HuDy.HasScannedDirectionsThisServer = false
                            end
                            break
                        end
                    end
                end

                if foundMob then break end
                task.wait(0.25)
            end

            if foundMob then
                break
            end
        end
    end)

    -- Dọn dẹp BodyVelocity neo lơ lửng
    local curRoot = GetRootPart()
    if curRoot and curRoot:FindFirstChild("HuDyScanBV") then
        pcall(function() curRoot.HuDyScanBV:Destroy() end)
    end

    HuDy.IsScanningDirections = false

    if not ok then
        print("[Set Sail Scan]: ⚠️ Quét 4 hướng gặp lỗi: " .. tostring(err))
    end

    if foundMob then
        HuDy.HasScannedDirectionsThisServer = false -- Reset vì ĐÃ TÌM THẤY BOSS!
        return foundMob, foundKey
    else
        HuDy.HasScannedDirectionsThisServer = true
        print("[Set Sail Scan]: ❌ Đã tele đủ 4 hướng 5000 studs nhưng không thấy Boss (hoặc lỗi). Sẽ tiếp tục Hop...")
        return nil, nil
    end
end

