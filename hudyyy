                    for _, obj in ipairs(isl:GetDescendants()) do 
                        if obj:IsA("Model") and string.match(obj.Name, "Chest$") and obj:GetPivot().Position.Y > -5 then 
                            hasChest = true; break 
                        end 
                    end
                    if hasChest then table.insert(targets, {cframe = isl.ChestSpawner.CFrame * CFrame.new(0, 1.5, 0), id = "SK_"..n}) end
                end
            end
        end
    end
    if allowedBosses.GhostShip then
        for i = 1, 5 do 
            local c = workspace:FindFirstChild("Chest"..i)
            if c then
                local topPart = c:FindFirstChild("Top") or c:FindFirstChild("Lock") or (c:IsA("Model") and c.PrimaryPart)
                if topPart and topPart.Position.Y > -5 then 
                    table.insert(targets, {cframe = topPart.CFrame, id = "GS_"..i, isGS = true, instance = c}) 
