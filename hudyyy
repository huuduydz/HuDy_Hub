function HuDy.GetThirdSeaBossTimer()
    -- 1. Đọc thời gian của 4 loại Boss Set Sail từ LegacyPoseFrame.ThirdSea (Pose)
    local starterFrame = lplr.PlayerGui:FindFirstChild("MainGui") and lplr.PlayerGui.MainGui:FindFirstChild("StarterFrame")
    local poseFrame = starterFrame and starterFrame:FindFirstChild("LegacyPoseFrame")
    local thirdSeaFrame = poseFrame and poseFrame:FindFirstChild("ThirdSea")
    
    local foundSecs = nil
    local foundKey = nil
    local foundName = nil

    if thirdSeaFrame then
        for _, descendant in ipairs(thirdSeaFrame:GetDescendants()) do
            if descendant:IsA("TextLabel") and descendant.Text ~= "" and descendant.Text ~= "00:00:00" then
                local secs = ParseGUITimeToSeconds(descendant.Text)
                if secs ~= nil and secs > 0 then
                    foundSecs = secs
                    local n = descendant.Name and string.lower(descendant.Name) or ""
                    local parent = descendant.Parent
                    local pName = parent and string.lower(parent.Name) or ""
                    local combined = n .. " " .. pName
                    if string.find(combined, "ptera") then foundKey = "pteranodon"; foundName = "Pteranodon"
                    elseif string.find(combined, "draken") or string.find(combined, "inferno") then foundKey = "df_inferno"; foundName = "Drakenfyr"
                    elseif string.find(combined, "crusher") or string.find(combined, "deepsea") then foundKey = "ds_crusher"; foundName = "Deepsea Crusher"
                    elseif string.find(combined, "abyssal") or string.find(combined, "tyrant") then foundKey = "abyssal"; foundName = "Abyssal Tyrant"
                    elseif string.find(combined, "chaos") or string.find(combined, "kraken") then foundKey = "chaos_kraken"; foundName = "Chaos Kraken"
                    end
                    break
                end
            end
        end
    end

    -- 2. Fallback: kiểm tra ảnh & thời gian trên Island.ThirdSeaEventChalice TimeBoard
    local chalice = workspace:FindFirstChild("Island") and workspace.Island:FindFirstChild("ThirdSeaEventChalice")
    if chalice then
        if not foundSecs then
            for _, d in ipairs(chalice:GetDescendants()) do
                if d:IsA("TextLabel") and d.Text ~= "" and d.Text ~= "00:00:00" then
                    local s = ParseGUITimeToSeconds(d.Text)
                    if s ~= nil and s > 0 then
                        foundSecs = s
                        break
                    end
                end
            end
        end
        if not foundKey then
            local chaliceImg = chalice:FindFirstChild("Model")
                and chalice.Model:FindFirstChild("Cube")
                and chalice.Model.Cube:FindFirstChild("TimeBoard")
                and chalice.Model.Cube.TimeBoard:FindFirstChild("ImageLabel")
            if chaliceImg and chaliceImg:IsA("ImageLabel") then
                local imgId = tostring(chaliceImg.Image)
                if string.find(imgId, "104776755060269") then foundKey = "abyssal"; foundName = "Abyssal Tyrant"
                elseif string.find(imgId, "17583135281") then foundKey = "chaos_kraken"; foundName = "Chaos Kraken"
                elseif string.find(imgId, "16741887011") then foundKey = "df_inferno"; foundName = "Drakenfyr"
                elseif string.find(imgId, "17583091055") then foundKey = "ds_crusher"; foundName = "Deepsea Crusher"
                end
            end
        end
    end

    if foundSecs and foundSecs > 0 then
        if not foundKey then foundKey = "df_inferno"; foundName = "Drakenfyr" end
        return foundKey, foundName, foundSecs
    end
    return nil, nil, nil
end

function HuDy.GetSerpentTimer()
    -- 1. Kiểm tra Serpent đang sống trên map
    if HuDy.CheckBossAlive and HuDy.CheckBossAlive("serpent") then
        return "serpent", "Sea Serpent", 300, true
    end
    
    -- 2. Kiểm tra hiệu ứng xoáy nước Serpent Whirlpool
    local wp = workspace:FindFirstChild("Effects") and workspace.Effects:FindFirstChild("SerpentWhirlpool")
    if wp then
        return "serpent", "Sea Serpent", 300, true
    end

    -- 3. Canh mốc chu kỳ 1h30m (5400 giây) tính từ 0h00 uptime của server (workspace.DistributedGameTime)
    local SERPENT_CYCLE = 5400 -- 1 tiếng 30 phút = 90 * 60 giây
    local uptime = (workspace and workspace.DistributedGameTime) or 0
    if uptime > 0 then
        local elapsed = uptime % SERPENT_CYCLE
        -- Trong vòng 10 phút đầu (0 - 600s sau mốc 1h30m): Serpent trong khung giờ spawn / đang hoạt động
        if elapsed <= 600 then
            local remainLive = math.max(60, math.floor(600 - elapsed))
            return "serpent", "Sea Serpent", remainLive, true
        else
            -- Ngoài khung giờ: tính số giây còn lại đến mốc 1h30m tiếp theo
            local remainingSecs = math.floor(SERPENT_CYCLE - elapsed)
            return "serpent", "Sea Serpent", remainingSecs, false
        end
    end
    return nil, nil, nil, false
end

function HuDy.HandleBossKilledSetSail(killedKey, killedName)
    if HuDy and HuDy.Core and HuDy.Core.HandleBossKilledSetSail then
        return HuDy.Core.HandleBossKilledSetSail(killedKey, killedName)
    end

    local kName = killedName or killedKey or "Boss Set Sail"
    print(string.format("[Sea 3 Boss] ⚔️ Đã tiêu diệt xong: %s (%s)! TP thẳng Sky Random & Xóa server...", tostring(kName), tostring(killedKey)))
    CurrentStatusText = string.format("<b>Status:</b> [Sea 3] Đã hạ %s! Bay Sky Random & Xóa server...", tostring(kName))

    HuDy.JustKilledBossOnThisServer = true

    -- 1. TP THẲNG SKY RANDOM NGAY LẬP TỨC KHÔNG CHỜ ĐỢI
    if HuDy.StopTP then HuDy.StopTP() end
    if HuDy.RandomSkyTP then HuDy.RandomSkyTP() end
    HuDy.SkySafeUntil = tick() + 6

    -- 2. Blacklist server vừa đánh boss để không bao giờ hop lại trong 15 phút
    if game.JobId and game.JobId ~= "" then
        if HuDy.RecentKilledBossServers then HuDy.RecentKilledBossServers[game.JobId] = os.time() end
        if sessionIgnoredServers then sessionIgnoredServers[game.JobId] = true end
        pcall(function()
            if saveTeleportedServers then saveTeleportedServers(game.JobId) end
            if AddToBlacklist2 then AddToBlacklist2(game.JobId) end
            if AddToBlacklist1 then AddToBlacklist1(game.JobId) end
        end)
    end

    -- 3. BÁO TỬ XÓA SERVER / BOSS VỪA CHẾT TRÊN API CLOUD
    local rptDead = (HuDy and HuDy.Core and HuDy.Core.ReportDeadServerToAPI) or ReportDeadServerToAPI
    if rptDead then
        pcall(function() rptDead(killedKey) end)
    end

    task.wait(0.5)

    if killedKey == "serpent" then
        if rptDead then pcall(function() rptDead() end) end
        if _G.AutoHopSetSail then
            HuDy.HopSetSailServer()
        end
        return
    end

    -- 4. 4 Boss Set Sail: Mở LegacyPoseFrame để game kích hoạt đồng bộ dữ liệu thời gian Pose
    pcall(function()
        local ClientBeckUI = game:GetService("ReplicatedStorage"):FindFirstChild("ClientBeckUI")
        if ClientBeckUI and ClientBeckUI:IsA("BindableEvent") then
            ClientBeckUI:Fire("LegacyPoseFrame", {Sea = "ThirdSea", VisibleType = true})
        end
    end)

    task.wait(1.5)

    -- Đọc thời gian spawn của 4 boss Set Sail từ GUI LegacyPoseFrame
    local nextKey, nextSecs = HuDy.GetNextSpawningSetSail()
    local earlyJoinSec = (type(_G) == "table" and type(_G.BossEarlyJoinSec) == "number") and _G.BossEarlyJoinSec or 90
    if earlyJoinSec < 60 then earlyJoinSec = 90 end

    local rptLive = (HuDy and HuDy.Core and HuDy.Core.ReportServerToAPI) or ReportServerToAPI
    if nextKey and nextSecs and nextSecs > 0 then
        if rptLive then pcall(function() rptLive(nextKey, nextSecs) end) end
    else
        if rptDead then pcall(function() rptDead() end) end
    end

    if _G.AutoHopSetSail then
        if not nextSecs or nextSecs <= 0 or nextSecs > (earlyJoinSec + 5) then
            HuDy.HopSetSailServer()
        end
    end
end
