-- Kiểm tra server có bị chặn trong blacklist hoặc đã ghé qua trong phiên chơi
function ServerHop:IsBlocked(jobId)
    if not jobId or jobId == "" or jobId == game.JobId then return true end
    if sessionIgnoredServers[jobId] or (AppData.blacklist2 and AppData.blacklist2[jobId]) or (AppData.visitedServers and AppData.visitedServers[jobId]) then return true end
    local gData = (type(getgenv) == "function" and getgenv().GlobalData) or {}
    return (gData.blacklist1 and gData.blacklist1[jobId]) and true or false
end

-- Kiểm tra server API có bị chặn (vừa hạ boss < 15 phút hoặc lỗi kết nối < 60 giây)
function ServerHop:IsApiBlocked(jobId)
    if not jobId or jobId == "" or jobId == game.JobId then return true, "Trùng server hiện tại" end
    if HuDy.RecentKilledBossServers and HuDy.RecentKilledBossServers[jobId] then
        local elapsed = os.time() - HuDy.RecentKilledBossServers[jobId]
        if elapsed < 900 then return true, string.format("Vừa đánh boss xong trên server này (%ds trước)", elapsed) end
        HuDy.RecentKilledBossServers[jobId] = nil
    end
    if self.FailedApiServers and self.FailedApiServers[jobId] then
        local elapsed = os.time() - self.FailedApiServers[jobId]
        if elapsed < 60 then return true, string.format("Lỗi kết nối gần đây (thử lại sau %ds)", 60 - elapsed) end
        self.FailedApiServers[jobId] = nil
    end
    return false, nil
end

function ServerHop:PushRuntimeStatus(currentSource, currentTarget, forcePush)
    if not Settings.UseAPI then return false end
    -- using safeRequest
    local nowClock = os.clock()
    if not forcePush and (nowClock - self.LastRuntimeStatusPush) < 10 then return false end
    self.LastRuntimeStatusPush = nowClock
    
    local cleanLink = GetRadarApiLink(self.Mode, GetSeaName())
    if cleanLink == "" then return false end
    local path = "/runtime-status"
    local body = HttpService:JSONEncode({
        jobId = game.JobId,
        serverName = string.sub(game.JobId, 1, 8),
        currentSource = tostring(currentSource or (self.CurrentTargetJobId and "targeting" or "idle")),
        currentTarget = tostring(currentTarget or self.CurrentTargetName or ""),
        serverPriority = tostring((type(getgenv) == "function" and getgenv().ServerPriority) or _G.ServerPriority or "hd"),
        reserveHydra = #(self.LocalPool.hydra or {}),
        reserveSeaKing = #(self.LocalPool.seaking or {}),
        reserveRandom = #(self.LocalPool.random or {}),
        sharedCount = 0,
        apiAvailable = cleanLink ~= "",
    })
    local hdrs, ts, sig = _SignedHeaders("POST", path, body)
    local signedUrl = _SignedUrl(cleanLink, path, ts, sig)
    task.spawn(function()
        pcall(function()
            safeRequest({ Url = signedUrl, Method = "POST", Headers = hdrs, Body = body })
        end)
    end)
    return true
end


-- Prefetch API nền: Lấy đồng thời cả danh sách Server Ready VÀ toàn bộ Server đã có trên API
function ServerHop:PrefetchApiAsync()
    if not Settings.UseAPI then return end

    local cleanLink, apiModeKey = GetRadarApiLink(self.Mode, GetSeaName())
    if cleanLink == "" then return end

    -- Khi đổi từ Blood Chest (Sea 2) sang Set Sails (Sea 3), bỏ toàn bộ queue
    -- và known-server cũ để không lấy nhầm dữ liệu từ worker còn lại.
    if self.ApiModeKey ~= apiModeKey then
        self.ApiModeKey = apiModeKey
        self.HasFetchedApi = false
        self.ApiQueue = {}
        self.ApiKnownServers = {}
    end
    if self.HasFetchedApi or self.IsFetchingApi then return end
    
    self.HasFetchedApi = true
    self.IsFetchingApi = true
    self.LastApiFetch = os.clock()
    
    -- ⏱️ Hard timeout watchdog: Sau tối đa 2.5s nếu API chưa trả về, tự động giải phóng cờ để hop sang Local Pool
    task.delay(2.5, function()
        if self.IsFetchingApi then
            self.IsFetchingApi = false
            warn(string.format("[ServerHop] ⏱️ Timeout gọi API Cloud (%s > 2.5s) -> Tự động chuyển quyền sang Local Pool!", tostring(apiModeKey)))
        end
    end)
    
    task.spawn(function()
        local okDashFetch, errDashFetch = pcall(function()
            local nowUnix = os.time()
            local dashData = nil
            local cacheAge = 0
            local apiCachePath = BaseFolder .. "/api_cache_" .. apiModeKey .. ".json"
            
            -- 1. Tận dụng Cache cục bộ (TTL 15s) tránh spam GET khi hop liên tục hoặc chạy nhiều acc trên cùng máy
            pcall(function()
                if isfile and readfile and isfile(apiCachePath) then
                    local rawCache = readfile(apiCachePath)
                    local okCache, parsedCache = pcall(function() return HttpService:JSONDecode(rawCache) end)
                    if okCache and type(parsedCache) == "table" and parsedCache.time then
                        local age = nowUnix - parsedCache.time
                        if age < 15 and type(parsedCache.data) == "table" then
                            dashData = parsedCache.data
                            cacheAge = math.max(0, age)
                        end
                    end
                end
            end)
            
            -- 2. Nếu cache hết hạn, chỉ gọi DUY NHẤT 1 Request GET /get-dashboard (thêm ?_t= để bypass Cloudflare Edge Cache)
            if not dashData then
                local dashRes = safeRequest({
                    Url = cleanLink .. "/get-dashboard?_t=" .. tostring(nowUnix),
                    Method = "GET",
                    Headers = { ["Content-Type"] = "application/json" },
                    Timeout = 3
                })
                local dashSc = dashRes and (dashRes.StatusCode or dashRes.status)
                local dashBody = dashRes and (dashRes.Body or dashRes.body)
                if dashRes and dashSc == 200 and type(dashBody) == "string" and dashBody ~= "" then
                    local okDash, parsed = pcall(function() return HttpService:JSONDecode(dashBody) end)
                    if okDash and type(parsed) == "table" then
                        dashData = parsed
                        pcall(function()
                            if writefile then
                                writefile(apiCachePath, HttpService:JSONEncode({ time = nowUnix, data = parsed }))
                            end
                        end)
                    end
                end
            end
            
            -- 3. Xử lý dữ liệu từ dashData: Lấy cả Ready Server (active) và Reserve Server (reserve)
            local totalKnown = 0
            if type(dashData) == "table" then
                self.ApiQueue = {}
                
                -- Server Ready / Sắp ra Boss / Rương -> Đưa vào ApiQueue ưu tiên hop
                if type(dashData.active) == "table" then
                    for _, srv in ipairs(dashData.active) do
                        if type(srv) == "table" and srv.jobId then
                            local rawId = srv.jobId
                            if type(rawId) == "string" and string.match(rawId, "^HD_") then
                                rawId = _DecryptJobId(rawId)
                            end
                            if rawId and rawId ~= "" then
                                self.ApiKnownServers[rawId] = true
                                totalKnown = totalKnown + 1
                                local eKey = tostring(srv.entityKey or "")
                                local isChest = string.find(eKey, "chest") ~= nil or srv.isChest == true
                                local isIgnored = (rawId == game.JobId)
                                    or (HuDy.RecentKilledBossServers and HuDy.RecentKilledBossServers[rawId] ~= nil)
                                    or (sessionIgnoredServers and sessionIgnoredServers[rawId] == true)
                                if not isIgnored then
                                    local rawSpawnSecs = tonumber(srv.spawnInSeconds) or 0
                                    local adjSpawnSecs = math.max(0, rawSpawnSecs - cacheAge)
                                    local isLiveNow = (srv.isLive == true) or (adjSpawnSecs <= 0 and not isChest)
                                    table.insert(self.ApiQueue, {
                                        jobId = rawId,
                                        bossName = srv.title or srv.bossName or "Boss",
                                        entityKey = eKey,
                                        isChest = isChest,
                                        isLive = isLiveNow,
                                        spawnInSeconds = adjSpawnSecs,
                                        priorityScore = tonumber(srv.priorityScore) or 50,
                                    })
                                end
                            end
                        end
                    end
                end
                
                -- Server Reserve -> Ghi nhận vào ApiKnownServers để đối soát với GetServerLists
                if type(dashData.reserve) == "table" then
                    for _, srv in ipairs(dashData.reserve) do
                        if type(srv) == "table" and srv.jobId then
                            local rawId = srv.jobId
                            if type(rawId) == "string" and string.match(rawId, "^HD_") then
                                rawId = _DecryptJobId(rawId)
                            end
                            if rawId and rawId ~= "" then
                                self.ApiKnownServers[rawId] = true
                                totalKnown = totalKnown + 1
                            end
                        end
                    end
                end
            end
            
            print(string.format("[API Cloud:%s] 📡 Lấy thành công %d server ready | Đã ghi nhận %d server có mặt trên API Cloud!", apiModeKey, #self.ApiQueue, totalKnown))
        end)
        if not okDashFetch then
            warn("[ServerHop] ⚠️ Lỗi khi nạp API Cloud: " .. tostring(errDashFetch))
        end
        self.IsFetchingApi = false
    end)
end

function ServerHop:FetchLocalServersAsync()
    if self.IsFetchingLocal then return end
    self.IsFetchingLocal = true
    
    task.spawn(function()
        local successScan, errScan = pcall(function()
            UpdateStatusUI("Đang clone toàn bộ Server Local...")
            
            -- 1. Tìm RemoteFunction GetServerLists
            local getSrvFunc = nil
            pcall(function()
                local chest = ReplicatedStorage:FindFirstChild("Chest") or ReplicatedStorage:WaitForChild("Chest", 2)
                if chest then
                    local assets = chest:FindFirstChild("Assets") or chest:WaitForChild("Assets", 1)
                    local modules = assets and (assets:FindFirstChild("Modules") or assets:WaitForChild("Modules", 1))
                    local net = modules and (modules:FindFirstChild("Network") or modules:WaitForChild("Network", 1))
                    local clientNet = net and (net:FindFirstChild("ClientNetwork") or net:WaitForChild("ClientNetwork", 1))
                    getSrvFunc = clientNet and (clientNet:FindFirstChild("GetServerLists") or clientNet:WaitForChild("GetServerLists", 1))
                end
            end)
            
            local uniqueServers = {}
            local serverCount = 0
            local attempts = 0
            local maxAttempts = 6
            
            local parseList = function(rawList)
                if type(rawList) == "table" then
                    for k, srv in pairs(rawList) do
                        if type(srv) == "table" then
                            local jId = srv.JobId or srv.jobId or srv.id
                            if not jId then
                                if type(k) == "string" and string.len(k) == 36 and string.match(k, "%-") then
                                    jId = k
                                    srv.JobId = k
                                else
                                    for _, v in pairs(srv) do
                                        if type(v) == "string" and string.len(v) == 36 and string.match(v, "%-") then
                                            jId = v
                                            srv.JobId = v
                                            break
                                        end
                                    end
                                end
                            end
                            if jId and not uniqueServers[jId] then
                                uniqueServers[jId] = srv
                                serverCount = serverCount + 1
                            end
                        end
                    end
                end
            end
            
            -- Vòng lặp gom TOÀN BỘ server từ GetServerLists
            while attempts < maxAttempts do
                attempts = attempts + 1
                
                if typeof(getSrvFunc) == "Instance" then
                    local ok, rawList = pcall(function() return getSrvFunc:InvokeServer() end)
                    if ok and rawList then
                        parseList(rawList)
                    end
                end
                
                if serverCount >= 250 or (serverCount > 0 and attempts >= 2) then
                    break -- Đã clone trọn vẹn toàn bộ danh sách server
                else
                    UpdateStatusUI(string.format("Đang clone Server Local (%d)...", serverCount))
                    task.wait(0.3)
                end
            end
            
            if serverCount > 0 then
                self.HasFetchedLocal = true
                self.LocalPool = { serpent = {}, newToScout = {}, random = {}, hydra = {}, seaking = {} }
                local gData = (type(getgenv) == "function" and getgenv().GlobalData) or {}
                local gBlacklist = (type(gData) == "table" and gData.blacklist1) or {}
                local appBlacklist = (type(AppData) == "table" and AppData.blacklist2) or {}
                local appVisited = (type(AppData) == "table" and AppData.visitedServers) or {}
                
                local alreadyOnApiCount = 0
                local newToScoutCount = 0
                local serpentWindowCount = 0
                local currentTime = os.time()
                
                for jobId, srv in pairs(uniqueServers) do
                    local players = tonumber(srv.PlayerCount) or 12
                    local name = srv.Name or "Unknown"
                    
                    -- Chỉ xét các server hợp lệ khác server hiện tại
                    local isBasicValid = (jobId ~= game.JobId) and (players > 0 and players < 12)
                    
                    if isBasicValid then
                        local isAlreadyOnApi = self.ApiKnownServers[jobId] ~= nil
                        local isAccountBlocked = self:IsBlocked(jobId)
                        
                        -- Tính khung giờ Serpent 1h30m (5400s) từ thời điểm server mở (CreatedAt/ServerOsTime)
                        local rawCreated = tonumber(srv.CreatedAt) or tonumber(srv.ServerOsTime) or tonumber(srv.createdAt)
                        if rawCreated and rawCreated > 1e11 then rawCreated = math.floor(rawCreated / 1000) end
                        local isSerpentWindow = false
                        if rawCreated and rawCreated > 0 then
                            local uptime = currentTime - rawCreated
                            if uptime >= 5400 then
                                local remainder = uptime % 5400
                                -- Khung giờ mốc 1h30m: trong vòng 10 phút sau mốc (0-600s), hoặc chuẩn bị đến mốc (5220-5399s)
                                if remainder <= 600 or remainder >= 5220 then
                                    isSerpentWindow = true
                                end
                            end
                        end
                        
                        if not isAccountBlocked then
                            if isSerpentWindow then
                                serpentWindowCount = serpentWindowCount + 1
                                table.insert(self.LocalPool.serpent, { JobId = jobId, Name = name, Uptime = (currentTime - (rawCreated or currentTime)) })
                            elseif not isAlreadyOnApi then
                                newToScoutCount = newToScoutCount + 1
                                table.insert(self.LocalPool.newToScout, { JobId = jobId, Name = name })
                            else
                                alreadyOnApiCount = alreadyOnApiCount + 1
                                table.insert(self.LocalPool.random, { JobId = jobId, Name = name })
                            end
                        end
                    end
                end
                
                local totalAvailable = #self.LocalPool.serpent + #self.LocalPool.newToScout + #self.LocalPool.random
                -- Nếu tất cả server đều đã ghé qua trong session này, tự động xả sessionIgnoredServers
                if totalAvailable == 0 and serverCount > 0 then
                    sessionIgnoredServers = {}
                    for jobId, srv in pairs(uniqueServers) do
                        local players = tonumber(srv.PlayerCount) or 12
                        if jobId ~= game.JobId and players > 0 and players < 12 and not gBlacklist[jobId] and not appBlacklist[jobId] then
                            local rawCreated = tonumber(srv.CreatedAt) or tonumber(srv.ServerOsTime) or tonumber(srv.createdAt)
                            if rawCreated and rawCreated > 1e11 then rawCreated = math.floor(rawCreated / 1000) end
                            local isSerpentWindow = false
                            if rawCreated and rawCreated > 0 then
                                local uptime = currentTime - rawCreated
                                if uptime >= 5400 then
                                    local remainder = uptime % 5400
                                    if remainder <= 600 or remainder >= 5220 then
                                        isSerpentWindow = true
                                    end
                                end
                            end
                            if isSerpentWindow then
                                table.insert(self.LocalPool.serpent, { JobId = jobId, Name = srv.Name or "Unknown" })
                            elseif not self.ApiKnownServers[jobId] then
                                table.insert(self.LocalPool.newToScout, { JobId = jobId, Name = srv.Name or "Unknown" })
                            else
                                table.insert(self.LocalPool.random, { JobId = jobId, Name = srv.Name or "Unknown" })
                            end
                        end
                    end
                    totalAvailable = #self.LocalPool.serpent + #self.LocalPool.newToScout + #self.LocalPool.random
                end
                
                print(string.format("[Local Server] 📋 Clone thành công %d server từ GetServerLists | MỐC 1H30 SERPENT: %d | CHƯA CÓ TRÊN API: %d | ĐÃ CÓ TRÊN API: %d", 
                    serverCount, serpentWindowCount, newToScoutCount, alreadyOnApiCount))
                UpdateStatusUI(string.format("Serpent Mốc 1h30: %d | Server mới chưa có API: %d", #self.LocalPool.serpent, #self.LocalPool.newToScout))
                self:PushRuntimeStatus("local_pool", "scan_ready", true)
            else
                self.HasFetchedLocal = false
                print("[Local Server] ⚠️ Không lấy được server nào từ GetServerLists.")
                UpdateStatusUI("Quét server chưa có kết quả, thử lại...")
                self:PushRuntimeStatus("local_pool", "scan_failed", true)
                task.wait(1)
            end
        end)
        if not successScan then
            warn("[Local Server] ❌ Lỗi FetchLocalServersAsync: " .. tostring(errScan))
            task.wait(1)
        end
        self.IsFetchingLocal = false
    end)
end

function ServerHop:PullNextLocalServer()
    if not self.LocalPool then
        self.LocalPool = { serpent = {}, newToScout = {}, random = {}, hydra = {}, seaking = {} }
    end
    local pool = self.LocalPool
    pool.serpent = pool.serpent or {}
    pool.newToScout = pool.newToScout or {}
    pool.random = pool.random or {}
    pool.hydra = pool.hydra or {}
    pool.seaking = pool.seaking or {}

    -- 1. ƯU TIÊN 1: Random lấy server MỚI CHƯA CÓ TRÊN API để vào kiểm tra / scout đưa lên API Cloud
    -- Khi còn >= 10 server mới chưa scout thì ưu tiên tuyệt đối quét server mới trước:
    if #pool.newToScout >= 10 then
        local randomIndex = math.random(1, #pool.newToScout)
        return table.remove(pool.newToScout, randomIndex), "Scout Server Mới (Chưa có API)"
    end

    -- 2. ƯU TIÊN 2: Khi danh sách server mới chưa scout còn < 10 (gần hết server scout), mới nhảy vào KHUNG MỐC 1H30 CỦA SERPENT:
    if #pool.serpent > 0 then
        local randomIndex = math.random(1, #pool.serpent)
        return table.remove(pool.serpent, randomIndex), "Serpent Window (Khung 1h30m)"
    end

    -- 3. ƯU TIÊN 3: Nếu không có hoặc đã hết server Serpent khung 1h30, vét nốt các server newToScout còn lại (< 10):
    if #pool.newToScout > 0 then
        local randomIndex = math.random(1, #pool.newToScout)
        return table.remove(pool.newToScout, randomIndex), "Scout Server Mới (Chưa có API)"
    end

    -- 4. FALLBACK: Random các server còn lại
    if #pool.random > 0 then
        local randomIndex = math.random(1, #pool.random)
        return table.remove(pool.random, randomIndex), "Hop Server"
    end
    if allowedBosses and allowedBosses.HydraSeaKing and #pool.hydra > 0 then
        local randomIndex = math.random(1, #pool.hydra)
        return table.remove(pool.hydra, randomIndex), "Hydra Tier"
    end
    if allowedBosses and allowedBosses.SeaKing and #pool.seaking > 0 then
        local randomIndex = math.random(1, #pool.seaking)
        return table.remove(pool.seaking, randomIndex), "SeaKing Tier"
    end
    return nil, nil
end

function ServerHop:SelectNextTarget()
    local defaultEarlyJoin = (self.Mode == "set_sail") and 90 or 30
    local earlyJoinSec = (type(_G) == "table" and type(_G.BossEarlyJoinSec) == "number") and _G.BossEarlyJoinSec or defaultEarlyJoin
    if self.Mode == "set_sail" and earlyJoinSec < 60 then
        earlyJoinSec = 90
    end

    -- 1. Quản lý hàng đợi API Cloud (ƯU TIÊN 1)
    local activeApiLink = GetRadarApiLink(self.Mode, GetSeaName())
    if Settings.UseAPI and activeApiLink ~= "" then
        if not self.HasFetchedApi then
            self:PrefetchApiAsync()
        end
        
        if #self.ApiQueue == 0 and self.IsFetchingApi then
            local fetchElapsed = os.clock() - (self.LastApiFetch or 0)
            local pool = self.LocalPool
            local hasLocalReady = pool and (
                (pool.newToScout and #pool.newToScout > 0)
                or (pool.serpent and #pool.serpent > 0)
                or (pool.random and #pool.random > 0)
            )
            if fetchElapsed > 1.5 or (hasLocalReady and fetchElapsed > 1.0) then
                -- Bỏ qua chờ API, nhường quyền ngay cho Local Pool đã có sẵn server
                self.IsFetchingApi = false
            else
                return nil, nil, "api_fetching"
            end
        end
    end
    
    -- Đọc từ ApiQueue đã được prefetch sẵn (Ưu tiên 1 - chỉ vào nếu rương hoặc boss sắp spawn <= earlyJoinSec hoặc boss đang live)
    while #self.ApiQueue > 0 do
        local srv = table.remove(self.ApiQueue, 1)
        local rawId = srv.jobId
        if type(rawId) == "string" and string.match(rawId, "^HD_") then
            rawId = _DecryptJobId(rawId)
        end
        
        local shortId = string.sub(tostring(rawId or "unknown"), 1, 8)
        local eKey = string.lower(tostring(srv.entityKey or ""))
        local bossLabel = string.lower(tostring(srv.bossName or ""))
        local isPteradon = (eKey == "pteradon" or eKey == "pteranodon" or string.find(eKey, "ptera") ~= nil or string.find(bossLabel, "ptera") ~= nil)
        local isSetSail = not isPteradon and (eKey == "serpent" or eKey == "df_inferno" or eKey == "ds_crusher" or eKey == "abyssal" or eKey == "chaos_kraken")
        local isAllowedSetSail = isSetSail and (not HuDy.IsBossEnabled or HuDy.IsBossEnabled(eKey, bossLabel))
        local isAnyChest = srv.isChest == true or string.find(eKey, "chest", 1, true) ~= nil
        local isBloodChest = isAnyChest and (
            eKey == "chest_hd"
            or eKey == "chest_sk"
            or string.find(bossLabel, "hydra chest", 1, true)
            or string.find(bossLabel, "sea king chest", 1, true)
        )
        local matchesCurrentSea = false
        if self.Mode == "blood_chest" then
            matchesCurrentSea = isBloodChest and true or false
        elseif self.Mode == "set_sail" then
            matchesCurrentSea = isAllowedSetSail
        else
            matchesCurrentSea = not isSetSail
        end

        local isBlocked, blockReason = self:IsApiBlocked(rawId)
        local isChest = isAnyChest
        local spawnInSeconds = tonumber(srv.spawnInSeconds) or 0
        local isTimingReady = isChest or (spawnInSeconds <= earlyJoinSec) or srv.isLive

        if isPteradon then
            print(string.format("[API Cloud:%s] ⏩ Bỏ qua server %s: Pteradon đã bị loại bỏ khỏi danh sách săn boss", self.Mode, shortId))
        elseif not matchesCurrentSea then
            if self.Mode == "set_sail" and isSetSail and not isAllowedSetSail then
                print(string.format("[API Cloud:%s] ⏩ Bỏ qua server %s: Boss '%s' (%s) đã bị tắt trong _G.BossFarm", self.Mode, shortId, tostring(srv.bossName), eKey))
            end
        elseif isBlocked then
            print(string.format("[API Cloud:%s] ⏩ Bỏ qua server %s (%s): %s", self.Mode, shortId, tostring(srv.bossName), tostring(blockReason or "Bị chặn")))
        elseif not isTimingReady then
            print(string.format("[API Cloud:%s] ⏩ Bỏ qua server %s (%s): Chưa đến giờ spawn (còn %ds > %ds BossEarlyJoinSec)", self.Mode, shortId, tostring(srv.bossName), spawnInSeconds, earlyJoinSec))
        else
            -- ĐỦ TẤT CẢ ĐIỀU KIỆN -> CHẤP NHẬN HOP VÀO SERVER NÀY!
            local waitInfo = isChest and " [RƯƠNG-VÀO NGAY]" or (srv.isLive and " [ĐANG ALIVE]" or string.format(" [Spawn: %ds]", spawnInSeconds))
            print(string.format("[API Cloud:%s] 🚀 CHẤP NHẬN SERVER READY: %s | Boss: %s%s -> Đang Hop vào!", self.Mode, shortId, tostring(srv.bossName), waitInfo))
            return rawId, "API: " .. tostring(srv.bossName or "Boss") .. waitInfo, "api"
        end
    end
    
    -- 2. Ready JSON Pool (HuDy Hub/ready.json - chỉ dùng cho Sea 2 / Blood Chest) (ƯU TIÊN 2)
    if self.Mode ~= "set_sail" then
        local readyCandidates = ReadyTracker:GetCandidateServers()
        for _, srv in ipairs(readyCandidates) do
            local rawId = srv.jobId
            local readyKey = string.lower(tostring(srv.targetType or ""))
            local readyLabel = string.lower(tostring(srv.bossName or ""))
            local readyIsChest = srv.isChest == true or string.find(readyKey, "chest", 1, true) ~= nil
            local readyIsBloodChest = readyIsChest and (
                readyKey == "chest_hd"
                or readyKey == "chest_sk"
                or string.find(readyLabel, "hydra chest", 1, true)
                or string.find(readyLabel, "sea king chest", 1, true)
            )
            local readyMatchesMode = (self.Mode == "blood_chest" and readyIsBloodChest)
                or (self.Mode ~= "blood_chest" and not readyIsChest)
            local isBlocked = self:IsApiBlocked(rawId)
            if readyMatchesMode and not isBlocked then
                local waitInfo = srv.isChest and " [RƯƠNG-READY]" or string.format(" [READY: còn %ds]", math.ceil(srv.remainingReadyTime))
                return rawId, "Ready JSON: " .. tostring(srv.bossName or "Boss") .. waitInfo, "ready_json"
            end
        end
    end
    
    -- 3. Local Server Pool (GetServerLists:InvokeServer() - fallback quét server khi chưa có server nào đến giờ spawn) (ƯU TIÊN 3)
    local nextLocal, localType = self:PullNextLocalServer()
    if nextLocal and nextLocal.JobId then
        return nextLocal.JobId, localType .. " - " .. (nextLocal.Name or "..."), "local"
    end
    
    -- 4. Kích hoạt quét lại nếu pool trống
    if not self.IsFetchingLocal then
        self:FetchLocalServersAsync()
    end
    
    return nil, nil, "local_fetching"
end

function ServerHop:ExecuteTeleport(jobId, serverName, sourceTag)
    if not jobId or jobId == "" then return false end
    
    local nowClock = os.clock()
    self.LastAttemptTime = nowClock
    self.CurrentTargetJobId = jobId
    self.CurrentTargetName = serverName or "Server Hop"
    self.IsTeleportInProgress = true
    self.LastWatchdogResetTime = nowClock
    
    UpdateStatusUI("⚡ HOP: " .. tostring(self.CurrentTargetName))
    print(string.format("[ServerHop] ⚡ TIẾN HÀNH HOP VÀO: %s (JobId: %s | Nguồn: %s)", tostring(self.CurrentTargetName), string.sub(jobId, 1, 8), tostring(sourceTag or "local")))
    self:PushRuntimeStatus(sourceTag or "targeting", self.CurrentTargetName, true)
    
    -- Ghi nhận lịch sử Hop (non-blocking) & Blacklist cache
    AppData.prevServer = game.JobId
    sessionIgnoredServers[jobId] = true
    if game.JobId and game.JobId ~= "" then
        sessionIgnoredServers[game.JobId] = true
    end
    pcall(function()
        saveTeleportedServers(game.JobId)
        saveTeleportedServers(jobId)
    end)
    task.spawn(function() pcall(SaveAppData) end)
    
    -- Đăng ký QueueOnTeleport TRƯỚC khi teleport
    pcall(function()
        local queue_func = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        if queue_func then
            queue_func('loadstring(game:HttpGet("https://raw.githubusercontent.com/huuduydz/AutoSam_TpHome/refs/heads/main/bypassloading.lua"))()')
        end
    end)
    
    -- Bắn TeleportToPlaceInstance NGAY, cleanup chạy nền sau
    task.spawn(function()
        local playerToTeleport = lplr or LocalPlayer or (Players and Players.LocalPlayer)
        print(string.format("[ServerHop] 🚀 Đang gọi TeleportToPlaceInstance (PlaceId: %s | JobId: %s)...", tostring(game.PlaceId), string.sub(jobId, 1, 8)))
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, playerToTeleport)
        end)
        if not ok then
            warn("[ServerHop] ❌ TeleportToPlaceInstance error: " .. tostring(err))
            self:HandleTeleportFailure("Instance error: " .. tostring(err))
        end
    end)
    
    -- Cleanup tài nguyên nền SAU khi đã bắn lệnh teleport
    task.defer(function()
        pcall(function() TaskCleaner:CleanAll() end)
    end)
    
    return true
end

function ServerHop:HandleTeleportFailure(reason)
    if self.IsRecoveringFromError then return end
    self.IsRecoveringFromError = true
    
    local waitDelay = tonumber(_G.HopSpeed) or 1
    if self.CurrentTargetJobId then
        self.FailedApiServers = self.FailedApiServers or {}
        self.FailedApiServers[self.CurrentTargetJobId] = os.time()
        sessionIgnoredServers[self.CurrentTargetJobId] = true
        pcall(function()
            saveTeleportedServers(self.CurrentTargetJobId)
            AddToBlacklist2(self.CurrentTargetJobId)
        end)
    end
    
    warn(string.format("[ServerHop] ⚡ Server gặp lỗi/Full (%s) -> Chờ %s giây (HopSpeed) trước khi hop server tiếp theo...", tostring(reason or "Unknown"), tostring(waitDelay)))
    UpdateStatusUI(string.format("⚡ Server Full/Lỗi! Chờ %.1fs để hop tiếp...", waitDelay))
    
    if waitDelay > 0 then
        task.wait(waitDelay)
    end
    
    pcall(function() GuiService:ClearError() end)
    self.IsTeleportInProgress = false
    self.IsRecoveringFromError = false
end

function ServerHop:StartHopLoop()
    if self.IsHopping then return end
    self.IsHopping = true
    isHoppingFinal = true
    AppData.isHopping = true
    task.spawn(function() pcall(SaveAppData) end)
    
    -- ⚡ PRE-WARM: Kích hoạt fetch song song ngay lập tức trước khi vào vòng lặp
    self:PrefetchApiAsync()          -- Fetch API best-servers nền ngay
    self:FetchLocalServersAsync()    -- Fetch GetServerLists nền ngay
    self.CurrentSourceTag = "local"  -- Theo dõi loại server đang hop
    
    -- Auto Prompt Watcher (Tương thích 100% với Tool Rejoin ngoài)
    if not self.PromptWatcherRunning then
        self.PromptWatcherRunning = true
        task.spawn(function()
            local DisconnectErrors = (Enum.ConnectionError and Enum.ConnectionError.DisconnectErrors and Enum.ConnectionError.DisconnectErrors.Value) or 256
            local PlaceLaunchOtherError = (Enum.ConnectionError and Enum.ConnectionError.PlacelaunchOtherError and Enum.ConnectionError.PlacelaunchOtherError.Value) or 768

            while self.IsHopping do
                task.wait(0.5)
                pcall(function()
                    local core = (gethui and gethui()) or CoreGui
                    local promptGui = core:FindFirstChild("RobloxPromptGui")
                    if promptGui then
                        local promptOverlay = promptGui:FindFirstChild("promptOverlay")
                        if promptOverlay and promptOverlay:FindFirstChild("ErrorPrompt") then
                            local errorCode = 0
                            pcall(function() errorCode = GuiService:GetErrorCode().Value end)
                            
                            -- Nếu là lỗi Disconnect / Shutdown (Mất mạng, kick, mất session, server shutdown...)
                            -- -> TUYỆT ĐỐI GIỮ NGUYÊN BẢNG LỖI, KHÔNG gọi ClearError(), dừng hop
                            -- -> Để bảng lỗi hiển thị trên màn hình cho Tool Rejoin ngoài nhận diện và restart game!
                            local isDisconnect = (errorCode == 1 or (errorCode >= DisconnectErrors and errorCode < PlaceLaunchOtherError))
                            
                            if isDisconnect then
                                self.IsHopping = false
                                warn(string.format("[ServerHop] ⚠️ Phát hiện Disconnect/Shutdown Dialog (ErrorCode=%s) -> Giữ nguyên bảng lỗi cho Tool Rejoin!", tostring(errorCode)))
                                return
                            else
                                -- Lỗi Teleport thông thường (773, 769, 772, Server Full...) -> Chờ HopSpeed & Hop sang server khác
                                self:HandleTeleportFailure("Prompt Error: " .. tostring(errorCode))
                            end
                        end
                    end
                end)
            end
            self.PromptWatcherRunning = false
        end)
    end
    
    -- Main Non-blocking Turbo Hop Step Loop
    task.spawn(function()
        local lastStatusLog = 0
        while self.IsHopping do
            if not self.IsTeleportInProgress then
                local targetJobId, targetName, sourceTag = self:SelectNextTarget()
                if targetJobId then
                    self.CurrentSourceTag = sourceTag or "local"
                    self:ExecuteTeleport(targetJobId, targetName, sourceTag)
                else
                    local nowTick = os.clock()
                    if sourceTag == "api_fetching" then
                        UpdateStatusUI("Đang tải danh sách API Server...")
                        if nowTick - lastStatusLog > 2 then
                            lastStatusLog = nowTick
                            print("[ServerHop] ⏳ Đang nạp danh sách API Cloud...")
                        end
                        task.wait(0.15)
                    elseif sourceTag == "local_fetching" then
                        UpdateStatusUI("Đang clone Server Local...")
                        if nowTick - lastStatusLog > 2 then
                            lastStatusLog = nowTick
                            print("[ServerHop] ⏳ Đang clone danh sách Local Server...")
                        end
                        task.wait(0.2)
                    else
                        UpdateStatusUI("Đang quét danh sách server...")
                        task.wait(0.3)
                    end
                end
            else
                local timeout = math.max((tonumber(_G.HopSpeed) or 1) + 6, 8)
                local elapsed = os.clock() - (self.LastAttemptTime or 0)
                if elapsed > timeout then
                    self:HandleTeleportFailure("Treo game/Timeout")
                else
                    task.wait(0.01)
                end
            end
        end
    end)
end

