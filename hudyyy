    self:Load()
    local now = os.time()
    self.Data.servers[srvData.jobId] = {
        jobId = srvData.jobId,
        placeId = srvData.placeId or game.PlaceId,
        bossName = srvData.bossName or "Boss",
        targetType = srvData.targetType or "sk",
