function HuDy.CheckAndCraftBasicRod(bypassBisento)
    if not bypassBisento and not (_G.CraftRod == true) and not HuDy.HasBisento() then return false end
    if HuDy.HasBasicRod() then return false end

    local logCount = HuDy.GetMaterialCount("Log")
    local scrapCount = HuDy.GetMaterialCount("Rusted Scrap")
    local level = HuDy.GetCurrentLevel()

    -- 1. KIỂM TRA NGUYÊN LIỆU (THIẾU ĐI FARM NGAY CHO MỌI CẤP ĐỘ):
    -- 1A. Nếu thiếu Log (< 30) tại Sea 1 -> Tự động đi chặt cây thu thập đủ 30 Log
    if logCount < 30 and isSea1 then
        local rootPart = GetRootPart()
        if rootPart then
            CurrentStatusText = string.format("<b>Status:</b> [Craft Rod] Thiếu Log (%d/30) -> Chặt cây thu thập Log...", logCount)
            HuDy.ChopTree(rootPart)
            return true
        end
    end

    -- 1B. Nếu thiếu Rusted Scrap (< 10) tại Sea 1 -> Tự động farm Clown Swordman [Lv. 50] nhặt đủ 10 Rusted Scrap
    if scrapCount < 10 and isSea1 then
        CurrentStatusText = string.format("<b>Status:</b> [Craft Rod] Thiếu Rusted Scrap (%d/10) -> Farm Clown Swordman [Lv. 50]...", scrapCount)
        local clownData = {
            MobName = "Clown Swordman [Lv. 50]",
            CFrame = CFrame.new(-788.1, 43.6, -3465.6),
            SkipQuest = true,
            MaterialName = "Rusted Scrap",
            RequiredAmount = 10
        }
        HuDy.ExecuteQuestFarm(clownData)
        return true
    end

    -- 2. KHI ĐÃ ĐỦ CẢ 2 NGUYÊN LIỆU (Log >= 30 VÀ Rusted Scrap >= 10) -> MỚI ĐẾN NPC CHẾ TẠO
    local targetCF = CFrame.new(-371.1, 66.7, -3436.9)
    local root = GetRootPart()
    if root and (root.Position - targetCF.Position).Magnitude > 6 then
        CurrentStatusText = string.format("<b>Status:</b> [Craft Rod] Đã đủ Log (%d/30) & Scrap (%d/10) -> Đến NPC chế tạo...", logCount, scrapCount)
        HuDy.TP(targetCF)
        return true
    end

    -- 3. ĐÃ TỚI TỌA ĐỘ NPC -> DỪNG TP VÀ BẮN REMOTE CHẾ TẠO BASIC ROD
    HuDy.StopTP()
    local nowClock = os.clock()
    if not HuDy.LastCraftRodAttempt or (nowClock - HuDy.LastCraftRodAttempt) > 2.5 then
        HuDy.LastCraftRodAttempt = nowClock
        CurrentStatusText = "<b>Status:</b> [Craft Rod] Đã đến NPC -> Bắn Remote Craft Basic Rod..."
        print("[HuDy Hub]: Đã đủ nguyên liệu & tới NPC (-371.1, 66.7, -3436.9)! Bắn Remote Craft Basic Rod...")
        pcall(function()
            local args = {
                "Basic Rod",
                "CraftingUI2"
            }
            game:GetService("ReplicatedStorage"):WaitForChild("Chest"):WaitForChild("Remotes"):WaitForChild("Functions"):WaitForChild("CraftSword"):InvokeServer(unpack(args))
        end)
        task.wait(1.2)
        
        -- Sau khi craft, bắn Remote Equip để nhận / kích hoạt rod
        if HuDy.EquipFishingRod then
            HuDy.EquipFishingRod()
        end
        task.wait(0.5)

        if HuDy.HasBasicRod() then
            print("[HuDy Hub]: Chế tạo cần câu Basic Rod thành công!")
            if level >= 4000 then
                if HuDy.IsThirdSeaUnlocked() then
                    CurrentStatusText = "<b>Status:</b> [Craft Rod] Chế tạo Cần câu thành công! Đang quay lại Sea 3..."
                    HuDy.TeleportToThirdSea()
                elseif HuDy.IsSecondSeaUnlocked() then
                    CurrentStatusText = "<b>Status:</b> [Craft Rod] Chế tạo Cần câu thành công (Chưa mở Sea 3)! Dịch chuyển sang Sea 2..."
                    HuDy.TeleportToSecondSea()
                else
                    HuDy.RandomSkyTP(2)
                end
            elseif level >= 2250 and HuDy.IsSecondSeaUnlocked() then
                CurrentStatusText = "<b>Status:</b> [Craft Rod] Chế tạo Cần câu thành công! Dịch chuyển sang Sea 2..."
                HuDy.TeleportToSecondSea()
            else
                HuDy.RandomSkyTP(2)
            end
            return true
        end
    end

    return true
end

