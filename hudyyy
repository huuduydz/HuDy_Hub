function HuDy.IsBossEnabled(bossKeyOrName, extraLabel)
    local bf = _G.BossFarm
    if bf == nil and HuDy.Flags then
        bf = HuDy.Flags.BossFarm or HuDy.Flags.SelectedSetSailBosses
    end
    if not bf then return true end

    local raw = string.lower(tostring(bossKeyOrName or ""))
    local extra = string.lower(tostring(extraLabel or ""))

    -- Đã loại bỏ hoàn toàn Pteranodon / Pteradon khỏi hệ thống
    if string.find(raw, "ptera") or string.find(extra, "ptera") then
        return false
    end

    -- Chuẩn hóa tên định danh của 6 Boss Set Sail Sea 3
    local canonical = nil
    if string.find(raw, "abyssal") or string.find(raw, "seadragon") or string.find(extra, "abyssal") then
        canonical = "Abyssal Tyrant"
    elseif string.find(raw, "chaos") or string.find(raw, "kraken") or string.find(extra, "chaos") or string.find(extra, "kraken") then
        canonical = "Chaos Kraken"
    elseif string.find(raw, "draken") or string.find(raw, "inferno") or string.find(raw, "df_") or string.find(extra, "draken") or string.find(extra, "inferno") then
        canonical = "Drakenfyr"
    elseif string.find(raw, "crusher") or string.find(raw, "deepsea") or string.find(raw, "ds_") or string.find(raw, "crab") or string.find(extra, "crusher") or string.find(extra, "deepsea") or string.find(extra, "crab") then
        canonical = "Deepsea Crusher"
    elseif string.find(raw, "ptera") or string.find(extra, "ptera") then
        canonical = "Pteranodon"
    elseif string.find(raw, "serpent") or string.find(extra, "serpent") or raw == "sp" or extra == "sp" or string.find(raw, "sea_serpent") then
        canonical = "Sea Serpent"
    end

    -- 1. Tra cứu trực tiếp theo tên chuẩn hóa nếu có key trong dictionary
    if canonical then
        if bf[canonical] ~= nil then
            return (bf[canonical] == true)
        end
        if canonical == "Pteranodon" and bf["Pteradon"] ~= nil then
            return (bf["Pteradon"] == true)
        end
    end

    local hasStringKeys = false
    local hasArrayItems = false

    -- 2. Quét map boolean { ["Chaos Kraken"] = true } hoặc mảng { "Chaos Kraken", ... }
    for k, v in pairs(bf) do
        if type(k) == "string" then
            hasStringKeys = true
            local kStr = string.lower(k)
            if canonical and string.lower(canonical) == kStr then
                return (v == true)
            end
            if canonical == "Pteranodon" and kStr == "pteradon" then
                return (v == true)
            end
            if string.find(raw, kStr, 1, true) or string.find(extra, kStr, 1, true) or string.find(kStr, raw, 1, true) then
                return (v == true)
            end
        elseif type(v) == "string" then
            hasArrayItems = true
            local vStr = string.lower(v)
            if canonical and string.lower(canonical) == vStr then
                return true
            end
            if canonical == "Pteranodon" and vStr == "pteradon" then
                return true
            end
            if string.find(raw, vStr, 1, true) or string.find(extra, vStr, 1, true) or string.find(vStr, raw, 1, true) then
                return true
            end
        end
    end

    -- Nếu user có chỉ định danh sách/map nhưng boss này không có trong danh sách -> Không săn
    if hasStringKeys or hasArrayItems then
        return false
    end

    return true
end

