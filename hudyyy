    -- 8. Kiểm tra PlayerStats
    local stats = LocalPlayer:FindFirstChild("PlayerStats") or LP:FindFirstChild("PlayerStats")
    if stats then
        for _, object in ipairs(stats:GetDescendants()) do
            local objectName = NormalizeWeaponName(object.Name)
