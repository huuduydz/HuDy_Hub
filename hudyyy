function HuDy.HasTrickster()
    if HuDy.TricksterOwned then return true end

    local char = LocalPlayer.Character or LP.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack") or LP:FindFirstChild("Backpack")
    for _, container in ipairs({char, backpack}) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and string.find(string.lower(item.Name), "trickster") then
                    HuDy.TricksterOwned = true
                    return true
                end
            end
        end
    end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui") or LP:FindFirstChild("PlayerGui")
    local mainGui = playerGui and playerGui:FindFirstChild("MainGui")
    local starterFrame = mainGui and mainGui:FindFirstChild("StarterFrame")
    local inventory = starterFrame and starterFrame:FindFirstChild("Inventory_Frame")
    if inventory then
        for _, frameName in ipairs({"ScrollingFrameMelee", "ScrollingFrameFight", "ScrollingFrameFighting", "ScrollingFrameItems"}) do
            local f = inventory:FindFirstChild(frameName)
            if f and (f:FindFirstChild("Trickster") or f:FindFirstChild("Trickster Melee")) then
                HuDy.TricksterOwned = true
                return true
            end
        end
    end

    local stats = LocalPlayer:FindFirstChild("PlayerStats") or LP:FindFirstChild("PlayerStats")
    if stats then
        for _, obj in ipairs(stats:GetDescendants()) do
            local n = string.lower(string.gsub(obj.Name, "%s+", ""))
            if string.find(n, "trickster") then
                local val = tostring(obj.Value or "")
                if val ~= "" and val ~= "0" and val ~= "false" and string.lower(val) ~= "no" then
                    HuDy.TricksterOwned = true
                    return true
                end
            end
        end
    end

    return false
end

function HuDy.GetTrickshardCount()
    local c1 = HuDy.GetMaterialCount("Trickshard") or 0
    local c2 = HuDy.GetMaterialCount("Trick Shard") or 0
    local c3 = HuDy.GetMaterialCount("TrickShard") or 0
    local maxCount = math.max(c1, c2, c3)
    if maxCount > 0 then return maxCount end

    pcall(function()
        local stats = LocalPlayer:FindFirstChild("PlayerStats") or LP:FindFirstChild("PlayerStats")
        local matVal = stats and stats:FindFirstChild("Material")
        if matVal and type(matVal.Value) == "string" then
            local data = HttpService:JSONDecode(matVal.Value)
            if type(data) == "table" then
                for k, v in pairs(data) do
                    local lk = string.lower(tostring(k)):gsub("%s+", "")
                    if lk == "trickshard" or lk == "trickshards" then
                        local num = tonumber(v) or 0
                        if num > maxCount then maxCount = num end
                    end
                end
            end
        end
    end)
    return maxCount
end

