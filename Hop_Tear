    local potentialServers = {}
    for _, srv in pairs(srvs) do
        if type(srv)=="table" and srv.JobId and srv.JobId ~= game.JobId then
            local players = tonumber(srv.PlayerCount) or 12
            local createdAt = tonumber(srv.CreatedAt) or tonumber(srv.ServerOsTime)
            
            if players > 0 and players < 12 and createdAt and not AppData.visitedServers[srv.JobId] and not AppData.blacklist2[srv.JobId] then
                local uptime = os.time() - createdAt
                local currentCycle = uptime % CYCLE_TIME
                
                if uptime > 600 then
                    local priority = nil
                    -- Sắp xếp ưu tiên thời gian nở Ms.Mother
                    if currentCycle >= 7190 or currentCycle <= 30 then priority = 1
                    elseif currentCycle >= 7185 and currentCycle < 7190 then priority = 2                   
                    elseif currentCycle >= 7180 or currentCycle <= 30 then priority = 3 end
                    
                    if priority then
                        srv.Priority = priority
                        srv.Score = players
                        table.insert(potentialServers, srv)
                    end
                end
            end
        end
    end
    table.sort(potentialServers, function(a, b) 
        if a.Priority == b.Priority then return a.Score < b.Score else return a.Priority < b.Priority end
    end)
    return potentialServers
end

local isHoppingFinal = false
local function FinalHop()
    if isHoppingFinal then return end
    isHoppingFinal = true
    AppData.isHopping = true; SaveAppData()
    
    coroutine.wrap(function()
        local scanStartTime = os.clock() 
        while task.wait() do 
            if not isHoppingFinal then break end
            if not Settings.AutoMsMother then task.wait(0.5) else
                local elapsed = os.clock() - scanStartTime
                if elapsed >= 60 then
                    UpdateStatusUI("Qua 1p khong vao duoc, Hop ngau nhien...")
                    local getSrvFunc = nil
                    pcall(function() getSrvFunc = ReplicatedStorage:WaitForChild("Chest", 5):WaitForChild("Assets"):WaitForChild("Modules"):WaitForChild("Network"):WaitForChild("ClientNetwork"):WaitForChild("GetServerLists") end)
                    
                    if getSrvFunc then
                        local ok, allSrvs = pcall(function() return getSrvFunc:InvokeServer() end)
                        if ok and type(allSrvs) == "table" then
                            local randomServers = {}
                            for _, srv in pairs(allSrvs) do
                                local pCount = tonumber(srv.PlayerCount) or 12
                                if type(srv) == "table" and srv.JobId and srv.JobId ~= game.JobId and pCount > 0 and pCount < 12 then table.insert(randomServers, srv) end
                            end
                            if #randomServers > 0 then
                                local fallbackSrv = randomServers[math.random(1, #randomServers)]
                                UpdateStatusUI("Hop Random toi: " .. (fallbackSrv.Name or "Unknown"))
                                if isHoppingFinal then
                                    AppData.prevServer = game.JobId; SaveAppData()
                                    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, fallbackSrv.JobId, lplr) end)
                                end
                                task.wait(0.5) 
                            else scanStartTime = os.clock() end
                        end
                    end
                else
                    local srvList = getValidServersList()
                    if #srvList > 0 then
                        for i = 1, #srvList do
                            if not isHoppingFinal then break end 
                            local srv = srvList[i]
                            UpdateStatusUI("Tim thay Server VIP: " .. (srv.Name or "Unknown"))
                            for _ = 1, 3 do
                                task.spawn(function()
                                    pcall(function() 
                                        if isHoppingFinal then
                                            AppData.prevServer = game.JobId; SaveAppData(); sessionIgnoredServers[srv.JobId] = true; saveTeleportedServers(game.JobId); AddToBlacklist2(game.JobId)
                                            TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.JobId, lplr) 
                                        end
                                    end)
                                end)
                            end
                            task.wait(0.1)
                        end
                    else
                        local timeLeft = math.floor(60 - elapsed)
                        UpdateStatusUI("Quet Server Tear (" .. timeLeft .. "s)...")
                        task.wait(0.5) 
                    end
                end
            end
        end
    end)()
end

