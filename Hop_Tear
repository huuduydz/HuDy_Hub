                                        if part then
                                            if (root.Position - part.Position).Magnitude > 300 then
                                                UpdateStatusUI("Bay Den Bai...")
                                                root.CFrame = part.CFrame * CFrame.new(0, 200, 0)
                                                task.wait(1) 
                                                return
                                            end
                                            if isUnderTwoHours then UpdateStatusUI("Cho Boss Ra (" .. math.floor(7200 - cycle) .. "s)...") end
