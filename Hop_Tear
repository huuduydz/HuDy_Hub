            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, prevJobId, lplr) end)
            task.wait(4)
        end
        local req = getReq
        if req then
            pcall(function()
                local response = req({ Url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100", Method = "GET" })
                if response and response.Body then
                    local data = HttpService:JSONDecode(response.Body)
                    if data and data.data then
                        local srvs = {}
                        for _, s in pairs(data.data) do
                            if type(s) == "table" and s.id and s.playing and s.maxPlayers and s.playing < s.maxPlayers - 1 and s.id ~= game.JobId then table.insert(srvs, s.id) end
                        end
                        if #srvs > 0 then
                            local rId = srvs[math.random(1, #srvs)]
                            UpdateStatusUI("Reconnect vao Server ngau nhien...")
                            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, rId, lplr) end)
                        end
                    end
                end
            end)
        end
    end)
    coroutine.wrap(function() task.wait(5); while task.wait(3) do pcall(function() TeleportService:Teleport(game.PlaceId, lplr) end) end end)()
end

