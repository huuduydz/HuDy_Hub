    frame3.Size = UDim2.fromOffset(46, 46)
    frame3.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
    frame3.BackgroundTransparency = 1
    frame3.BorderSizePixel = 0
    frame3.Parent = frame2

    Instance.new("UICorner", frame3).CornerRadius = UDim.new(1, 0)

    local uiStroke2 = Instance.new("UIStroke", frame3)
    uiStroke2.Color = Color3.fromRGB(130, 140, 180)
    uiStroke2.Thickness = 1
    uiStroke2.Transparency = 1

    local iconLabel = Instance.new("ImageLabel")
    iconLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    iconLabel.Position = UDim2.fromScale(0.5, 0.5)
    iconLabel.Size = UDim2.fromOffset(26, 26)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Image = "rbxassetid://15828140488"
    iconLabel.ImageColor3 = Color3.fromRGB(240, 240, 255)
    iconLabel.ImageTransparency = 1
    iconLabel.Parent = frame3

    local titleLabel = Instance.new("TextLabel")
