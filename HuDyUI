            local box = Instance.new("TextBox")
            box.Size = UDim2.new(0.48, -12, 0, 26)
            box.Position = UDim2.new(0.52, 0, 0.5, -13)
            box.BorderSizePixel = 0
            box.PlaceholderText = iCfg.PlaceholderText or iCfg.Placeholder or "Nhập nội dung..."
            box.Text = iCfg.Default or iCfg.Value or ""
            box.TextSize = 10
            box.ClearTextOnFocus = false
            box.Parent = card

            local boxCorner = Instance.new("UICorner")
            boxCorner.CornerRadius = UDim.new(0, 5)
            boxCorner.Parent = box

            box.Focused:Connect(function()
                stroke.Color = activeTheme.Accent
            end)
            box.FocusLost:Connect(function()
                stroke.Color = activeTheme.Border
                PlaySound("click")
                if iCfg.Callback then pcall(iCfg.Callback, box.Text) end
            end)

            OnThemeChanged(function(theme)
                card.BackgroundColor3 = theme.CardBg
                stroke.Color = theme.Border
                titleLbl.Font = theme.FontBody
                titleLbl.TextColor3 = theme.TextPrimary
                box.BackgroundColor3 = theme.CardSubBg
                box.TextColor3 = theme.Accent
                box.PlaceholderColor3 = theme.TextMuted
                box.Font = theme.FontBody
            end)

            return {
                Set = function(_, txt) box.Text = tostring(txt or "") end,
                Get = function() return box.Text end,
            }
        end

        return TabObj
    end

    -- Tạo tự động Tab chọn Chủ Đề Giao Diện (8 Themes)
    function WindowObj:CreateThemeTab(tabTitle)
        local ThemeTab = self:Tab({ Title = tabTitle or "Chủ Đề UI" })
        ThemeTab:Section({ Title = "Chọn Chủ Đề Giao Diện (Tự động lưu)" })

        local themeCards = {}
        for idx, tName in ipairs(HuDyUI.ThemeOrder) do
            local tData = HuDyUI.Themes[tName]
            local card = Instance.new("TextButton")
            card.Size = UDim2.new(1, 0, 0, 44)
            card.BorderSizePixel = 0
            card.AutoButtonColor = false
            card.LayoutOrder = idx + 1
            card.Text = ""
            card.Parent = ThemeTab.Page

            local cCorner = Instance.new("UICorner")
            cCorner.CornerRadius = UDim.new(0, 6)
            cCorner.Parent = card

            local cStroke = Instance.new("UIStroke")
            cStroke.Thickness = 1
            cStroke.Parent = card

            local swatch1 = Instance.new("Frame")
            swatch1.Size = UDim2.new(0, 14, 0, 28)
            swatch1.Position = UDim2.new(0, 10, 0.5, -14)
            swatch1.BackgroundColor3 = tData.Accent
            swatch1.BorderSizePixel = 0
            swatch1.Parent = card

            local sw1Corner = Instance.new("UICorner")
            sw1Corner.CornerRadius = UDim.new(0, 4)
            sw1Corner.Parent = swatch1

            local swatch2 = Instance.new("Frame")
            swatch2.Size = UDim2.new(0, 14, 0, 28)
            swatch2.Position = UDim2.new(0, 28, 0.5, -14)
            swatch2.BackgroundColor3 = tData.AccentSecondary
            swatch2.BorderSizePixel = 0
            swatch2.Parent = card

            local sw2Corner = Instance.new("UICorner")
            sw2Corner.CornerRadius = UDim.new(0, 4)
            sw2Corner.Parent = swatch2

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -165, 0, 18)
            nameLbl.Position = UDim2.new(0, 52, 0, 7)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = string.upper(tData.Name)
            nameLbl.TextColor3 = tData.Accent
            nameLbl.Font = tData.FontTitle
            nameLbl.TextSize = 11
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = card

            local subLbl = Instance.new("TextLabel")
            subLbl.Size = UDim2.new(1, -165, 0, 15)
            subLbl.Position = UDim2.new(0, 52, 0, 25)
            subLbl.BackgroundTransparency = 1
            subLbl.Text = tData.Subtitle
            subLbl.TextColor3 = tData.TextMuted
            subLbl.Font = tData.FontBody
            subLbl.TextSize = 9
            subLbl.TextXAlignment = Enum.TextXAlignment.Left
            subLbl.Parent = card

            local statusPill = Instance.new("TextLabel")
            statusPill.Size = UDim2.new(0, 96, 0, 24)
            statusPill.Position = UDim2.new(1, -106, 0.5, -12)
            statusPill.BorderSizePixel = 0
            statusPill.Font = tData.FontTitle
            statusPill.TextSize = 9
            statusPill.Parent = card

            local spCorner = Instance.new("UICorner")
            spCorner.CornerRadius = UDim.new(0, 5)
            spCorner.Parent = statusPill

            themeCards[tName] = {
                Card = card,
                Stroke = cStroke,
                StatusPill = statusPill,
                Data = tData,
            }

            card.MouseButton1Click:Connect(function()
                ApplyTheme(tName)
            end)
        end

        OnThemeChanged(function(theme)
            for tName, item in pairs(themeCards) do
                local isCurrent = (tName == theme.Name)
                item.Card.BackgroundColor3 = item.Data.CardBg
                item.Stroke.Color = isCurrent and item.Data.Accent or item.Data.Border
                item.StatusPill.BackgroundColor3 = isCurrent and item.Data.Accent or item.Data.CardSubBg
                item.StatusPill.TextColor3 = isCurrent and item.Data.MainBg or item.Data.TextMuted
                item.StatusPill.Text = isCurrent and "ĐANG DÙNG" or "CHỌN THEME"
            end
        end)

        return ThemeTab
    end

    function WindowObj:Destroy()
        for _, conn in ipairs(connections) do
            pcall(function() conn:Disconnect() end)
        end
        connections = {}
        if screenGui then
            screenGui:Destroy()
        end
    end

    ApplyTheme(currentThemeName)
    UpdateMenuOpenState(not startMinimized)
    screenGui.Parent = parentGui

    HuDyUI.LastWindow = WindowObj
    return WindowObj
end

function HuDyUI.Notify(self, notifyCfg)
    if HuDyUI.LastWindow and HuDyUI.LastWindow.Notify then
        return HuDyUI.LastWindow:Notify(notifyCfg)
    end
end
HuDyUI.notify = HuDyUI.Notify

return HuDyUI

