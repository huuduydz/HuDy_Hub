            switchKnob.Size = UDim2.new(0, 16, 0, 16)
            switchKnob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
            switchKnob.BorderSizePixel = 0
            switchKnob.Parent = switchTrack

            local knobCorner = Instance.new("UICorner")
            knobCorner.CornerRadius = UDim.new(1, 0)
            knobCorner.Parent = switchKnob

            local function UpdateSwitchVisual(animate)
                local targetTrackColor = state and activeTheme.Accent or activeTheme.CardSubBg
                local targetStrokeColor = state and activeTheme.Accent or activeTheme.Border
                local targetKnobPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
                local targetKnobColor = state and (activeTheme.MainBg or Color3.fromRGB(20, 20, 24)) or Color3.fromRGB(180, 180, 195)

                if animate then
                    TweenService:Create(switchTrack, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundColor3 = targetTrackColor
                    }):Play()
                    TweenService:Create(switchStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Color = targetStrokeColor
                    }):Play()
                    TweenService:Create(switchKnob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = targetKnobPos,
                        BackgroundColor3 = targetKnobColor
                    }):Play()
                else
                    switchTrack.BackgroundColor3 = targetTrackColor
                    switchStroke.Color = targetStrokeColor
                    switchKnob.Position = targetKnobPos
                    switchKnob.BackgroundColor3 = targetKnobColor
                end

                card.BackgroundColor3 = activeTheme.CardBg
                stroke.Color = state and activeTheme.Accent or activeTheme.Border
                titleLbl.Font = activeTheme.FontBody
                titleLbl.TextColor3 = state and activeTheme.TextPrimary or activeTheme.TextMuted
                if descLbl then
                    descLbl.Font = activeTheme.FontBody
                    descLbl.TextColor3 = activeTheme.TextMuted
                end
            end

            local function SetState(newState, fireCallback, userTriggered)
                state = (newState == true)
                if userTriggered then
                    PlaySound("toggle")
                end
                UpdateSwitchVisual(true)
                if fireCallback ~= false and callback then
                    pcall(callback, state)
                end
            end

            card.MouseButton1Click:Connect(function()
                SetState(not state, true, true)
            end)

            card.MouseEnter:Connect(function()
                if not state then
                    stroke.Color = activeTheme.AccentSecondary or activeTheme.Accent
                end
            end)
            card.MouseLeave:Connect(function()
                if not state then
                    stroke.Color = activeTheme.Border
                end
            end)

            OnThemeChanged(function()
                UpdateSwitchVisual(false)
            end)

            return {
                Set = function(_, val) SetState(val, false, false) end,
                SetValue = function(_, val) SetState(val, false, false) end,
                SetState = function(_, val) SetState(val, false, false) end,
                Get = function() return state end,
            }
        end

