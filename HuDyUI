    local barBg = Instance.new("Frame")
    barBg.Position = UDim2.fromOffset(22, 82)
    barBg.Size = UDim2.new(1, -44, 0, 5)
    barBg.BackgroundColor3 = Color3.fromRGB(35, 35, 46)
    barBg.BackgroundTransparency = 1
    barBg.BorderSizePixel = 0
    barBg.Parent = frame2
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    barFill.BackgroundTransparency = 1
    barFill.BorderSizePixel = 0
    barFill.Parent = barBg
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

    local fillGradient = Instance.new("UIGradient", barFill)
    fillGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(99, 140, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
    })

    local tIn = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService_:Create(frame, tIn, { BackgroundTransparency = 0.55 }):Play()
    TweenService_:Create(frame2, tIn, { BackgroundTransparency = 0 }):Play()
    TweenService_:Create(uiStroke, tIn, { Transparency = 0.6 }):Play()
    TweenService_:Create(frame3, tIn, { BackgroundTransparency = 0 }):Play()
    TweenService_:Create(uiStroke2, tIn, { Transparency = 0.5 }):Play()
    TweenService_:Create(iconLabel, tIn, { ImageTransparency = 0 }):Play()
    TweenService_:Create(titleLabel, tIn, { TextTransparency = 0 }):Play()
    TweenService_:Create(subLabel, tIn, { TextTransparency = 0 }):Play()
    TweenService_:Create(barBg, tIn, { BackgroundTransparency = 0 }):Play()
    TweenService_:Create(barFill, tIn, { BackgroundTransparency = 0 }):Play()

    local active = true
    local hiddenGuis = {}

    local function hideWindUIs()
        for _, child in ipairs(hui:GetChildren()) do
            if child:IsA("ScreenGui") and child.Enabled and child ~= screenGui then
                if child.Name == "WindUI" or child.Name:match("^WindUI/") or child.Name:match("^HuDy.+Button$") then
                    child.Enabled = false
                    table.insert(hiddenGuis, child)
                end
            end
        end
    end

    LOADUI.reveal = function()
        for _, g in ipairs(hiddenGuis) do
            pcall(function() g.Enabled = true end)
        end
        hiddenGuis = {}
    end

    task.spawn(function()
        while active do
            pcall(hideWindUIs)
            task.wait(0.05)
        end
    end)

    local currentStep = 0
    LOADUI.step = function(val, text)
        if not active then return end
        pcall(function()
            if type(val) == "number" and val > currentStep then
                currentStep = math.clamp(val, 0, 1)
                TweenService_:Create(barFill, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                    Size = UDim2.new(currentStep, 0, 1, 0)
                }):Play()
            end
            if text then
                subLabel.Text = tostring(text)
            end
        end)
    end

    LOADUI.done = function()
        if not active then return end
        active = false
        pcall(function()
            subLabel.Text = "Sẵn sàng!"
            TweenService_:Create(barFill, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 1, 0)
            }):Play()

            task.delay(0.3, function()
                LOADUI.reveal()
                local tOut = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                TweenService_:Create(frame, tOut, { BackgroundTransparency = 1 }):Play()
                TweenService_:Create(frame2, tOut, { BackgroundTransparency = 1 }):Play()
                TweenService_:Create(uiStroke, tOut, { Transparency = 1 }):Play()
                TweenService_:Create(frame3, tOut, { BackgroundTransparency = 1 }):Play()
                TweenService_:Create(uiStroke2, tOut, { Transparency = 1 }):Play()
                TweenService_:Create(iconLabel, tOut, { ImageTransparency = 1 }):Play()
                TweenService_:Create(titleLabel, tOut, { TextTransparency = 1 }):Play()
                TweenService_:Create(subLabel, tOut, { TextTransparency = 1 }):Play()
                TweenService_:Create(barBg, tOut, { BackgroundTransparency = 1 }):Play()
                TweenService_:Create(barFill, tOut, { BackgroundTransparency = 1 }):Play()

                task.delay(0.28, function()
                    pcall(function() screenGui:Destroy() end)
                end)
            end)
        end)
    end

    task.delay(25, function()
        pcall(LOADUI.done)
    end)
end

HuDyUI.LOADUI = LOADUI

LOADUI.step(0.15, "Đang tải WindUI Engine...")

do
    local function ensureDir(path)
        if makefolder and isfolder and not isfolder(path) then
            pcall(makefolder, path)
        end
    end
    ensureDir("HuDy Hub")
    ensureDir("HuDy Hub/icons")

    local windUiSource = nil
    if isfile and readfile and isfile("HuDy Hub/windui.lua") then
        local ok, res = pcall(readfile, "HuDy Hub/windui.lua")
        if ok and type(res) == "string" and #res > 100000 then
            windUiSource = res
        end
    end

    if not windUiSource then
        LOADUI.step(0.35, "Tải WindUI từ Footagesus...")
        local ok, res = pcall(function()
            return game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua")
        end)
        if ok and type(res) == "string" and #res > 100000 then
            windUiSource = res
            if writefile then
                pcall(writefile, "HuDy Hub/windui.lua", windUiSource)
            end
        end
    end

    if writefile and isfile and not isfile("HuDy Hub/icons-main.lua") then
        LOADUI.step(0.55, "Tối ưu hóa Icon Cache...")
        pcall(function()
            local iconSrc = game:HttpGet("https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua")
            local patchedIconSrc, replacedCount = iconSrc:gsub("return game:HttpGet%(url%)", function()
                return [[do
    local _p = "HuDy Hub/icons/" .. url:gsub("%W", "_") .. ".txt"
    if isfile and readfile and isfile(_p) then
        local _o, _d = pcall(readfile, _p)
        if _o and type(_d) == "string" and #_d > 0 then return _d end
    end
    local _d = game:HttpGet(url)
    pcall(function()
        if makefolder and isfolder and not isfolder("HuDy Hub/icons") then makefolder("HuDy Hub/icons") end
        writefile(_p, _d)
    end)
    return _d
end]]
            end)
            if replacedCount > 0 and loadstring(patchedIconSrc) then
                writefile("HuDy Hub/icons-main.lua", patchedIconSrc)
            end
        end)
    end

    if isfile and isfile("HuDy Hub/icons-main.lua") and windUiSource then
        local patchedWindUI, pCount = windUiSource:gsub(
            "game%.HttpGet and game:HttpGet%(%w+%)or %w+:GetAsync%(%w+%)",
            'readfile("HuDy Hub/icons-main.lua")'
        )
        if pCount > 0 then
            windUiSource = patchedWindUI
        end
    end

    LOADUI.step(0.70, "Biên dịch WindUI Engine...")
    local ok, res = pcall(function()
        return loadstring(windUiSource)()
    end)
    if ok and type(res) == "table" and res.CreateWindow then
        WindUI = res
    else
        warn("[HuDy Hub] Thử nạp trực tiếp qua HttpGet...")
        WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
    end
end

if not WindUI then
    LOADUI.done()
    error("[HuDy Hub CRITICAL] Không thể tải WindUI! Vui lòng kiểm tra lại mạng.", 2)
end

