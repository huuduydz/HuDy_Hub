function HuDyUI:CreateWindow(config)
    config = type(config) == "table" and config or {}
    LOADUI.step(0.85, "Khởi tạo cửa sổ giao diện...")

    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
    local defaultW = math.max(580, math.min(850, vp.X - 24))
    local defaultH = math.max(360, math.min(560, vp.Y - 24))

    local windowConfig = {
        Title = config.Title or "HuDy Hub — King Legacy",
        Icon = config.Icon or "solar:planet-bold",
        Author = config.Author or config.Subtitle or "HuDy Hub Automation",
        Folder = config.Folder or "HuDy Hub",
        Size = config.Size or UDim2.fromOffset(defaultW, defaultH),
        MaxSize = config.MaxSize or Vector2.new(850, 560),
        HideSearchBar = config.HideSearchBar == true,
        Transparent = true,
        Theme = config.Theme or "Onyx",
        Resizable = config.Resizable ~= false,
        ToggleKey = config.ToggleKey or nil,
        BackgroundImageTransparency = config.BackgroundImageTransparency or 0.35,
        Acrylic = false,
        ShadowTransparency = 0.3,
        Radius = config.Radius or 18,
        IconRadius = 1,
        IconSize = 27,
        SideBarWidth = config.SideBarWidth or 185,
        Topbar = config.Topbar or { Height = 56, ButtonsType = "Default" },
        User = { Enabled = false, Anonymous = false }
    }

    local Window = WindUI:CreateWindow(windowConfig)

    -- Topbar Tags cao cấp
    pcall(function()
        Window:Tag({ Title = "@HuDyHub", Icon = "youtube", Color = Color3.fromHex("#ffffff"), Radius = 6 })
        Window:Tag({ Title = "King Legacy", Icon = "swords", Color = Color3.fromHex("#ffffff"), Radius = 6 })
        Window:Tag({ Title = "Mobile & PC", Icon = "smartphone", Color = Color3.fromHex("#ffffff"), Radius = 6 })
    end)

    -- Nút mở menu góc màn hình (Floating Draggable Pill Button)
    pcall(function()
        Window:EditOpenButton({
            Title = config.OpenButtonText or "HuDy Hub",
            Icon = "solar:planet-bold",
            CornerRadius = UDim.new(0, 16),
            StrokeThickness = 2,
            Color = ColorSequence.new(Color3.fromHex("#2a2a32"), Color3.fromHex("#c9c9d4")),
            OnlyMobile = false,
            Enabled = true,
            Draggable = true,
        })
    end)

    -- Hiệu ứng chữ phát sáng chuyển động OnyxTitleSheen
    task.spawn(function()
        local TweenService_ = game:GetService("TweenService")
        local RunService_ = game:GetService("RunService")
        local titleLbl = nil
        for i = 1, 100 do
            local main = Window.UIElements and Window.UIElements.Main
            if main then
                local topbar = main:FindFirstChild("Topbar", true)
                for _, v3 in ipairs({ "Left", "Title", "Title" }) do
                    topbar = topbar and topbar:FindFirstChild(v3)
                end
                if topbar and topbar:IsA("TextLabel") then
                    titleLbl = topbar
                    break
                end
                for _, descendant in ipairs(main:GetDescendants()) do
                    if descendant:IsA("TextLabel") and descendant.Text == Window.Title then
                        titleLbl = descendant
                        break
                    end
                end
            end
            if titleLbl then break end
            RunService_.RenderStepped:Wait()
        end
        if not titleLbl or titleLbl:FindFirstChild("OnyxTitleSheen") then return end
        local uiGradient = titleLbl:FindFirstChildWhichIsA("UIGradient")
        if uiGradient then uiGradient:Destroy() end

        local uiGradient2 = Instance.new("UIGradient")
        uiGradient2.Name = "OnyxTitleSheen"
        uiGradient2.Rotation = 12
        uiGradient2.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(148, 148, 164)),
            ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(148, 148, 164)),
        })
        uiGradient2.Offset = Vector2.new(-0.55, 0)
        uiGradient2.Parent = titleLbl
        local uiStroke = Instance.new("UIStroke")
        uiStroke.Name = "OnyxTitleGlow"
        uiStroke.Color = Color3.fromRGB(236, 239, 250)
        uiStroke.Thickness = 1.4
        uiStroke.Transparency = 0.82
        uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
        uiStroke.Parent = titleLbl
        TweenService_:Create(uiGradient2, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Offset = Vector2.new(0.55, 0) }):Play()
        TweenService_:Create(uiStroke, TweenInfo.new(1.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.42 }):Play()
    end)

    -- Adapter an toàn cho Tab / Section
    local rawTab = Window.Tab
    Window.Tab = function(self, tabCfg)
        local tObj = rawTab(self, tabCfg)
        if tObj then
            if not tObj.Space then tObj.Space = function(t, h) return t end end
            if not tObj.Divider then tObj.Divider = function(t) return t:Space(6) end end
            local rawSec = tObj.Section
            if rawSec then
                tObj.Section = function(t, secCfg)
                    local sObj = rawSec(t, secCfg)
                    if type(sObj) == "table" then
                        if not sObj.Space then sObj.Space = function(s, h) return t:Space(h) end end
                        if not sObj.Section then sObj.Section = function(s, subSec) return t:Section(subSec) end end
                        if not sObj.Divider then sObj.Divider = function(s) return t:Divider() end end
                        if not sObj.Toggle then sObj.Toggle = function(s, cfg) return t:Toggle(cfg) end end
                        if not sObj.Slider then sObj.Slider = function(s, cfg) return t:Slider(cfg) end end
                        if not sObj.Dropdown then sObj.Dropdown = function(s, cfg) return t:Dropdown(cfg) end end
                        if not sObj.Button then sObj.Button = function(s, cfg) return t:Button(cfg) end end
                        if not sObj.Paragraph then sObj.Paragraph = function(s, cfg) return t:Paragraph(cfg) end end
                        if not sObj.Input then sObj.Input = function(s, cfg) return t:Input(cfg) end end
                    end
                    return sObj
                end
            end
        end
        return tObj
    end

    task.delay(1.5, function()
        LOADUI.step(1, "Sẵn sàng!")
        LOADUI.done()
    end)

    HuDyUI.LastWindow = Window
    return Window
end

-- Proxy mọi phương thức của WindUI sang HuDyUI
setmetatable(HuDyUI, {
    __index = function(_, key)
        return WindUI and WindUI[key]
    end
})

return HuDyUI
