local GUI_ICON_TOKENS = {"⚡", "⚠️", "⚠", "🏝️", "📡", "🚀", "❌", "✅", "☠️", "☠", "⚔️", "⚔", "🦑", "📦", "⏳", "🌊", "🔥", "✨", "🛡️", "🛡", "👑", "💎", "🎣", "🗡️", "🗡", "⭐", "🩸", "🦴", "🪵", "🐟", "🎯", "🍓"}
function HuDyUI.StripIcons(value)
    local text = tostring(value or "")
    for _, token in ipairs(GUI_ICON_TOKENS) do
        text = string.gsub(text, token, "")
    end
    return string.gsub(text, "^%s+", "")
end

-- Hỗ trợ thêm chủ đề mới tùy ý từ script bên ngoài
function HuDyUI:RegisterTheme(name, themeTable)
    if type(name) == "string" and type(themeTable) == "table" then
        themeTable.Name = themeTable.Name or name
        self.Themes[name] = themeTable
        local exists = false
        for _, n in ipairs(self.ThemeOrder) do
            if n == name then exists = true; break end
        end
        if not exists then
            table.insert(self.ThemeOrder, name)
        end
    end
end

