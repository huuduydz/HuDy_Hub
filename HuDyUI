-- KHỞI TẠO CỬA SỔ CHÍNH + NÚT GÓC PHẢI + THANH TIẾN TRÌNH FARM
-- =============================================================================
function HuDyUI:CreateWindow(config)
    config = type(config) == "table" and config or {}

    local windowTitle    = config.Title or "HUDY HUB"
    local windowSubtitle = config.Subtitle or "Custom UI Framework"
    local guiName        = config.GuiName or "HUDY_CUSTOM_SHARED_UI"
    local configFile     = config.ConfigFile or "HuDy Hub/HuDyUI_Theme.json"
    local startMinimized = (config.StartMinimized ~= false)
    local toggleKey      = config.ToggleKey or Enum.KeyCode.RightControl
    local onThemeChange  = config.OnThemeChanged

    local progressCfg    = type(config.ProgressBar) == "table" and config.ProgressBar or {}
    local showProgress   = (progressCfg.Enabled ~= false)

    -- Đọc Theme đã lưu nếu có
    local savedTheme = nil
    pcall(function()
        if isfile and readfile and isfile(configFile) then
            local raw = readfile(configFile)
            local dec = HttpService:JSONDecode(raw)
            if type(dec) == "table" and type(dec.Theme) == "string" then
                local alias = self.ThemeAliases and self.ThemeAliases[dec.Theme] or dec.Theme
                if self.Themes[alias] then
                    savedTheme = alias
                end
            end
        end
    end)

    local reqTheme = config.Theme
    if reqTheme and self.ThemeAliases and self.ThemeAliases[reqTheme] then
        reqTheme = self.ThemeAliases[reqTheme]
    end

    local currentThemeName = savedTheme
        or (reqTheme and self.Themes[reqTheme] and reqTheme)
        or "Onyx Dark"
    local activeTheme = self.Themes[currentThemeName]

    local parentGui = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")
    local oldGui = parentGui:FindFirstChild(guiName)
    if oldGui then oldGui:Destroy() end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = guiName
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 100000

    local connections = {}
    local themeListeners = {}

    local function AddConnection(conn)
        if typeof(conn) == "RBXScriptConnection" then
            table.insert(connections, conn)
        end
        return conn
    end

    -- =========================================================================
    -- HỆ THỐNG ÂM THANH PHẢN HỒI (SFX ENGINE - TƯƠNG TỰ ONYX V2 / MM2)
    -- =========================================================================
    local SoundService = game:GetService("SoundService")
    local sfxCache = {}
    local SFX_IDS = {
        toggle = 136108770017536,
        click  = 139800881181209,
        notify = 131039887376992,
    }
    local function PlaySound(name)
        if config.SoundEffects == false then return end
        local assetId = SFX_IDS[name]
        if not assetId then return end
        pcall(function()
            local sound = sfxCache[name]
            if not sound or not sound.Parent then
                sound = Instance.new("Sound")
                sound.Name = "HuDyUI_SFX_" .. name
                sound.SoundId = "rbxassetid://" .. assetId
                sound.Volume = 0.45
                sound.Parent = SoundService
                sfxCache[name] = sound
            end
            sound.TimePosition = 0
            sound:Play()
        end)
    end

    local function OnThemeChanged(fn)
        table.insert(themeListeners, fn)
        pcall(fn, activeTheme)
    end

    local function SaveThemePreference(themeName)
        if not writefile then return end
        pcall(function()
            local folder = string.match(configFile, "^(.-)/[^/]+$")
            if folder and folder ~= "" and isfolder and makefolder and not isfolder(folder) then
                makefolder(folder)
            end
            writefile(configFile, HttpService:JSONEncode({ Theme = themeName }))
        end)
    end

    local function ApplyTheme(themeName)
        if not self.Themes[themeName] then return end
        currentThemeName = themeName
        activeTheme = self.Themes[themeName]
        SaveThemePreference(themeName)
        for _, fn in ipairs(themeListeners) do
            pcall(fn, activeTheme)
        end
        if type(onThemeChange) == "function" then
            pcall(onThemeChange, themeName, activeTheme)
        end
    end

    local function CycleNextTheme()
        local idx = 1
        for i, name in ipairs(self.ThemeOrder) do
            if name == currentThemeName then
                idx = i
                break
            end
        end
        local nextIdx = (idx % #self.ThemeOrder) + 1
        ApplyTheme(self.ThemeOrder[nextIdx])
    end

    -- Helper kéo thả mượt trên cả PC và Mobile
    local function MakeDraggable(dragHandle, targetFrame)
        local dragging = false
        local dragInput = nil
        local dragStart = nil
        local startPos = nil
        local movedDistance = 0

        AddConnection(dragHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = targetFrame.Position
                movedDistance = 0
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end))

        AddConnection(dragHandle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end))

        AddConnection(UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging and dragStart and startPos then
                local delta = input.Position - dragStart
                movedDistance = delta.Magnitude
                targetFrame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end))

        return function()
            return movedDistance > 6
        end
    end

