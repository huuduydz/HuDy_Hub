            local pad = Instance.new("UIPadding")
            pad.PaddingTop = UDim.new(0, 7)
            pad.PaddingBottom = UDim.new(0, 8)
            pad.PaddingLeft = UDim.new(0, 10)
            pad.PaddingRight = UDim.new(0, 10)
            pad.Parent = card

            local titleLbl = Instance.new("TextLabel")
            titleLbl.Size = UDim2.new(1, 0, 0, 16)
            titleLbl.BackgroundTransparency = 1
            titleLbl.Text = HuDyUI.StripIcons(mCfg.Title or "Select Options")
            titleLbl.TextSize = 10
            titleLbl.TextXAlignment = Enum.TextXAlignment.Left
            titleLbl.Parent = card

            local chipGrid = Instance.new("Frame")
            chipGrid.Size = UDim2.new(1, 0, 0, 0)
            chipGrid.Position = UDim2.new(0, 0, 0, 22)
            chipGrid.AutomaticSize = Enum.AutomaticSize.Y
            chipGrid.BackgroundTransparency = 1
            chipGrid.Parent = card

            local gridLayout = Instance.new("UIGridLayout")
            gridLayout.CellSize = UDim2.new(0.32, 0, 0, 26)
            gridLayout.CellPadding = UDim2.new(0.015, 0, 0, 6)
            gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
            gridLayout.Parent = chipGrid

            local selectedMap = {}
            if type(defaultList) == "table" then
                for k, v in pairs(defaultList) do
                    if type(k) == "number" and type(v) == "string" then
                        selectedMap[v] = true
                    elseif type(k) == "string" and v == true then
                        selectedMap[k] = true
                    end
                end
            elseif type(defaultList) == "string" then
                selectedMap[defaultList] = true
            end

            local chips = {}
            local function RefreshChips(fireCallback)
                local list = {}
                for _, itemName in ipairs(values) do
                    if selectedMap[itemName] then
                        table.insert(list, itemName)
                    end
                end
                if #list == 0 and #values > 0 then
                    selectedMap[values[1]] = true
                    table.insert(list, values[1])
                end

                for _, itemName in ipairs(values) do
                    local c = chips[itemName]
                    if c then
                        local active = (selectedMap[itemName] == true)
                        c.Btn.BackgroundColor3 = active and activeTheme.CardBg or activeTheme.CardSubBg
                        c.Btn.TextColor3 = active and activeTheme.TextPrimary or activeTheme.TextMuted
                        c.Btn.Text = tostring(itemName) .. (active and " [BẬT]" or " [TẮT]")
                        c.Stroke.Color = active and activeTheme.Accent or activeTheme.Border
                        c.Stroke.Transparency = active and 0.1 or 0.6
                    end
                end

                if fireCallback and callback then
                    pcall(callback, isMulti and list or list[1], selectedMap)
                end
            end

            for idx, itemName in ipairs(values) do
                local cBtn = Instance.new("TextButton")
                cBtn.BorderSizePixel = 0
                cBtn.LayoutOrder = idx
                cBtn.TextSize = 9
                cBtn.Parent = chipGrid

                local cCorner = Instance.new("UICorner")
                cCorner.CornerRadius = UDim.new(0, 5)
                cCorner.Parent = cBtn

                local cStroke = Instance.new("UIStroke")
                cStroke.Thickness = 1
                cStroke.Parent = cBtn

                chips[itemName] = { Btn = cBtn, Stroke = cStroke }

                cBtn.MouseButton1Click:Connect(function()
                    PlaySound("click")
                    if isMulti then
                        selectedMap[itemName] = not selectedMap[itemName]
                    else
                        for k in pairs(selectedMap) do selectedMap[k] = false end
                        selectedMap[itemName] = true
                    end
                    RefreshChips(true)
                end)
            end

            OnThemeChanged(function(theme)
                card.BackgroundColor3 = theme.CardBg
                stroke.Color = theme.Border
                titleLbl.Font = theme.FontBody
                titleLbl.TextColor3 = theme.TextPrimary
                for _, itemName in ipairs(values) do
                    if chips[itemName] then
                        chips[itemName].Btn.Font = theme.FontTitle
                    end
                end
                RefreshChips(false)
            end)

            return {
                Refresh = function(_, newValues)
                    values = type(newValues) == "table" and newValues or values
                    RefreshChips(false)
                end,
                Set = function(_, val)
                    if type(val) == "table" then
                        table.clear(selectedMap)
                        for k, v in pairs(val) do
                            if type(k) == "number" and type(v) == "string" then selectedMap[v] = true
                            elseif type(k) == "string" and v == true then selectedMap[k] = true end
                        end
                    elseif type(val) == "string" then
                        table.clear(selectedMap)
                        selectedMap[val] = true
                    end
                    RefreshChips(true)
                end,
                Select = function(self, val)
                    self:Set(val)
                end,
                Get = function()
                    local list = {}
                    for _, itemName in ipairs(values) do
                        if selectedMap[itemName] then table.insert(list, itemName) end
                    end
                    return isMulti and list or list[1]
                end,
            }
        end
