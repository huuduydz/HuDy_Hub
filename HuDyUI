                plusBtn.TextColor3 = theme.TextPrimary
                plusBtn.Font = theme.FontTitle
                track.BackgroundColor3 = theme.CardSubBg
                fill.BackgroundColor3 = theme.Accent
                thumbKnob.BackgroundColor3 = theme.Accent
            end)

            return {
                Set = function(_, v) SetValue(v, false, false) end,
                Get = function() return currentVal end,
            }
        end

        function TabObj:MultiChips(mCfg)
            elementOrder = elementOrder + 1
            mCfg = type(mCfg) == "table" and mCfg or {}
            local values = type(mCfg.Values) == "table" and mCfg.Values or {"Melee", "Sword", "Fruit"}
            local defaultList = mCfg.Value or mCfg.Default or values
            local isMulti = (mCfg.Multi ~= false)
            local callback = mCfg.Callback

            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, 0, 0, 0)
            card.AutomaticSize = Enum.AutomaticSize.Y
            card.BorderSizePixel = 0
