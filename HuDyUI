    local wasRightBtnDragged = MakeDraggable(rightMenuBtn, rightMenuBtn)

    local function UpdateMenuOpenState(openState)
        isMenuOpen = (openState == true)
        PlaySound("click")
        if isMenuOpen then
            rightMenuBtn.Visible = false
            if mainWindowFrame then
                mainWindowFrame.Visible = true
                if windowScale then
                    windowScale.Scale = 0.94
                    TweenService:Create(windowScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
                end
            end
        else
            if mainWindowFrame then
                if windowScale then
                    local tween = TweenService:Create(windowScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.94 })
                    tween:Play()
                    tween.Completed:Connect(function()
                        if not isMenuOpen then
                            mainWindowFrame.Visible = false
                        end
                    end)
                else
                    mainWindowFrame.Visible = false
                end
            end
            rightMenuBtn.Visible = true
        end
    end

    OnThemeChanged(function(theme)
        rightMenuBtn.Font = theme.FontTitle
        rightMenuBtn.TextColor3 = theme.TextPrimary
        rightMenuStroke.Color = theme.Border
        rightMenuDot.BackgroundColor3 = theme.Accent
    end)

    rightMenuBtn.MouseButton1Click:Connect(function()
        if wasRightBtnDragged() then return end
        UpdateMenuOpenState(true)
    end)

    if toggleKey then
        AddConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == toggleKey then
                UpdateMenuOpenState(not isMenuOpen)
            end
        end))
